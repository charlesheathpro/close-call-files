 "transcript": [
  {
   "s": 1.86,
   "e": 3.09,
   "text": "- Our unit's mission here at"
  },
  {
   "s": 3.09,
   "e": 4.82,
   "text": "Aircraft Rescue Fire Fighting Camp Penelton"
  },
  {
   "s": 4.82,
   "e": 7.29,
   "text": "is to save lives and protect property."
  },
  {
   "s": 7.29,
   "e": 8.57,
   "text": "On a normal day we get told"
  },
  {
   "s": 8.57,
   "e": 12.26,
   "text": "^we have to be here anywhere between 24 and 72 hours."
  },
  {
   "s": 12.26,
   "e": 13.82,
   "text": "It's our job to be ready"
  },
  {
   "s": 13.82,
   "e": 16.43,
   "text": "when everyone else is least ready."
  },
  {
   "s": 16.43,
   "e": 17.26,
   "text": "When we respond to calls"
  },
  {
   "s": 17.26,
   "e": 19.11,
   "text": "everyone's gonna carry a tool."
  },
  {
   "s": 19.11,
   "e": 21.49,
   "text": "Usually it's a axe or a Halligan tool."
  },
  {
   "s": 21.49,
   "e": 23.62,
   "text": "At that point they'll carry that to the aircraft."
  },
  {
   "s": 23.62,
   "e": 25.73,
   "text": "As firefighters we continuously train"
  },
  {
   "s": 25.73,
   "e": 27.68,
   "text": "so that we can keep those patients alive"
  },
  {
   "s": 27.68,
   "e": 30.01,
   "text": "that we have the ability to."
  }
 ],
