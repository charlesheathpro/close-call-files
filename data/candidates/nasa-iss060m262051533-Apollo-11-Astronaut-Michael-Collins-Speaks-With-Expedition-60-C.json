    {
      "s": 1395.77,
      "e": 1396.6,
      "text": "YOU FOR THAT."
    },
    {
      "s": 1396.6,
      "e": 1398.77,
      "text": "EVEN TODAY, YOU CONTINUE TO"
    },
    {
      "s": 1398.77,
      "e": 1400.44,
      "text": "INSPIRE ME AND INSPIRE ALL OF US"
    },
    {
      "s": 1400.44,
      "e": 1401.11,
      "text": "TO -- TO BE BETTER."
    },
    {
      "s": 1401.11,
      "e": 1405.15,
      "text": ">> WELL, THANK YOU SO MUCH, AND"
    },
    {
      "s": 1405.15,
      "e": 1408.03,
      "text": "THOSE APOLLO PEOPLE WHO ARE"
    },
    {
      "s": 1408.03,
      "e": 1410.33,
      "text": "STILL AROUND, WE SALUTE YOU, AND"
    },
    {
      "s": 1410.33,
      "e": 1413.16,
      "text": "WE DIDN'T REALIZE WE HAD SPAWNED"
    },
    {
      "s": 1413.16,
      "e": 1414.08,
      "text": "AN OPERATION OF SUCH COMPLEXITY"
    },
    {
      "s": 1414.08,
      "e": 1417.83,
      "text": "WHEN WE WERE DOING IT IS FEW"
