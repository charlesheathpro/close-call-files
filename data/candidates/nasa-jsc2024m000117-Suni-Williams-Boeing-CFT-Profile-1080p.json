  "transcript": [
    {
      "s": 0.57,
      "e": 2.6,
      "text": "EXPLORATION IS CURIOSITY."
    },
    {
      "s": 2.6,
      "e": 4.64,
      "text": "IT'S ASKING THE QUESTION WHY,"
    },
    {
      "s": 4.64,
      "e": 6.34,
      "text": "IT'S TAKING THAT NEXT STEP."
    },
    {
      "s": 6.34,
      "e": 8.07,
      "text": "EVERY TIME WE DO"
    },
    {
      "s": 8.07,
      "e": 9.71,
      "text": "SOMETHING FOR THE FIRST TIME,"
    },
    {
      "s": 9.71,
      "e": 11.95,
      "text": "WE'RE EXPANDING OUR KNOWLEDGE."
    },
    {
      "s": 11.95,
      "e": 13.11,
      "text": "MY NAME IS SUNI WILLIAMS,"
    },
    {
      "s": 13.11,
      "e": 14.75,
      "text": "AND I'M THE PILOT FOR NASA'S"
    },
    {
      "s": 14.75,
      "e": 15.41,
      "text": "BOEING CREW"
    },
    {
      "s": 15.41,
      "e": 16.38,
      "text": "FLIGHT TEST MISSION"
    },
    {
      "s": 16.38,
      "e": 18.79,
      "text": "TO THE INTERNATIONAL SPACE STATION."
    },
    {
      "s": 18.79,
      "e": 20.39,
      "text": "I FEEL REALLY LUCKY TO HAVE GROWN UP"
    },
    {
      "s": 20.39,
      "e": 21.55,
      "text": "IN A SMALL TOWN"
    },
    {
      "s": 21.55,
      "e": 22.59,
      "text": "OUTSIDE OF BOSTON,"
    },
    {
      "s": 22.59,
      "e": 23.69,
      "text": "NEEDHAM, MASSACHUSETTS."
    },
    {
      "s": 23.69,
      "e": 24.46,
      "text": "IT WAS A GREAT TOWN"
    },
    {
      "s": 24.46,
      "e": 25.46,
      "text": "BECAUSE WE WERE ABLE"
    },
    {
      "s": 25.46,
      "e": 27.43,
      "text": "TO RIDE OUR BIKES EVERYWHERE WE WENT."
    },
    {
      "s": 27.43,
      "e": 28.63,
      "text": "MY BROTHER, SISTER AND I,"
    },
    {
      "s": 28.63,
      "e": 30.1,
      "text": "WE WERE ALL SWIMMERS"
    },
    {
      "s": 30.1,
      "e": 32.73,
      "text": "AND IT WAS JUST A GREAT CHILDHOOD."
    },
    {
      "s": 32.73,
      "e": 34.5,
      "text": "MY DAD WAS A DOCTOR"
    },
    {
      "s": 34.5,
      "e": 36.44,
      "text": "AND ALSO DID NEUROSCIENCE RESEARCH."
    },
    {
      "s": 36.44,
      "e": 38.04,
      "text": "WE WERE THE STRANGE FAMILY"
    },
    {
      "s": 38.04,
      "e": 39.67,
      "text": "WHO HAD PICTURES AND DIAGRAMS"
    },
    {
      "s": 39.67,
      "e": 41.24,
      "text": "OF BRAINS ON OUR DINING ROOM TABLE."
    },
    {
      "s": 41.24,
      "e": 42.34,
      "text": "MY OLDER BROTHER"
    },
    {
      "s": 42.34,
      "e": 43.68,
      "text": "WENT TO THE NAVAL ACADEMY."
    },
    {
      "s": 43.68,
      "e": 45.05,
      "text": "I STARTED RESEARCHING A LITTLE BIT"
    },
    {
      "s": 45.05,
      "e": 45.88,
      "text": "AND I THOUGHT, WELL, WHAT"
    },
    {
      "s": 45.88,
      "e": 47.01,
      "text": "THE HECK, I'LL TRY THIS OUT."
    },
    {
      "s": 47.01,
      "e": 48.52,
      "text": "AND WHEN I WENT,"
    },
    {
      "s": 48.52,
      "e": 50.72,
      "text": "I FOUND THAT I REALLY LOVED IT. TEAMWORK."
    },
    {
      "s": 50.72,
      "e": 52.12,
      "text": "FOLLOWERSHIP. LEADERSHIP."
    },
    {
      "s": 52.12,
      "e": 53.69,
      "text": "THOSE OPPORTUNITIES THAT WE HAD RIGHT"
    },
    {
      "s": 53.69,
      "e": 54.99,
      "text": "FROM THE VERY BEGINNING,"
    },
    {
      "s": 54.99,
      "e": 56.42,
      "text": "AND TO ACCOMPLISH SOMETHING"
    },
    {
      "s": 56.42,
      "e": 57.69,
      "text": "A LITTLE BIT BIGGER THAN YOURSELF."
    },
    {
      "s": 57.69,
      "e": 59.53,
      "text": "AND I THINK THAT PAVED THE WAY"
    },
    {
      "s": 59.53,
      "e": 61.33,
      "text": "FOR THE REST OF MY CAREER."
    },
    {
      "s": 61.33,
      "e": 62.76,
      "text": "GOT A BASIC ENGINEERING"
    },
    {
      "s": 62.76,
      "e": 64.5,
      "text": "DEGREE FROM THE NAVAL ACADEMY."
    },
    {
      "s": 64.5,
      "e": 65.23,
      "text": "I REALLY DIDN'T KNOW"
    },
    {
      "s": 65.23,
      "e": 66.17,
      "text": "WHAT IT WAS ALL ABOUT"
    },
    {
      "s": 66.17,
      "e": 67.03,
      "text": "WHEN I WENT THROUGH"
    },
    {
      "s": 67.03,
      "e": 68.6,
      "text": "THAT COURSE CURRICULUM."
    },
    {
      "s": 68.6,
      "e": 70.0,
      "text": "BUT WHEN I WENT TO TEST PILOT SCHOOL,"
    },
    {
      "s": 70.0,
      "e": 71.0,
      "text": "ALL OF THAT STUFF"
    },
    {
      "s": 71.0,
      "e": 72.11,
      "text": "SORT OF GELLED TOGETHER."
    },
    {
      "s": 72.11,
      "e": 72.91,
      "text": "I WAS LIKE, OH, WOW,"
    },
    {
      "s": 72.91,
      "e": 74.57,
      "text": "THIS IS WHY WE DO MATH MODELING."
    },
    {
      "s": 74.57,
      "e": 76.38,
      "text": "THIS IS HOW WE TRY TO PREDICT"
    },
    {
      "s": 76.38,
      "e": 77.61,
      "text": "HOW CHANGE IN AN ENGINE"
    },
    {
      "s": 77.61,
      "e": 78.55,
      "text": "IS GOING TO AFFECT THE WAY"
    },
    {
      "s": 78.55,
      "e": 79.78,
      "text": "THE HELICOPTER FLIES."
    },
    {
      "s": 80.95,
      "e": 81.88,
      "text": "TIME ON THE INTERNATIONAL"
    },
    {
      "s": 81.88,
      "e": 83.72,
      "text": "SPACE STATION IS PRICELESS."
    },
    {
      "s": 83.72,
      "e": 85.02,
      "text": "PEOPLE ALWAYS ASK, YOU KNOW,"
    },
    {
      "s": 85.02,
      "e": 86.29,
      "text": "DO YOU GET BORED OR,"
    },
    {
      "s": 86.29,
      "e": 87.69,
      "text": "YOU KNOW, IT'S A TERRIBLE BEING UP THERE"
    },
    {
      "s": 87.69,
      "e": 88.72,
      "text": "FOR A LONG PERIOD OF TIME."
    },
    {
      "s": 88.72,
      "e": 90.19,
      "text": "AND FOR ME, I LOVED EVERY MINUTE."
    },
    {
      "s": 90.19,
      "e": 92.16,
      "text": "THERE WAS ALWAYS SOMETHING TO DO."
    },
    {
      "s": 92.16,
      "e": 92.69,
      "text": "YOU WAKE UP,"
    },
    {
      "s": 92.69,
      "e": 94.16,
      "text": "YOU LOOK AT YOUR TIMELINE LIKE, WOW,"
    },
    {
      "s": 94.16,
      "e": 95.66,
      "text": "I GOT TO DO THIS EXPERIMENT TODAY,"
    },
    {
      "s": 95.66,
      "e": 96.93,
      "text": "I GOT TO GET READY FOR A SPACEWALK."
    },
    {
      "s": 96.93,
      "e": 97.9,
      "text": "EVERY DAY WAS DIFFERENT,"
    },
    {
      "s": 97.9,
      "e": 99.33,
      "text": "AND JUST LIFE ON THE SPACE"
    },
    {
      "s": 99.33,
      "e": 100.8,
      "text": "STATION BECOMES ROUTINE,"
    },
    {
      "s": 100.8,
      "e": 102.5,
      "text": "WHICH IS SORT OF CRAZY TO THINK ABOUT IT."
    },
    {
      "s": 102.5,
      "e": 103.57,
      "text": "AT ONE POINT IN TIME,"
    },
    {
      "s": 103.57,
      "e": 105.6,
      "text": "ON MY FIRST MISSION, I WAS LIKE,"
    },
    {
      "s": 105.6,
      "e": 106.77,
      "text": "I DON'T EVEN REMEMBER REALLY"
    },
    {
      "s": 106.77,
      "e": 108.04,
      "text": "WHAT IT'S LIKE TO WALK."
    },
    {
      "s": 108.04,
      "e": 110.31,
      "text": "I'VE BEEN FLYING AROUND FOR SO LONG,"
    },
    {
      "s": 110.31,
      "e": 110.94,
      "text": "I DON'T EVEN KNOW"
    },
    {
      "s": 110.94,
      "e": 112.65,
      "text": "WHAT IT'S LIKE TO SIT DOWN."
    },
    {
      "s": 112.65,
      "e": 114.71,
      "text": "I GOT ASSIGNED TO THE COMMERCIAL CREW"
    },
    {
      "s": 114.71,
      "e": 116.52,
      "text": "CADRE IN 2015."
    },
    {
      "s": 116.52,
      "e": 117.65,
      "text": "WE WENT TO THE COMPANIES,"
    },
    {
      "s": 117.65,
      "e": 120.12,
      "text": "FOUND OUT THE SHELL OF THEIR PROGRAMS,"
    },
    {
      "s": 120.12,
      "e": 121.02,
      "text": "AND THEN ACTUALLY"
    },
    {
      "s": 121.02,
      "e": 122.32,
      "text": "STARTED WORKING WITH THEM"
    },
    {
      "s": 122.32,
      "e": 123.06,
      "text": "TO MAKE THEM"
    },
    {
      "s": 123.06,
      "e": 123.96,
      "text": "WHAT THEY ARE TODAY"
    },
    {
      "s": 123.96,
      "e": 126.39,
      "text": "TO ACCOMMODATE ASTRONAUTS."
    },
    {
      "s": 126.39,
      "e": 127.29,
      "text": "FOR STARLINER,"
    },
    {
      "s": 127.29,
      "e": 128.46,
      "text": "WE'VE BEEN HEAVILY"
    },
    {
      "s": 128.46,
      "e": 130.0,
      "text": "INVOLVED IN THE LAST COUPLE OF YEARS"
    },
    {
      "s": 130.0,
      "e": 131.73,
      "text": "IN THE SOFTWARE, WITH THE FOLKS"
    },
    {
      "s": 131.73,
      "e": 133.7,
      "text": "DOING THE DEVELOPMENT TO MAKE SURE"
    },
    {
      "s": 133.7,
      "e": 134.93,
      "text": "ITS CAPABILITY"
    },
    {
      "s": 134.93,
      "e": 136.1,
      "text": "WILL ALLOW US TO COME HOME,"
    },
    {
      "s": 136.1,
      "e": 136.9,
      "text": "AND WE'VE BEEN INVOLVED"
    },
    {
      "s": 136.9,
      "e": 138.27,
      "text": "WITH ALL THE SUIT DEVELOPMENT,"
    },
    {
      "s": 138.27,
      "e": 139.07,
      "text": "MAKING SURE"
    },
    {
      "s": 139.07,
      "e": 140.41,
      "text": "EVERY DIFFERENT SIZE OF PERSON"
    },
    {
      "s": 140.41,
      "e": 141.91,
      "text": "COULD FIT IN ALL THESE SUITS,"
    },
    {
      "s": 141.91,
      "e": 142.81,
      "text": "AND THEY CAN OPERATE"
    },
    {
      "s": 142.81,
      "e": 144.31,
      "text": "THE SPACECRAFT ADEQUATELY."
    },
    {
      "s": 144.31,
      "e": 145.31,
      "text": "WE'VE HAD OUR FINGERS"
    },
    {
      "s": 145.31,
      "e": 146.48,
      "text": "ON EVERY SINGLE PROCEDURE"
    },
    {
      "s": 146.48,
      "e": 148.28,
      "text": "THAT WE WORK INSIDE THE COCKPIT,"
    },
    {
      "s": 148.28,
      "e": 149.88,
      "text": "AS WELL AS OPERATED IT"
    },
    {
      "s": 149.88,
      "e": 151.45,
      "text": "WITH OUR MISSION CONTROL TEAM"
    },
    {
      "s": 151.45,
      "e": 152.65,
      "text": "TO MAKE SURE THAT EVERYTHING"
    },
    {
      "s": 152.65,
      "e": 154.65,
      "text": "THAT FUTURE CREWS WILL DO WILL BE RIGHT."
    },
    {
      "s": 154.65,
      "e": 156.96,
      "text": "WE HAVEN'T HAD THE CLASSIC TRAINING"
    },
    {
      "s": 156.96,
      "e": 158.99,
      "text": "AS WE HAD FOR SHUTTLE AND SOYUZ."
    },
    {
      "s": 158.99,
      "e": 160.46,
      "text": "WE'VE SORT OF HELPED DEVELOP"
    },
    {
      "s": 160.46,
      "e": 162.36,
      "text": "THE TRAINING AS WELL AS THE HARDWARE,"
    },
    {
      "s": 162.36,
      "e": 164.06,
      "text": "AND THIS IS SORT OF THE SHAPE OF THINGS"
    },
    {
      "s": 164.06,
      "e": 165.26,
      "text": "TO COME AS WE GET"
    },
    {
      "s": 165.26,
      "e": 166.43,
      "text": "READY TO GO BACK TO THE MOON."
    },
    {
      "s": 166.43,
      "e": 168.53,
      "text": "ALL OF THAT IS GOING TO BE DEVELOPMENTAL,"
    },
    {
      "s": 168.53,
      "e": 169.6,
      "text": "AND WE'RE GOING TO HAVE TO HAVE"
    },
    {
      "s": 169.6,
      "e": 170.6,
      "text": "THE SAME MINDSET."
    },
    {
      "s": 170.6,
      "e": 172.07,
      "text": "IT'S NOT ALREADY ESTABLISHED."
    },
    {
      "s": 172.07,
      "e": 174.57,
      "text": "WE ALL HAVE TO BE PART OF THIS BIG TEAM"
    },
    {
      "s": 174.57,
      "e": 175.68,
      "text": "TO HELP DEVELOP IT"
    },
    {
      "s": 175.68,
      "e": 177.44,
      "text": "AND MAKE SURE THAT INTEGRATION,"
    },
    {
      "s": 177.44,
      "e": 177.68,
      "text": "YOU KNOW,"
    },
    {
      "s": 177.68,
      "e": 179.75,
      "text": "AS THE ASTRONAUTS USE ALL THIS EQUIPMENT,"
    },
    {
      "s": 179.75,
      "e": 180.98,
      "text": "IT'S GOING TO BE TOP NOTCH"
    },
    {
      "s": 180.98,
      "e": 182.55,
      "text": "AND READY TO TAKE US EVEN FURTHER."
    }
