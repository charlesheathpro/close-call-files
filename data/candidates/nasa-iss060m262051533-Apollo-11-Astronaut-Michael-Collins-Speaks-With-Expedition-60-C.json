      "s": 1417.83,
      "e": 1418.54,
      "text": "YEARS BACK."
    },
    {
      "s": 1418.54,
      "e": 1422.67,
      "text": "BUT BLESS YOU, AND HAVE A GOOD"
    },
    {
      "s": 1422.67,
      "e": 1422.84,
      "text": "ONE."
    },
    {
      "s": 1422.84,
      "e": 1425.3,
      "text": ">> SIR, LUCA HERE FROM ITALY."
    },
    {
      "s": 1425.3,
      "e": 1428.8,
      "text": "I JUST WANTED TO LET YOU KNOW"
    },
    {
      "s": 1428.8,
      "e": 1431.22,
      "text": "THAT EVEN THOUGH I -- I WASN'T"
    },
    {
      "s": 1431.22,
      "e": 1432.14,
      "text": "EVEN BORN AT THE TIME, YOUR"
    },
    {
      "s": 1432.14,
      "e": 1434.89,
      "text": "LEGACY WAS SO STRONG, AND YOU"
    },
    {
      "s": 1434.89,
      "e": 1436.64,
      "text": "LEFT SUCH -- SUCH AN IMPRESSION"
    },
    {
      "s": 1436.64,
      "e": 1438.23,
      "text": "ON ALL OF US THAT EVEN AS A"
