  "transcript": [
    {
      "s": 11.11,
      "e": 19.62,
      "text": "[ MUSIC ]"
    },
    {
      "s": 21.42,
      "e": 22.72,
      "text": ">> HI, I'M SYDNEY,"
    },
    {
      "s": 22.72,
      "e": 23.82,
      "text": "AND I'M COMING TO YOU FROM"
    },
    {
      "s": 23.82,
      "e": 25.36,
      "text": "THE FLIGHT RESEARCH BUILDING,"
    },
    {
      "s": 25.36,
      "e": 27.06,
      "text": "ALSO KNOWN AS THE HANGAR,"
    },
    {
      "s": 27.06,
      "e": 27.99,
      "text": "AT THE NASA GLENN"
    },
    {
      "s": 27.99,
      "e": 29.76,
      "text": "RESEARCH CENTER."
    },
    {
      "s": 29.76,
      "e": 30.83,
      "text": "NASA HAS A CHALLENGE"
    },
    {
      "s": 30.83,
      "e": 32.03,
      "text": "TO SHARE WITH YOU,"
    },
    {
      "s": 32.03,
      "e": 32.83,
      "text": "AND WE WANT TO SEE"
    },
    {
      "s": 32.83,
      "e": 33.97,
      "text": "YOUR SOLUTIONS."
    },
    {
      "s": 33.97,
      "e": 36.4,
      "text": "IT'S CALLED LET IT GLIDE."
    },
    {
      "s": 36.4,
      "e": 38.94,
      "text": "IN 1958, THE NACA BECAME"
    },
    {
      "s": 38.94,
      "e": 41.21,
      "text": "NASA AS WE KNOW IT TODAY."
    },
    {
      "s": 41.21,
      "e": 42.58,
      "text": "EVEN AFTER 100 YEARS"
    },
    {
      "s": 42.58,
      "e": 44.68,
      "text": "OF RESEARCH, NASA CONTINUES"
    },
    {
      "s": 44.68,
      "e": 46.95,
      "text": "TO STUDY AND IMPROVE FLIGHT."
    },
    {
      "s": 46.95,
      "e": 47.98,
      "text": "TODAY, I'M HERE WITH"
    },
    {
      "s": 47.98,
      "e": 49.25,
      "text": "GLENN RESEARCH CENTER'S"
    },
    {
      "s": 49.25,
      "e": 50.85,
      "text": "CHEIF OF AIRCRAFT OPERATIONS,"
    },
    {
      "s": 50.85,
      "e": 52.32,
      "text": "JIM DEMERS."
    },
    {
      "s": 52.32,
      "e": 53.19,
      "text": "JIM, CAN YOU TELL US"
    },
    {
      "s": 53.19,
      "e": 54.59,
      "text": "A BIT ABOUT THE RESEARCH DONE"
    },
    {
      "s": 54.59,
      "e": 56.12,
      "text": "ON NASA'S AIRCRAFT."
    },
    {
      "s": 56.12,
      "e": 57.26,
      "text": ">> OF COURSE, SYDNEY."
    },
    {
      "s": 57.26,
      "e": 58.83,
      "text": "WE LOAD SCIENTIFIC EQUIPMENT"
    },
    {
      "s": 58.83,
      "e": 60.23,
      "text": "INTO THESE PLANES AND STUDY"
    },
    {
      "s": 60.23,
      "e": 61.76,
      "text": "THE WORLD AROUND US,"
    },
    {
      "s": 61.76,
      "e": 62.43,
      "text": "FROM AS LOW AS A FEW"
    },
    {
      "s": 62.43,
      "e": 64.2,
      "text": "HUNDRED FEET ABOVE THE GROUND,"
    },
    {
      "s": 64.2,
      "e": 65.77,
      "text": "AND UP TO 40,000 FEET"
    },
    {
      "s": 65.77,
      "e": 67.23,
      "text": "IN THE AIR."
    },
    {
      "s": 67.23,
      "e": 68.1,
      "text": "WE ARE CURRENTLY USING"
    },
    {
      "s": 68.1,
      "e": 69.3,
      "text": "OUR TWIN OTTER AIRCRAFT TO"
    },
    {
      "s": 69.3,
      "e": 70.67,
      "text": "STUDY THE HARMFUL ALGAE BLOOMS"
    },
    {
      "s": 70.67,
      "e": 72.47,
      "text": "IN LAKE ERIE, AND OUR T-34"
    },
    {
      "s": 72.47,
      "e": 73.54,
      "text": "IS BEING USED TO TEST"
    },
    {
      "s": 73.54,
      "e": 75.81,
      "text": "COMMUNICATIONS FOR AIRCRAFT."
    },
    {
      "s": 75.81,
      "e": 76.74,
      "text": "WE ARE ALSO RESEARCHING"
    },
    {
      "s": 76.74,
      "e": 78.14,
      "text": "UNMANNED AIRCRAFT SYSTEMS"
    },
    {
      "s": 78.14,
      "e": 79.45,
      "text": "LIKE DRONES,"
    },
    {
      "s": 79.45,
      "e": 80.08,
      "text": "AND HOW THEY WILL WORK"
    },
    {
      "s": 80.08,
      "e": 83.05,
      "text": "ALONGSIDE PILOTED AIRCRAFT."
    },
    {
      "s": 83.05,
      "e": 84.38,
      "text": ">> SO WHAT DETERMINES WHICH PLAN"
    },
    {
      "s": 84.38,
      "e": 86.62,
      "text": "YOU USE FOR WHICH RESEARCH?"
    },
    {
      "s": 86.62,
      "e": 87.82,
      "text": ">> THAT'S A GREAT QUESTION."
    },
    {
      "s": 87.82,
      "e": 89.02,
      "text": "WE MODIFY OUR AIRCRAFT FOR"
    },
    {
      "s": 89.02,
      "e": 90.62,
      "text": "DIFFERENT TYPES OF RESEARCH,"
    },
    {
      "s": 90.62,
      "e": 91.96,
      "text": "FOR EXAMPLE, THE TWIN OTTER"
    },
    {
      "s": 91.96,
      "e": 92.96,
      "text": "WAS DESIGNED TO FLY"
    },
    {
      "s": 92.96,
      "e": 94.33,
      "text": "AT LOWER ALTITUDES AND LAND"
    },
    {
      "s": 94.33,
      "e": 96.33,
      "text": "ON SHORT RUNWAYS."
    },
    {
      "s": 96.33,
      "e": 97.33,
      "text": "WHILE THE S3 WAS MADE TO"
    },
    {
      "s": 97.33,
      "e": 99.06,
      "text": "FLY HIGH, FAST, AND LAND"
    },
    {
      "s": 99.06,
      "e": 101.23,
      "text": "ON AIRCRAFT CARRIERS."
    },
    {
      "s": 101.23,
      "e": 102.47,
      "text": "OUR S-3 VIKING PERFORMS"
    },
    {
      "s": 102.47,
      "e": 104.04,
      "text": "WELL AT LOWER ALTITUDES CLOSE"
    },
    {
      "s": 104.04,
      "e": 105.54,
      "text": "TO THE GROUND, AS WELL AS"
    },
    {
      "s": 105.54,
      "e": 107.61,
      "text": "THE MID ALTITUDE RANGE."
    },
    {
      "s": 107.61,
      "e": 109.01,
      "text": "YOU'LL NOTICE THE WING SHAPES"
    },
    {
      "s": 109.01,
      "e": 111.44,
      "text": "AND THICKNESS, FUSELAGE DESIGNS"
    },
    {
      "s": 111.44,
      "e": 112.48,
      "text": "AND ENGINES ARE DIFFERENT"
    },
    {
      "s": 112.48,
      "e": 113.58,
      "text": "DEPENDING ON THE AIRCRAFT'S"
    },
    {
      "s": 113.58,
      "e": 116.08,
      "text": "INTENDED MISSION OR USE."
    },
    {
      "s": 116.08,
      "e": 117.25,
      "text": "BASED ON THESE FEATURES,"
    },
    {
      "s": 117.25,
      "e": 117.98,
      "text": "THE PLANES WILL"
    },
    {
      "s": 117.98,
      "e": 119.59,
      "text": "PERFORM DIFFERENTLY,"
    },
    {
      "s": 119.59,
      "e": 120.62,
      "text": "GIVING US THE ABILITY TO FLY"
    },
    {
      "s": 120.62,
      "e": 122.16,
      "text": "GREATER DISTANCES"
    },
    {
      "s": 122.16,
      "e": 123.76,
      "text": "AND HIGHER ALTITUDES,"
    },
    {
      "s": 123.76,
      "e": 124.59,
      "text": "AT FASTER SPEEDS"
    },
    {
      "s": 124.59,
      "e": 126.49,
      "text": "OR CARRY MORE WEIGHT."
    },
    {
      "s": 126.49,
      "e": 127.53,
      "text": "WE THEN CHOOSE THE PLANE"
    },
    {
      "s": 127.53,
      "e": 128.73,
      "text": "THAT WILL DO THE BEST JOB"
    },
    {
      "s": 128.73,
      "e": 129.8,
      "text": "FOR THE SCIENTIFIC RESEARCH"
    },
    {
      "s": 129.8,
      "e": 132.03,
      "text": "WE ARE WORKING ON."
    },
    {
      "s": 132.03,
      "e": 133.4,
      "text": "NASA IS CURRENTLY DEVELOPING"
    },
    {
      "s": 133.4,
      "e": 134.97,
      "text": "AN EXPERIMENTAL AIRCRAFT"
    },
    {
      "s": 134.97,
      "e": 137.47,
      "text": "DESIGNED AS A LOW BOOM VEHICLE."
    },
    {
      "s": 137.47,
      "e": 138.91,
      "text": "TO REDUCE OR ALMOST ELIMINATE"
    },
    {
      "s": 138.91,
      "e": 139.94,
      "text": "THE THUNDER-LIKE SOUND"
    },
    {
      "s": 139.94,
      "e": 141.57,
      "text": "PRODUCED WHEN AN AIRCRAFT"
    },
    {
      "s": 141.57,
      "e": 142.81,
      "text": "FLIES FASTER THAN THE SPEED"
    },
    {
      "s": 142.81,
      "e": 143.81,
      "text": "OF SOUND."
    },
    {
      "s": 143.81,
      "e": 144.54,
      "text": "THIS NOISE IS CALLED"
    },
    {
      "s": 144.54,
      "e": 146.01,
      "text": "THE SONIC BOOM."
    },
    {
      "s": 146.01,
      "e": 146.95,
      "text": "THIS RESEARCH COULD ALLOW"
    },
    {
      "s": 146.95,
      "e": 148.08,
      "text": "SUPERSONIC FLIGHTS OVER"
    },
    {
      "s": 148.08,
      "e": 149.12,
      "text": "THE UNITED STATES AND MAKE"
    },
    {
      "s": 149.12,
      "e": 150.78,
      "text": "AIR TRAVEL FASTER"
    },
    {
      "s": 150.78,
      "e": 152.99,
      "text": "AND MORE EFFICIENT."
    },
    {
      "s": 152.99,
      "e": 154.85,
      "text": ">> SO HERE'S WHERE YOU COME IN."
    },
    {
      "s": 154.85,
      "e": 155.92,
      "text": "TO BETTER UNDERSTAND"
    },
    {
      "s": 155.92,
      "e": 156.92,
      "text": "THE AIRCRAFT FEATURES"
    },
    {
      "s": 156.92,
      "e": 158.62,
      "text": "THAT JIM MENTIONED, WE WANT"
    },
    {
      "s": 158.62,
      "e": 160.63,
      "text": "YOUR TEAM TO DESIGN AND BUILD"
    },
    {
      "s": 160.63,
      "e": 162.33,
      "text": "A GLIDER OUT OF A SHOEBOX"
    },
    {
      "s": 162.33,
      "e": 163.6,
      "text": "THAT COULD MODEL ONE OF"
    },
    {
      "s": 163.6,
      "e": 166.03,
      "text": "THESE TYPES OF AIRCRAFT."
    },
    {
      "s": 166.03,
      "e": 167.4,
      "text": "TO COMPLETE THE CHALLENGE,"
    },
    {
      "s": 167.4,
      "e": 169.0,
      "text": "YOU AND YOUR TEAM WILL EXPLORE"
    },
    {
      "s": 169.0,
      "e": 172.0,
      "text": "THE FOUR COURSES OF FLIGHT."
    },
    {
      "s": 172.0,
      "e": 172.67,
      "text": "AND WORK THROUGH"
    },
    {
      "s": 172.67,
      "e": 174.64,
      "text": "THE ENGINEERING DESIGN PROCESS"
    },
    {
      "s": 174.64,
      "e": 175.84,
      "text": "TO COME UP WITH THE BEST"
    },
    {
      "s": 175.84,
      "e": 179.21,
      "text": "DESIGN POSSIBLE."
    },
    {
      "s": 179.21,
      "e": 180.35,
      "text": "YOU WILL NEED TO DESIGN"
    },
    {
      "s": 180.35,
      "e": 181.31,
      "text": "AND BIULD A GLIDER"
    },
    {
      "s": 181.31,
      "e": 182.58,
      "text": "THAT MUST..."
    },
    {
      "s": 203.04,
      "e": 204.3,
      "text": "THERE WILL BE OPPORTUNITIES"
    },
    {
      "s": 204.3,
      "e": 206.31,
      "text": "TO INTERACT WITH NASA SCIENTISTS"
    },
    {
      "s": 206.31,
      "e": 208.84,
      "text": "AND ENGINEERS LIKE US."
    },
    {
      "s": 208.84,
      "e": 209.51,
      "text": "WHEN YOU'VE CREATED"
    },
    {
      "s": 209.51,
      "e": 210.74,
      "text": "YOUR FINAL SOLUTION,"
    },
    {
      "s": 210.74,
      "e": 211.78,
      "text": "YOUR TEAM WILL PRESENT IT"
    },
    {
      "s": 211.78,
      "e": 213.58,
      "text": "TO NASA."
    },
    {
      "s": 213.58,
      "e": 214.71,
      "text": "AS FUTURE SCIENTISTS"
    },
    {
      "s": 214.71,
      "e": 216.22,
      "text": "AND ENGINEERS, NASA NEEDS"
    },
    {
      "s": 216.22,
      "e": 217.62,
      "text": "YOUR HELP IN SOLVING"
    },
    {
      "s": 217.62,
      "e": 220.15,
      "text": "THIS REAL WORLD PROBLEM."
    },
    {
      "s": 220.15,
      "e": 221.32,
      "text": ">> GOOD LUCK! AND WE LOOK"
    },
    {
      "s": 221.32,
      "e": 222.06,
      "text": "FORWARD TO SEEING"
    },
    {
      "s": 222.06,
      "e": 223.96,
      "text": "YOUR SOLUTIONS."
    },
    {
      "s": 224.46,
      "e": 233.47,
