      "s": 149.01,
      "e": 149.98,
      "text": "dependent out here."
    },
    {
      "s": 149.98,
      "e": 151.32,
      "text": "And so by implementing"
    },
    {
      "s": 151.32,
      "e": 152.25,
      "text": "prescribed fire on a"
    },
    {
      "s": 152.25,
      "e": 153.02,
      "text": "2 to 3 year"
    },
    {
      "s": 153.02,
      "e": 155.16,
      "text": "basis, that maintains that habitat"
    },
    {
      "s": 155.16,
      "e": 156.46,
      "text": "for Red-cockaded"
    },
    {
      "s": 156.46,
      "e": 157.79,
      "text": "woodecker, Gopher tortoise,"
    },
    {
      "s": 157.79,
      "e": 159.12,
      "text": "Eastern indigo snake,"
    },
    {
      "s": 159.12,
      "e": 161.13,
      "text": "all these species of concern like that."
    },
    {
      "s": 161.13,
      "e": 162.33,
      "text": "[HIERS] So this prescribed fires"
    },
    {
      "s": 162.33,
      "e": 164.1,
      "text": "in support of critical research"
    },
    {
      "s": 164.1,
      "e": 167.37,
      "text": "that allows us to test and evaluate,"
    },
    {
      "s": 167.37,
      "e": 168.37,
      "text": "various satellites"
    },
    {
      "s": 168.37,
      "e": 169.17,
      "text": "and airborne"
