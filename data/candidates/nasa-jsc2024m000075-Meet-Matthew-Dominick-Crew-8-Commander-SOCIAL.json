  "transcript_source": "captions",
  "transcript": [
    {
      "s": 0.42,
      "e": 2.08,
      "text": "I AM MOST EXCITED"
    },
    {
      "s": 2.08,
      "e": 2.54,
      "text": "FOR THE FUTURE"
    },
    {
      "s": 2.54,
      "e": 3.54,
      "text": "OF SPACEFLIGHT"
    },
    {
      "s": 3.54,
      "e": 5.05,
      "text": "FOR AN INFLECTION POINT"
    },
    {
      "s": 5.05,
      "e": 6.59,
      "text": "THAT I FEEL IS COMING."
    },
    {
      "s": 6.59,
      "e": 7.63,
      "text": "IF YOU LOOK AT THE HISTORY"
    },
    {
      "s": 7.63,
      "e": 8.47,
      "text": "OF CIVILIZATION"
    },
    {
      "s": 8.47,
      "e": 10.47,
      "text": "AND VARIOUS INFLECTION POINTS,"
    },
    {
      "s": 10.47,
      "e": 13.47,
      "text": "YOU KNOW, THINGS JUST KIND OF TAKE OFF."
    },
    {
      "s": 13.51,
      "e": 14.85,
      "text": "I AM NASA ASTRONAUT MATTHEW"
    },
    {
      "s": 14.85,
      "e": 15.97,
      "text": "DOMINICK, COMMANDER."
    },
    {
      "s": 15.97,
      "e": 17.06,
      "text": "NASA'S SPACE X"
    },
    {
      "s": 17.06,
      "e": 17.85,
      "text": "CREW-8 MISSION"
    },
    {
      "s": 17.85,
      "e": 20.81,
      "text": "TO THE INTERNATIONAL SPACE STATION."
    },
    {
      "s": 20.81,
      "e": 22.11,
      "text": "I GREW UP IN WHEAT RIDGE, COLORADO."
    },
    {
      "s": 22.11,
      "e": 24.11,
      "text": "I WAS THE OLDEST OF TWO BROTHERS."
    },
    {
      "s": 24.11,
      "e": 26.65,
      "text": "I HAD TWO PARENTS THAT WERE AMAZING IN"
    },
    {
      "s": 26.65,
      "e": 28.4,
      "text": "THAT THEY ENCOURAGED MY CURIOSITY."
    },
    {
      "s": 28.4,
      "e": 29.53,
      "text": "GROWING UP THERE IN THE ROCKIES,"
    },
    {
      "s": 29.53,
      "e": 30.2,
      "text": "IN THE OUTDOORS,"
    },
    {
      "s": 30.2,
      "e": 30.32,
      "text": "THERE ARE"
    },
    {
      "s": 30.32,
      "e": 33.32,
      "text": "SO MANY THINGS TO GO AND DO AND SEE."
    },
    {
      "s": 33.41,
      "e": 36.79,
      "text": "I'VE ALWAYS WANTED TO EXPLORE AND SATIATE"
    },
    {
      "s": 36.79,
      "e": 38.58,
      "text": "MY CURIOSITY FOR THE WORLD AROUND ME,"
    },
    {
      "s": 38.58,
      "e": 39.83,
      "text": "AND SO I JUST KEPT PUSHING"
    },
    {
      "s": 39.83,
      "e": 41.0,
      "text": "THROUGHOUT MY LIFE."
    },
    {
      "s": 41.0,
      "e": 41.62,
      "text": "I JOINED THE NAVY"
    },
    {
      "s": 41.62,
      "e": 42.79,
      "text": "BECAUSE I WANTED TO FLY AIRPLANES."
    },
    {
      "s": 42.79,
      "e": 43.54,
      "text": "I WANTED TO GO FAST."
    },
    {
      "s": 43.54,
      "e": 44.96,
      "text": "I WANTED TO TEST AIRPLANES."
    },
    {
      "s": 44.96,
      "e": 46.42,
      "text": "AND SO ASTRONAUT FOR ME"
    },
    {
      "s": 46.42,
      "e": 47.13,
      "text": "WAS JUST"
    },
    {
      "s": 47.13,
      "e": 48.59,
      "text": "THE NEXT LOGICAL STEP IN LIFE"
    },
    {
      "s": 48.59,
      "e": 49.92,
      "text": "TO KEEP GOING AND KEEP EXPLORING"
    },
    {
      "s": 49.92,
      "e": 50.92,
      "text": "AND KEEP PUSHING MYSELF"
    },
    {
      "s": 50.92,
      "e": 51.68,
      "text": "FURTHER"
    },
    {
      "s": 51.68,
      "e": 53.26,
      "text": "IN TERMS OF INTELLECTUAL CURIOSITY"
    },
    {
      "s": 53.26,
      "e": 54.85,
      "text": "ABOUT THE WORLD AROUND ME."
    },
    {
      "s": 54.85,
      "e": 55.6,
      "text": "I'VE BEEN IN NASA"
    },
    {
      "s": 55.6,
      "e": 56.81,
      "text": "NOW FOR ABOUT SIX YEARS,"
    },
    {
      "s": 56.81,
      "e": 59.48,
      "text": "AND I'M SUPER EXCITED TO FLY IN SPACE."
    },
    {
      "s": 59.48,
      "e": 61.23,
      "text": "WORKING AND TRAINING WITH CREW-8"
    },
    {
      "s": 61.23,
      "e": 63.73,
      "text": "IS ABSOLUTELY AWESOME."
    },
    {
      "s": 63.73,
      "e": 66.86,
      "text": "WE HAVE A DIVERSE GROUP OF ACADEMIC"
    },
    {
      "s": 66.86,
      "e": 67.98,
      "text": "AND INTELLECTUAL BACKGROUNDS"
    },
    {
      "s": 67.98,
      "e": 68.57,
      "text": "THAT COME TOGETHER"
    },
    {
      "s": 68.57,
      "e": 69.82,
      "text": "AND ALSO AN INTERNATIONAL COMPONENT."
    },
    {
      "s": 69.82,
      "e": 71.95,
      "text": "IT IS SUCH A BLAST TO WATCH THE CREW"
    },
    {
      "s": 71.95,
      "e": 72.66,
      "text": "GROW AS WE STARTED"
    },
    {
      "s": 72.66,
      "e": 73.45,
      "text": "TRAINING OVER TIME"
    },
    {
      "s": 73.45,
      "e": 75.41,
      "text": "TO WATCH THAT TEAM DYNAMICS DEVELOP"
    },
    {
      "s": 75.41,
      "e": 76.41,
      "text": "AS WE GET READY TO LAUNCH THAT."
    },
    {
      "s": 76.41,
      "e": 76.91,
      "text": "WE'RE STARTING TO SEE"
    },
    {
      "s": 76.91,
      "e": 77.66,
      "text": "WHAT MAKES EACH OTHER TICK,"
    },
    {
      "s": 77.66,
      "e": 78.95,
      "text": "WHAT'S IMPORTANT TO EACH OTHER."
    },
    {
      "s": 81.04,
      "e": 82.79,
      "text": "I VIEW CREW-8"
    },
    {
      "s": 82.79,
      "e": 84.38,
      "text": "LIKE AN OLYMPIC TORCH BEARER."
    },
    {
      "s": 84.38,
      "e": 85.84,
      "text": "THAT'S WHERE I SEE CREW-8."
    },
    {
      "s": 85.84,
      "e": 88.0,
      "text": "WE ARE A TORCH BEARER ON THAT PATH"
    },
    {
      "s": 88.0,
      "e": 88.55,
      "text": "TO THE OLYMPICS"
    },
    {
      "s": 88.55,
      "e": 90.42,
      "text": "THAT ARE GOING TO OCCUR IN THE FUTURE"
    },
    {
      "s": 90.42,
      "e": 91.84,
      "text": "AS WE MOVE HUMANITY FORWARD."
    },
    {
      "s": 91.84,
      "e": 92.8,
      "text": "WE'RE GOING UP THERE TO RELIEVE"
    },
    {
      "s": 92.8,
      "e": 95.26,
      "text": "CREW-7 CREW-9 WILL RELIEVE US."
    },
    {
      "s": 95.26,
      "e": 98.14,
      "text": "AND WE ARE KEEPING THE FLAME OF SPACE,"
    },
    {
      "s": 98.14,
      "e": 101.14,
      "text": "HUMAN PRESENCE, IN LOW-EARTH ORBIT ALIVE."
    },
    {
      "s": 101.18,
      "e": 102.31,
      "text": "IF YOU'RE A STUDIER OF SCIENCE"
    },
    {
      "s": 102.31,
      "e": 103.73,
      "text": "OR STATISTICS, YOU KNOW THAT"
    },
    {
      "s": 103.73,
      "e": 105.1,
      "text": "YOU ALWAYS WANT TO HAVE A BIG “N,”"
    },
    {
      "s": 105.1,
      "e": 106.4,
      "text": "AND THAT JUST MEANS SAMPLE SIZE"
    },
    {
      "s": 106.4,
      "e": 108.69,
      "text": "TO UNDERSTAND THE THING YOU'RE STUDYING."
    },
    {
      "s": 108.69,
      "e": 109.48,
      "text": "SO JUST LAUNCHING"
    },
    {
      "s": 109.48,
      "e": 112.03,
      "text": "ONE OR TWO OR TEN OR 15 PEOPLE TO SPACE"
    },
    {
      "s": 112.03,
      "e": 113.74,
      "text": "LEAVES YOU WITH A VERY SMALL SAMPLE SIZE."
    },
    {
      "s": 113.74,
      "e": 115.2,
      "text": "SO EVERY TIME WE LAUNCH"
    },
    {
      "s": 115.2,
      "e": 116.7,
      "text": "FOUR MORE PEOPLE TO SPACE,"
    },
    {
      "s": 116.7,
      "e": 117.83,
      "text": "WE'RE BUILDING OUR SAMPLE SIZE"
    },
    {
      "s": 117.83,
      "e": 119.24,
      "text": "AND OUR UNDERSTANDING OF THE HUMAN BODY"
    },
    {
      "s": 119.24,
      "e": 120.91,
      "text": "AND THE THINGS THAT HAPPEN TO IT"
    },
    {
      "s": 120.91,
      "e": 122.29,
      "text": "IN A ZERO GRAVITY ENVIRONMENT"
    },
    {
      "s": 122.29,
      "e": 124.08,
      "text": "THAT SETS US UP TO GO TO THE MOON."
    },
    {
      "s": 124.08,
      "e": 125.46,
      "text": "IT SETS US UP TO GO TO MARS."
    },
    {
      "s": 126.88,
      "e": 128.13,
      "text": "MANY FOLKS THINK OF NASA AND"
    },
    {
      "s": 128.13,
      "e": 129.63,
      "text": "THEY THINK WE'RE USING CRAZY"
    },
    {
      "s": 129.63,
      "e": 131.17,
      "text": "CUTTING EDGE TECHNOLOGY"
    },
    {
      "s": 131.17,
      "e": 132.67,
      "text": "AND ALL KINDS OF ADJECTIVES"
    },
    {
      "s": 132.67,
      "e": 134.97,
      "text": "AND SUPERLATIVES TO MAKE SPACE WORK."
    },
    {
      "s": 134.97,
      "e": 136.01,
      "text": "THERE'S NO SMOKE AND MIRRORS."
    },
    {
      "s": 136.01,
      "e": 136.72,
      "text": "THERE'S NO MAGIC."
    },
    {
      "s": 136.72,
      "e": 138.35,
      "text": "IT IS JUST HARD WORK"
    },
    {
      "s": 138.35,
      "e": 139.93,
      "text": "THROUGH THE LAWS OF PHYSICS AND BASIC"
    },
    {
      "s": 139.93,
      "e": 141.31,
      "text": "MATERIAL SCIENCE TO GET US INTO ORBIT."
    },
    {
      "s": 141.31,
      "e": 142.81,
      "text": "THAT'S THAT'S THE MAGIC."
    },
    {
      "s": 142.81,
      "e": 146.15,
      "text": "WE ARE PART OF A MASSIVE TEAM OF PEOPLE"
    },
    {
      "s": 146.56,
      "e": 147.98,
      "text": "THAT NEED TO CONTINUE"
    },
    {
      "s": 147.98,
      "e": 149.31,
      "text": "CONTINUOUS HUMAN PRESENCE"
    },
    {
      "s": 149.31,
      "e": 150.07,
      "text": "IN LOW-EARTH ORBIT"
    },
    {
      "s": 150.07,
      "e": 151.44,
      "text": "AND NOT LETTING THAT FLAME GO OUT."
    },
    {
      "s": 151.44,
      "e": 152.61,
      "text": "WE ARE LINED"
    },
    {
      "s": 152.61,
      "e": 154.36,
      "text": "SOLDIERS ON THE GROUND MARCHING"
    },
    {
      "s": 154.36,
      "e": 155.74,
      "text": "TO MAKE SURE THAT THIS CONTINUES"
    },
    {
      "s": 155.74,
      "e": 157.24,
      "text": "AND JUST BEING A SMALL PART OF THAT"
    },
    {
      "s": 157.24,
      "e": 158.57,
      "text": "AND CONTINUING THAT IS WHAT'S IMPORTANT."
    }
  ],
