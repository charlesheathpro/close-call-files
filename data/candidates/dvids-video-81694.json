    {
      "s": 1.87,
      "e": 2.99,
      "text": "Hold sir."
    },
    {
      "s": 2.99,
      "e": 4.15,
      "text": "Fair take load."
    },
    {
      "s": 4.15,
      "e": 12.03,
      "text": "Especially if you're going to move back and left."
    },
    {
      "s": 12.03,
      "e": 13.03,
      "text": "Realize to be intended on deck."
    },
    {
      "s": 13.03,
      "e": 14.03,
      "text": "Roger, come on, left."
    },
    {
      "s": 14.03,
      "e": 19.64,
      "text": "You're back and left."
    },
    {
      "s": 19.64,
      "e": 20.64,
      "text": "Up, trail line, still be intended on deck."
    },
    {
      "s": 20.64,
      "e": 22.64,
      "text": "You're going to move back and left."
    },
    {
      "s": 22.64,
      "e": 23.64,
      "text": "Roger."
    },
    {
      "s": 23.64,
      "e": 25.64,
      "text": "P-side, do you listen, that gun is going a little bit?"
    },
    {
      "s": 25.64,
      "e": 26.64,
      "text": "Turn."
    },
    {
      "s": 26.64,
      "e": 27.64,
      "text": "Do you listen to my gun, or still?"
    },
    {
      "s": 27.64,
      "e": 28.64,
      "text": "Yeah."
    },
    {
      "s": 28.64,
      "e": 32.34,
      "text": "But there's about 15 people in the cabin."
    },
    {
      "s": 32.34,
      "e": 34.7,
      "text": "So be, so be, so be, so be, so be, so be, so be, so be, so be, so be, so be, so,"
    },
    {
