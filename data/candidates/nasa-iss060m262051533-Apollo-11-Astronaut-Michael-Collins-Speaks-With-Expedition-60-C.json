    {
      "s": 1304.97,
      "e": 1309.6,
      "text": "CONTROL FOR APOLLO 11 50 YEARS"
    },
    {
      "s": 1309.6,
      "e": 1309.77,
      "text": "AGO."
    },
    {
      "s": 1309.77,
      "e": 1312.39,
      "text": ">> YES, WHAT LITTLE I KNOW OF IT"
    },
    {
      "s": 1312.39,
      "e": 1315.52,
      "text": "TELLS ME THAT YOU HAVE -- I"
    },
    {
      "s": 1315.52,
      "e": 1319.23,
      "text": "DON'T KNOW 10, 12, 15 APOLLO"
    },
    {
      "s": 1319.23,
      "e": 1321.03,
      "text": "COMMAND MODULES PACKED IN THERE"
    },
    {
      "s": 1321.03,
      "e": 1323.03,
      "text": "IN TERMS OF COMPLEXITY?"
    },
    {
      "s": 1323.03,
      "e": 1325.32,
      "text": "I WOULD GUESS IT IS SOMEWHERE"
    },
    {
      "s": 1325.32,
      "e": 1326.12,
      "text": "AROUND THAT."
    },
    {
      "s": 1326.12,
      "e": 1332.04,
      "text": ">> IT'S ABOUT THE SIZE OF A"
    },
    {
      "s": 1332.04,
      "e": 1333.66,
      "text": "FIVE-BEDROOM HOUSE."
    },
    {
      "s": 1333.66,
      "e": 1336.63,
      "text": ">> WELL, I WISH YOU ALL WELL FOR"
    },
    {
      "s": 1336.63,
      "e": 1338.09,
      "text": "THE SUCCESSFUL COMPLETION OF"
    },
    {
      "s": 1338.09,
      "e": 1340.55,
      "text": "YOUR MISSION, AND MAYBE I CAN"
    },
    {
      "s": 1340.55,
      "e": 1343.47,
      "text": "GET A CHANCE TO SAY AGAIN TO ALL"
    },
    {
      "s": 1343.47,
      "e": 1345.89,
      "text": "OF YOU INDIVIDUALLY SOMEWHERE"
    },
    {
      "s": 1345.89,
      "e": 1350.06,
      "text": "DOWN HERE OWN THIS SCURVY EARTH."
