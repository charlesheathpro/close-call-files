      "text": "at this time I'll perform my poll."
    },
    {
      "s": 280.51,
      "e": 282.69,
      "text": "Attention on the net, this is a launch director"
    },
    {
      "s": 282.69,
      "e": 284.71,
      "text": "performing the final poll for launch,"
    },
    {
      "s": 284.71,
      "e": 287.71,
      "text": "fair find no constraints, and go for launch."
    },
    {
      "s": 287.71,
      "e": 297.89,
      "text": "EGS program chief engineer."
    },
    {
      "s": 297.89,
      "e": 299.05,
      "text": "Copy thank you."
    },
    {
      "s": 299.05,
      "e": 302.83,
      "text": "EGS chief safety officer."
    },
    {
      "s": 302.83,
      "e": 304.43,
      "text": "You got an empty."
    },
    {
      "s": 304.43,
      "e": 309.0,
      "text": "I got an empty."
    },
    {
      "s": 309.0,
      "e": 310.56,
      "text": "Copy thank you, Pete."
    },
    {
      "s": 310.56,
      "e": 315.66,
      "text": "Range weather."
    },
    {
      "s": 315.66,
      "e": 317.26,
      "text": "Copy thank you, L.W.O."
    },
    {
      "s": 317.26,
      "e": 319.02,
      "text": "and Artemis mission manager."
    },
    {
      "s": 320.42,
      "e": 322.74,
      "text": "And the other team can verify no constraints,"
    },
    {
      "s": 322.74,
      "e": 325.72,
      "text": "and you're a go for launch."
    },
    {
      "s": 325.76,
      "e": 327.24,
      "text": "Copy that, thank you."
    },
    {
      "s": 327.24,
      "e": 332.93,
      "text": "And CDR launch director."
    },
    {
      "s": 332.93,
      "e": 334.37,
      "text": "All right, thank you Reed."
    },
    {
      "s": 334.37,
      "e": 337.09,
      "text": "Teams worked really hard today to give you guys"
    },
    {
      "s": 337.09,
      "e": 338.61,
      "text": "right around the moon."
    },
    {
      "s": 338.61,
      "e": 341.77,
      "text": "We hope you have a safe and successful mission."
    },
    {
      "s": 341.77,
      "e": 342.97,
      "text": "Godspeed, good luck."
    }
