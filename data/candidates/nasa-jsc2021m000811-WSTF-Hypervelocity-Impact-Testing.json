      "e": 4.9,
      "text": ">> THE WHITE SANDS TEST FACILITY"
    },
    {
      "s": 4.9,
      "e": 6.37,
      "text": "REMOTE HYPERVELOCITY"
    },
    {
      "s": 6.37,
      "e": 7.47,
      "text": "TEST LABORATORY"
    },
    {
      "s": 7.47,
      "e": 9.01,
      "text": "IS AN ACCESS-CONTROLLED"
    },
    {
      "s": 9.01,
      "e": 10.51,
      "text": "HAZARDOUS TEST AREA"
    },
    {
      "s": 10.51,
      "e": 12.08,
      "text": "CAPABLE OF SIMULATING"
    },
    {
      "s": 12.08,
      "e": 13.18,
      "text": "MICROMETEOROID"
    },
    {
      "s": 13.18,
      "e": 14.85,
      "text": "AND ORBITAL DEBRIS IMPACTS"
    },
    {
      "s": 14.85,
      "e": 16.25,
      "text": "ON SPACECRAFT MATERIALS"
    },
    {
      "s": 16.25,
      "e": 17.82,
      "text": "AND COMPONENTS."
    },
    {
      "s": 17.82,
      "e": 20.22,
      "text": "FOUR 2-STAGE LIGHT GAS GUNS"
    },
    {
      "s": 20.22,
      "e": 21.89,
      "text": "PROPEL PROJECTILES IN EXCESS"
    },
    {
      "s": 21.89,
      "e": 24.86,
      "text": "OF 7.5 KILOMETERS PER SECOND."
    },
    {
      "s": 24.86,
      "e": 26.69,
      "text": "THIS UNIQUE NASA FACILITY"
    },
    {
      "s": 26.69,
      "e": 27.79,
