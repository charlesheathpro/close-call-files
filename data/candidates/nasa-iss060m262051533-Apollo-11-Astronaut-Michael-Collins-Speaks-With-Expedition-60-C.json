      "s": 1213.92,
      "e": 1215.13,
      "text": "AGO."
    },
    {
      "s": 1215.13,
      "e": 1216.88,
      "text": "THEY HAVE ALREADY PROVEN THEM TO"
    },
    {
      "s": 1216.88,
      "e": 1220.22,
      "text": "BE GREAT ADDITIONS TO THE CREW."
    },
    {
      "s": 1220.22,
      "e": 1222.35,
      "text": ">> WELL, THANK YOU SO MUCH."
    },
    {
      "s": 1222.35,
      "e": 1224.89,
      "text": "IT IS TRULY NICE TO BE HERE."
    },
    {
      "s": 1224.89,
      "e": 1227.6,
      "text": "THIS ROOM IS A LOT FANCIER THAN"
    },
    {
      "s": 1227.6,
      "e": 1229.89,
      "text": "IT USED TO BE IN MY TIME, BUT"
    },
    {
      "s": 1229.89,
      "e": 1236.07,
      "text": "THE FUNDCTION IS THE SAME, THAT"
    },
    {
      "s": 1236.07,
      "e": 1239.95,
      "text": "IS FOR THESE EARTHLINGS DOWN"
    },
    {
      "s": 1239.95,
      "e": 1245.2,
      "text": "HERE TO SUPERVISE YOUR EVERY"
    },
    {
      "s": 1245.2,
      "e": 1246.29,
      "text": "WAKING MOMENT."
    },
    {
      "s": 1246.29,
      "e": 1247.95,
      "text": ">> YES, THEY DO A GREAT JOB OF"
    },
    {
      "s": 1247.95,
      "e": 1250.04,
      "text": "WATCHING OUR BACKS, AND IT'S A"
    },
    {
      "s": 1250.04,
      "e": 1252.75,
      "text": "GREAT TO BE A PART OF THE TEAM"
    },
    {
      "s": 1252.75,
      "e": 1253.84,
      "text": "DOWN THERE, AND IN FACT, WE"
    },
    {
      "s": 1253.84,
      "e": 1257.13,
      "text": "OFTEN HAVE A VIEW OF MISSION"
    },
    {
      "s": 1257.13,
      "e": 1258.92,
      "text": "CONTROL OURSELVES, SO, AGAIN,"
    },
    {
      "s": 1258.92,
      "e": 1262.59,
      "text": "WE'RE A VERY INNOVATIVE TEAM,"
    },
    {
      "s": 1262.59,
      "e": 1263.14,
      "text": "AND WE REALLY ENJOY THAT."
    },
    {
      "s": 1263.14,
      "e": 1266.31,
      "text": ">> WELL, THANK YOU SO MUCH."
    },
    {
      "s": 1266.31,
      "e": 1268.93,
      "text": "I -- I REALLY ADMIRE THE"
    },
    {
      "s": 1268.93,
      "e": 1271.31,
      "text": "COMPLEXITY OF YOUR MISSION, OF"
    },
    {
      "s": 1271.31,
      "e": 1271.98,
      "text": "YOUR TASKS."
    },
    {
      "s": 1271.98,
      "e": 1275.11,
      "text": "IT FAR EXCEEDS ANYTHING WE"
    },
    {
      "s": 1275.11,
      "e": 1278.78,
      "text": "FOOLED AROUND WITH IN A VERY"
    },
    {
      "s": 1278.78,
      "e": 1280.53,
      "text": "SIMPLIFIED THING CALLED APOLLO."
    },
    {
      "s": 1280.53,
      "e": 1282.07,
      "text": ">> YES, SIR, AND I REMEMBER WHEN"
    },
    {
      "s": 1282.07,
      "e": 1284.7,
      "text": "YOU SPOKE TO US A COUPLE OF"
    },
    {
      "s": 1284.7,
      "e": 1287.2,
      "text": "YEARS AGO, TALKING ABOUT"
    },
    {
      "s": 1287.2,
      "e": 1290.2,
      "text": "ASTRONAUTS BEING MASTERS OF"
    },
    {
      "s": 1290.2,
      "e": 1290.5,
      "text": "COMPLEXITY."
    },
    {
      "s": 1290.5,
      "e": 1291.66,
      "text": "TO ACKNOWLEDGE THIS WONDERFUL"
    },
    {
      "s": 1291.66,
      "e": 1293.75,
      "text": "MACHINE IS AN EXTREMELY COMPLEX"
    },
    {
      "s": 1293.75,
      "e": 1294.21,
      "text": "OPERATION."
    },
    {
      "s": 1294.21,
      "e": 1295.67,
      "text": "IT'S A BEAUTIFUL FEET OF"
    },
    {
      "s": 1295.67,
      "e": 1296.29,
      "text": "ENGINEERING, AND WHEN YOU LOOK"
    },
    {
      "s": 1296.29,
      "e": 1299.38,
      "text": "AT THE CONTROL ROOM, AND"
    },
    {
      "s": 1299.38,
      "e": 1300.01,
      "text": "EVERYBODY THAT'S BEHIND TO MAKE"
    },
    {
      "s": 1300.01,
      "e": 1303.22,
      "text": "THIS ALL WORK, IT IS INCREDIBLE,"
    },
    {
      "s": 1303.22,
      "e": 1304.97,
      "text": "JUST LIKE THAT -- MISSION"
