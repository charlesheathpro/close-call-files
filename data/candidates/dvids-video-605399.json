    {
      "s": 0.29,
      "e": 3.34,
      "text": "(gentle music)"
    },
    {
      "s": 3.34,
      "e": 4.49,
      "text": "- [Woman] Within the first two weeks"
    },
    {
      "s": 4.49,
      "e": 5.93,
      "text": "of this volcanic activity"
    },
    {
      "s": 5.93,
      "e": 7.78,
      "text": "we had members from all services."
    },
    {
      "s": 7.78,
      "e": 10.43,
      "text": "We had United States Marine Corps, United States Navy,"
    },
    {
      "s": 10.43,
      "e": 13.61,
      "text": "the active duty regular Army, and both our airmen,"
    },
    {
      "s": 13.61,
      "e": 16.64,
      "text": "and our Army soldiers from the Hawaii National Guard."
    },
    {
      "s": 18.36,
      "e": 21.46,
      "text": "Our mission was to support the Hilo Police Department."
    },
    {
      "s": 21.46,
      "e": 23.81,
      "text": "We have soldiers providing security."
    },
    {
      "s": 23.81,
      "e": 26.98,
      "text": "We also have roving patrols that rove the areas"
    },
    {
      "s": 26.98,
      "e": 29.38,
      "text": "that have been affected by the volcanic activity,"
    },
    {
      "s": 29.38,
      "e": 33.48,
      "text": "and our civil support team provided seaburning operations"
    },
    {
      "s": 33.48,
      "e": 38.41,
      "text": "by monitoring the areas affected by SO2 and H2S levels."
    }
