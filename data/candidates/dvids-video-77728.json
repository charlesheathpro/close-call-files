  "transcript": [
    {
      "s": 9.36,
      "e": 11.36,
      "text": "Griffin."
    },
    {
      "s": 11.36,
      "e": 13.36,
      "text": "Yeah."
    },
    {
      "s": 13.36,
      "e": 15.36,
      "text": "You know what I mean?"
    },
    {
      "s": 15.36,
      "e": 20.59,
      "text": "Hey, drive on the right."
    },
    {
      "s": 20.59,
      "e": 24.59,
      "text": "We got fly around, and they're on triad, they have their limited capability."
    },
    {
      "s": 24.59,
      "e": 28.59,
      "text": "They're not sure how far the infantry is running out."
    },
    {
      "s": 28.59,
      "e": 30.59,
      "text": "I think we got more power out there."
    },
    {
      "s": 30.59,
      "e": 32.59,
      "text": "So, apparently, they've got us a cruise ship to ride."
    },
    {
      "s": 32.59,
      "e": 47.26,
      "text": "We'll get them all."
    },
    {
      "s": 47.26,
      "e": 71.6,
      "text": "Get out."
    },
    {
      "s": 71.6,
      "e": 77.41,
      "text": "We're in."
    },
    {
      "s": 77.41,
      "e": 79.41,
      "text": "Uh, the back."
    },
    {
      "s": 79.41,
      "e": 162.81,
      "text": "Sounds like floor tile here. Take this sledgehammer, smack the floor tile out of the way, and get down to the concrete."
    },
    {
      "s": 162.81,
      "e": 167.88,
      "text": "Alright, give me a call out."
    },
    {
      "s": 167.88,
      "e": 180.06,
      "text": "I see right there. Listen up."
    },
    {
      "s": 180.06,
      "e": 185.06,
      "text": "Go ahead and have the hit."
    },
    {
      "s": 185.06,
      "e": 187.06,
      "text": "Again, Tom, get the top of the engine."
    },
    {
      "s": 187.06,
      "e": 202.74,
      "text": "I mean, floors can you access, Tom?"
    },
    {
      "s": 202.74,
      "e": 204.74,
      "text": "The only floor can really do is for tonight."
    },
    {
      "s": 204.74,
      "e": 207.74,
      "text": "This first section will come all the way out."
    },
    {
      "s": 207.74,
      "e": 209.74,
      "text": "I don't think it's close to you then."
    },
    {
      "s": 209.74,
      "e": 211.74,
      "text": "We'll be down here."
    }
  ],
