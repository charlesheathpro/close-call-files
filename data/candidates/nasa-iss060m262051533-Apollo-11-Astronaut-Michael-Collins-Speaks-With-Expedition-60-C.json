    },
    {
      "s": 1172.38,
      "e": 1174.51,
      "text": ">> HOUSTON, THIS IS STATION."
    },
    {
      "s": 1174.51,
      "e": 1176.8,
      "text": "WE ARE READY."
    },
    {
      "s": 1176.8,
      "e": 1182.97,
      "text": ">> OKAY, YOU GO, ISS."
    },
    {
      "s": 1182.97,
      "e": 1184.97,
      "text": ">> SIR, IT'S OUR PRIVILEGE TO"
    },
    {
      "s": 1184.97,
      "e": 1188.02,
      "text": "HAVE YOU ON BOARD TODAY."
    },
    {
      "s": 1188.02,
      "e": 1189.48,
      "text": "WELCOME TO THE INTERNATIONAL"
    },
    {
      "s": 1189.48,
      "e": 1190.69,
      "text": "SPACE STATION, AND"
    },
    {
      "s": 1190.69,
      "e": 1193.82,
      "text": "CONGRATULATIONS ON THE 50TH"
    },
    {
      "s": 1193.82,
      "e": 1196.44,
      "text": "ANNIVERSARY OF SPLASHDOWN APOLLO"
    },
    {
      "s": 1196.44,
      "e": 1196.61,
      "text": "11."
    },
    {
      "s": 1196.61,
      "e": 1196.94,
      "text": ">> THANK YOU."
    },
    {
      "s": 1196.94,
      "e": 1199.91,
      "text": "IT'S SO NICE TO BE HERE."
    },
    {
      "s": 1199.91,
      "e": 1201.66,
      "text": "IS IT GOING OKAY?"
    },
    {
      "s": 1201.66,
      "e": 1203.12,
      "text": "HAVE YOU ACCEPTED DREW INTO THE"
    },
    {
      "s": 1203.12,
      "e": 1204.08,
      "text": "CREW BY NOW?"
    },
    {
      "s": 1204.08,
      "e": 1205.49,
      "text": ">> YES, SIR, WITH GREAT HONOR"
    },
    {
      "s": 1205.49,
      "e": 1208.5,
      "text": "AND A LOT OF ANTICIPATION."
    },
    {
      "s": 1208.5,
      "e": 1210.58,
      "text": "WE ARE HAPPY TO HAVE WELCOMED"
    },
    {
      "s": 1210.58,
      "e": 1213.92,
      "text": "DREW AND LUCA ABOARD A FEW DAYS"
