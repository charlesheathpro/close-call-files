      "e": 91.02,
      "text": "[FALKOWSKI] NASA FireSense is a project"
    },
    {
      "s": 91.02,
      "e": 92.56,
      "text": "focused on developing"
    },
    {
      "s": 92.56,
      "e": 94.29,
      "text": "and delivering NASA technology,"
    },
    {
      "s": 94.29,
      "e": 96.1,
      "text": "including Earth observation data"
    },
    {
      "s": 96.1,
      "e": 96.76,
      "text": "and modeling"
    },
    {
      "s": 96.76,
      "e": 97.53,
      "text": "and science,"
    },
    {
      "s": 97.53,
      "e": 99.03,
      "text": "to, land managers"
    },
    {
      "s": 99.03,
      "e": 100.6,
      "text": "that manage wildland fire."
    },
    {
      "s": 100.6,
      "e": 101.1,
      "text": "[SHUMAN] This week"
