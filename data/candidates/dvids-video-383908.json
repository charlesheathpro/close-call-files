  "transcript": [
    {
      "s": 4.27,
      "e": 10.51,
      "text": "Well, I was worried because I called some, I make some calls on the airplane and nobody answered."
    },
    {
      "s": 11.71,
      "e": 15.43,
      "text": "I was just worried about that if anybody answered my calls."
    },
    {
      "s": 16.27,
      "e": 20.43,
      "text": "I swing maybe three miles with the lap jacket on."
    },
    {
      "s": 20.75,
      "e": 23.43,
      "text": "If they didn't have it, I couldn't survive, I swing me that long."
    },
    {
      "s": 25.74,
      "e": 28.22,
      "text": "I just want to say thank you for the Coast Guard to save me."
    },
    {
      "s": 28.66,
      "e": 31.5,
      "text": "I'm here right now because of them. They rescued me."
    },
    {
      "s": 32.06,
      "e": 39.98,
      "text": "The helicopter came straight to me and make a turn and they saw the end."
    },
    {
      "s": 39.98,
      "e": 40.98,
      "text": "I'm here now."
    }
