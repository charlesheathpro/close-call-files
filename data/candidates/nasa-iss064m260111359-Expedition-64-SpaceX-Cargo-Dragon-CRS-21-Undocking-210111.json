      "e": 2523.02,
      "text": "DRAGON 2 VEHICLE UPON DRAGON"
    },
    {
      "s": 2523.02,
      "e": 2523.99,
      "text": "DEPARTURE TODAY CURRENTLY"
    },
    {
      "s": 2523.99,
