    },
    {
      "s": 19.92,
      "e": 22.55,
      "text": "who lost their lives in the pursuit of exploration."
    },
    {
      "s": 22.55,
      "e": 24.52,
      "text": "Administrator Jared Isaacman"
    },
    {
      "s": 24.52,
      "e": 25.93,
      "text": "joined agency leadership"
    },
    {
      "s": 25.93,
      "e": 28.5,
      "text": "at a ceremony at  Arlington National Cemetery,"
    },
    {
      "s": 28.5,
      "e": 31.86,
      "text": "and laid wreaths at memorials honoring the crews of Apollo 1"
    },
    {
      "s": 31.86,
      "e": 34.83,
      "text": "and the space shuttles Challenger and Columbia."
    },
    {
      "s": 34.83,
      "e": 37.34,
      "text": "We remember these members of the NASA family"
    },
    {
      "s": 37.34,
      "e": 40.34,
      "text": "not only for how they served, but for what they made possible."
    },
    {
      "s": 41.17,
      "e": 44.38,
      "text": "Their legacy lives on in how  NASA approaches exploration:"
    },
    {
      "s": 44.38,
      "e": 47.21,
      "text": "learning from the past,  managing risk with care,"
    },
    {
      "s": 47.21,
      "e": 49.18,
      "text": "and continuing onward  with purpose."
    },
    {
      "s": 50.82,
      "e": 52.32,
      "text": "On Saturday, the Artemis II"
    },
    {
      "s": 52.32,
      "e": 55.29,
      "text": "Space Launch System rocket  and Orion spacecraft"
    },
    {
      "s": 55.29,
      "e": 57.39,
      "text": "rolled to Launch Complex 39B"
    },
    {
      "s": 57.39,
      "e": 59.23,
      "text": "at Kennedy Space Center in Florida"
    },
    {
      "s": 59.23,
      "e": 61.93,
      "text": "ahead of the upcoming  mission around the Moon."
    },
    {
      "s": 61.93,
      "e": 63.23,
      "text": "The approximately"
    },
    {
      "s": 63.23,
      "e": 65.53,
      "text": "4-mile journey took nearly 12 hours,"
    },
    {
      "s": 65.53,
      "e": 67.03,
      "text": "as engineers moved the rocket"
    },
    {
      "s": 67.03,
      "e": 68.6,
      "text": "from the Vehicle Assembly Building"
    },
    {
      "s": 68.6,
      "e": 70.17,
      "text": "out to the launchpad."
    },
    {
      "s": 70.17,
      "e": 71.6,
      "text": "Since then, the team has been"
    },
    {
      "s": 71.6,
      "e": 73.34,
      "text": "configuring the rocket  and spacecraft"
    },
    {
      "s": 73.34,
      "e": 75.44,
      "text": "for an upcoming  wet dress rehearsal,"
    },
    {
      "s": 75.44,
      "e": 77.11,
      "text": "enabling communication lines,"
    },
    {
      "s": 77.11,
      "e": 78.31,
      "text": "configuring hardware,"
    },
    {
      "s": 78.31,
      "e": 81.08,
      "text": "and setting up the  emergency egress system."
    },
    {
      "s": 81.08,
      "e": 82.52,
      "text": "Once SLS and Orion"
    },
    {
      "s": 82.52,
