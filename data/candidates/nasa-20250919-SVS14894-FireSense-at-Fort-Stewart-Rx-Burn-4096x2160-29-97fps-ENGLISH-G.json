    {
      "s": 212.08,
      "e": 212.81,
      "text": "and ensuring"
    },
    {
      "s": 212.81,
      "e": 213.68,
      "text": "that everything is going to meet"
    },
    {
      "s": 213.68,
      "e": 215.55,
      "text": "those prescription parameters,"
