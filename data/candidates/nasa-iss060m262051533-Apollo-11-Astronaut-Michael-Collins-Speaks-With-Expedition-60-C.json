    },
    {
      "s": 1453.08,
      "e": 1455.37,
      "text": "GET INTO SPACE PROGRAM, I -- I"
    },
    {
      "s": 1455.37,
      "e": 1456.79,
      "text": "WAS STILL DREAMING ABOUT THE"
    },
    {
      "s": 1456.79,
      "e": 1459.46,
      "text": "MOON AND -- AND YOUR MISSION,"
    },
    {
      "s": 1459.46,
      "e": 1463.13,
