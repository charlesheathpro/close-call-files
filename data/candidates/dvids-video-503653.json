  "transcript_source": "captions",
  "transcript": [
    {
      "s": 5.55,
      "e": 7.14,
      "text": "(suspenseful music)"
    },
    {
      "s": 7.14,
      "e": 9.42,
      "text": "- [Woman] In days long past,"
    },
    {
      "s": 9.42,
      "e": 12.77,
      "text": "the hero Bellerophon rose high into the clouds"
    },
    {
      "s": 12.77,
      "e": 15.7,
      "text": "from the back of mighty Pegasus,"
    },
    {
      "s": 15.7,
      "e": 18.55,
      "text": "winged stallion of the Gods,"
    },
    {
      "s": 18.55,
      "e": 21.98,
      "text": "carrying lightening and thunder from Mount Olympus."
    },
    {
      "s": 21.98,
      "e": 24.98,
      "text": "Pegasus destroyed his enemies"
    },
    {
      "s": 24.98,
      "e": 29.46,
      "text": "and with a torrent of wind from his mighty wings,"
    },
    {
      "s": 29.46,
      "e": 32.55,
      "text": "carried heroes away to the sky."
    },
    {
      "s": 32.55,
      "e": 35.3,
      "text": "(mystical music)"
    },
    {
      "s": 38.85,
      "e": 42.18,
      "text": "(upbeat powerful music)"
    },
    {
      "s": 45.2,
      "e": 47.84,
      "text": "- [Man] The global mission of the United States Air force"
    },
    {
      "s": 47.84,
      "e": 50.93,
      "text": "requires the ability to recover personnel"
    },
    {
      "s": 50.93,
      "e": 52.43,
      "text": "anywhere, anytime."
    },
    {
      "s": 53.63,
      "e": 55.8,
      "text": "The men and women of the Air Force Reserve"
    },
    {
      "s": 55.8,
      "e": 58.55,
      "text": "serving at the 943rd Rescue Group"
    },
    {
      "s": 58.55,
      "e": 60.22,
      "text": "are some of the most elite"
    },
    {
      "s": 60.22,
      "e": 64.37,
      "text": "special operation warriors in the U.S. Military."
    },
    {
      "s": 64.37,
      "e": 69.37,
      "text": "(choir singing) (upbeat powerful music)"
    },
    {
      "s": 70.2,
      "e": 72.07,
      "text": "Pilots and flight engineers operate"
    },
    {
      "s": 72.07,
      "e": 74.81,
      "text": "side by side with pararescue jumpers,"
    },
    {
      "s": 74.81,
      "e": 77.62,
      "text": "SERE specialists, and combat rescue officers"
    },
    {
      "s": 77.62,
      "e": 80.69,
      "text": "who form a specialized human weapon system"
    },
    {
      "s": 80.69,
      "e": 82.8,
      "text": "known as Guardian Angel,"
    },
    {
      "s": 82.8,
      "e": 86.44,
      "text": "a unique capability to ensure the recovery of personnel."
    },
    {
      "s": 86.44,
      "e": 88.14,
      "text": "The 943rd Rescue Group at"
    },
    {
      "s": 88.14,
      "e": 90.93,
      "text": "Davis-Monthan Air Force Base in Arizona,"
    },
    {
      "s": 90.93,
      "e": 94.54,
      "text": "which includes the 304th rescue squadron in Oregon,"
    },
    {
      "s": 94.54,
      "e": 98.24,
      "text": "operates AK-60 Pave Hawk helicopters,"
    },
    {
      "s": 98.24,
      "e": 100.41,
      "text": "and other highly modified vehicles"
    },
    {
      "s": 100.41,
      "e": 104.28,
      "text": "to perform combat rescue missions in any environment."
    },
    {
      "s": 104.28,
      "e": 107.27,
      "text": "(guitar soloing)"
    },
    {
      "s": 107.27,
      "e": 108.94,
      "text": "We've supported efforts throughout"
    },
    {
      "s": 108.94,
      "e": 110.88,
      "text": "the Middle East and Africa."
    },
    {
      "s": 110.88,
      "e": 113.02,
      "text": "We made a US homeland defense"
    },
    {
      "s": 113.02,
      "e": 117.12,
      "text": "and assisted domestic rescue efforts, as needed."
    },
    {
      "s": 117.12,
      "e": 120.28,
      "text": "Our doctors and combat medics train and specialize"
    },
    {
      "s": 120.28,
      "e": 123.31,
      "text": "in the most advance life saving techniques."
    },
    {
      "s": 123.31,
      "e": 125.01,
      "text": "While our state of the art communications"
    },
    {
      "s": 125.01,
      "e": 129.84,
      "text": "and intelligence capabilities ensure mission success."
    },
    {
      "s": 129.84,
      "e": 131.62,
      "text": "The Personnel Support Specialists"
    },
    {
      "s": 131.62,
      "e": 134.27,
      "text": "and facilities at the 943rd"
    },
    {
      "s": 134.27,
      "e": 137.17,
      "text": "provide the best care and assistance available,"
    },
    {
      "s": 137.17,
      "e": 139.07,
      "text": "allowing these skilled specialists"
    },
    {
      "s": 139.07,
      "e": 143.26,
      "text": "to focus on constant training and mission preparedness."
    },
    {
      "s": 143.26,
      "e": 145.46,
      "text": "Our Citizen Airmen balance the demands of"
    },
    {
      "s": 145.46,
      "e": 147.41,
      "text": "civilian and military life"
    },
    {
      "s": 147.41,
      "e": 149.95,
      "text": "to perform one of the most advanced capabilities"
    },
    {
      "s": 149.95,
      "e": 151.13,
      "text": "in the Air Force."
    },
    {
      "s": 151.13,
      "e": 153.16,
      "text": "Together, with our parent unit,"
    },
    {
      "s": 153.16,
      "e": 156.98,
      "text": "the 920th rescue wing at Patrick Air Force Base, Florida,"
    },
    {
      "s": 156.98,
      "e": 159.46,
      "text": "we've saved more than 3,000 lives,"
    },
    {
      "s": 159.46,
      "e": 161.88,
      "text": "including 1,200 combat saves."
    },
    {
      "s": 163.99,
      "e": 167.91,
      "text": "Our great winged mascot inspires our mission"
    },
    {
      "s": 167.91,
      "e": 171.16,
      "text": "to defeat our enemies, reach out to our nations heroes,"
    },
    {
      "s": 171.16,
      "e": 172.77,
      "text": "and lift them to safety."
    },
    {
      "s": 172.77,
      "e": 175.36,
      "text": "(ending music)"
    }
  ],
