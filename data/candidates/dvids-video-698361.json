    },
    {
      "s": 5.65,
      "e": 6.8,
      "text": "At the Egress shop,"
    },
    {
      "s": 6.8,
      "e": 8.15,
      "text": "we pull the seats out,"
    },
    {
      "s": 9.29,
      "e": 10.48,
      "text": "take the seats apart,"
    },
    {
      "s": 11.47,
      "e": 13.07,
      "text": "(upbeat music)"
    },
    {
      "s": 13.07,
      "e": 15.38,
      "text": "and make any repairs that are needed."
