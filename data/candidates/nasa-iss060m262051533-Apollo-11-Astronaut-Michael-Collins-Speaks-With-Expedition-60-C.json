      "e": 1361.15,
      "text": "THE APOLLO PROGRAM AND YOU, YOU"
    },
    {
      "s": 1361.15,
      "e": 1363.03,
      "text": "KNOW, IN PARTICULAR -- THE"
    },
    {
      "s": 1363.03,
      "e": 1364.86,
      "text": "LEGACY THAT YOU HAVE PROVIDED"
    },
    {
      "s": 1364.86,
      "e": 1366.66,
      "text": "US, AND KEEP US MOTIVATED."
    },
    {
      "s": 1366.66,
      "e": 1367.2,
      "text": "YOU MAY NOT -- YOU MAY NOT"
    },
    {
      "s": 1367.2,
      "e": 1369.16,
      "text": "REMEMBER -- BECAUSE IT"
