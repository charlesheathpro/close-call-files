    {
      "s": 1467.3,
      "e": 1469.34,
      "text": "IN OTHER STATES, BUT REALLY ALL"
    },
    {
      "s": 1469.34,
      "e": 1470.05,
      "text": "OVER THE WORLD."
    },
    {
      "s": 1470.05,
      "e": 1471.97,
      "text": ">> WELL, THANK YOU VERY MUCH,"
    },
    {
      "s": 1471.97,
      "e": 1475.1,
      "text": "AND OVER YOUR CAREER, 30-SOME"
    },
    {
      "s": 1475.1,
      "e": 1477.14,
      "text": "YEARS, YOU HAVE REALLY SEEN IT"
    },
    {
      "s": 1477.14,
      "e": 1478.43,
      "text": "ALL CHANGE, HAVEN'T YOU?"
    },
    {
      "s": 1478.43,
      "e": 1480.81,
      "text": "I MEAN, IT'S GETTING MORE AND"
    },
    {
      "s": 1480.81,
      "e": 1482.69,
      "text": "MORE COMPLEX, MORE AND MORE"
    },
    {
      "s": 1482.69,
      "e": 1484.27,
      "text": "IMPORTANT, I WOULD SAY, THE WORK"
    },
    {
      "s": 1484.27,
      "e": 1485.28,
      "text": "THAT YOU ARE DOING UP THERE."
    },
    {
      "s": 1485.28,
      "e": 1487.99,
      "text": "SO BLESS YOU ALL, AND HAVE A"
    },
    {
      "s": 1487.99,
      "e": 1489.28,
      "text": "GREAT REMAINDER OF YOUR TOUR."
    },
    {
      "s": 1489.28,
      "e": 1492.62,
      "text": ">> SIR, THANK YOU SO VERY MUCH."
    },
    {
      "s": 1492.62,
      "e": 1494.83,
      "text": "IT'S AN HONOR TO HAVE YOU ON"
    },
