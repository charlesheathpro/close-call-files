      "text": "[ MUSIC ]"
    },
    {
      "s": 12.64,
      "e": 13.75,
      "text": ">> UH, \"STAR WARS.\""
    },
    {
      "s": 13.75,
      "e": 14.68,
      "text": ">> STANLEY KUBRICK'S"
    },
    {
      "s": 14.68,
      "e": 16.48,
      "text": "\"2001: A SPACE ODYSSEY.\""
    },
    {
      "s": 16.48,
      "e": 17.85,
      "text": ">> PROBABLY \"LIFE IS BEAUTIFUL\""
    },
    {
      "s": 17.85,
      "e": 19.12,
      "text": "OR \"AMELIE.\""
    },
    {
      "s": 19.12,
      "e": 20.85,
      "text": ">> \"MASTER AND COMMANDER.\""
    },
    {
      "s": 20.85,
      "e": 23.12,
      "text": ">> OH, DEPENDS ON THE ERA"
    },
    {
      "s": 23.12,
      "e": 24.29,
      "text": "OF MY LIFE."
    },
    {
      "s": 24.29,
      "e": 25.02,
      "text": "I'D PROBABLY SAY"
    },
    {
      "s": 25.02,
      "e": 26.96,
      "text": "\"DUNE\" THOUGH OVERALL."
    },
    {
      "s": 26.96,
      "e": 27.86,
      "text": ">> DANIEL BOORSTIN'S"
    },
    {
      "s": 27.86,
      "e": 29.23,
      "text": "\"THE DISCOVERERS.\""
    },
    {
      "s": 29.23,
      "e": 30.0,
      "text": ">> \"PERFUME.\""
    },
    {
      "s": 30.0,
      "e": 31.1,
      "text": ">> THE RICK ATKINSON"
    },
    {
      "s": 31.1,
      "e": 32.73,
      "text": "\"ARMY AT DAWN\" SERIES."
    },
    {
      "s": 32.73,
      "e": 35.03,
      "text": ">> UH, JUST RELAXING."
    },
    {
      "s": 35.03,
      "e": 36.0,
      "text": ">> PLAYING WITH MY KIDS."
    },
    {
      "s": 36.0,
      "e": 37.17,
      "text": ">> BACKPACKING."
    },
    {
      "s": 37.17,
      "e": 37.94,
      "text": ">> BACKPACKING."
    },
    {
      "s": 37.94,
      "e": 39.3,
      "text": ">> THAT WOULD BE"
    },
    {
      "s": 39.3,
      "e": 41.54,
      "text": "PROBABLY PEANUT BUTTER."
    },
    {
      "s": 41.54,
      "e": 42.61,
      "text": ">> PIZZA."
    },
    {
      "s": 42.61,
      "e": 43.74,
      "text": ">> THAT'S A HARD ONE."
    },
    {
      "s": 43.74,
      "e": 46.38,
      "text": "I LIKE ALMOST ALL FOOD."
    },
    {
      "s": 46.38,
      "e": 47.65,
      "text": ">> FALL."
    },
    {
      "s": 47.65,
      "e": 48.48,
      "text": ">> FALL."
    },
    {
      "s": 48.48,
      "e": 49.18,
      "text": ">> FALL."
    },
    {
      "s": 49.18,
      "e": 51.08,
      "text": ">> FRENCH HORN."
    },
    {
      "s": 51.08,
      "e": 51.98,
      "text": ">> ACOUSTIC GUITAR."
    },
    {
      "s": 51.98,
      "e": 52.82,
      "text": "THAT WAS EASY."
    },
    {
      "s": 52.82,
      "e": 54.82,
      "text": ">> GUITAR, BUT I HAVE"
    },
    {
      "s": 54.82,
      "e": 55.82,
      "text": "LACK OF TALENT."
    },
    {
      "s": 55.82,
      "e": 56.76,
      "text": "I PRACTICE A LOT"
    },
    {
      "s": 56.76,
      "e": 58.22,
      "text": "BUT FAIL."
    },
    {
      "s": 58.22,
      "e": 60.03,
      "text": ">> PESTO."
    },
    {
      "s": 60.03,
      "e": 61.43,
      "text": ">> I THINK IF I HAVE A CHOICE,"
    },
    {
      "s": 61.43,
      "e": 62.59,
      "text": "I LIKE PIZZA NAPOLI."
    },
    {
      "s": 62.59,
      "e": 64.2,
      "text": ">> TOMATO AND PEPPERONI."
    },
    {
      "s": 64.2,
      "e": 65.77,
      "text": ">> I LIKE SPICY ITALIAN SAUSAGE."
    },
    {
      "s": 65.77,
      "e": 68.23,
      "text": ">> SWIMMING, WATER POLO,"
    },
    {
      "s": 68.23,
      "e": 69.2,
      "text": "ANYTHING IN THE WATER."
    },
    {
      "s": 69.2,
      "e": 70.4,
      "text": ">> I'M BAD AT MANY OF THEM."
    },
    {
      "s": 70.4,
      "e": 71.37,
      "text": "PROBABLY, UH, KICKBALL"
    },
    {
      "s": 71.37,
      "e": 72.07,
      "text": "WITH MY KIDS."
    },
    {
      "s": 72.07,
      "e": 73.01,
      "text": ">> WELL, IT'S FOOTBALL,"
    },
    {
      "s": 73.01,
      "e": 74.27,
      "text": "EUROPEAN FOOTBALL,"
    },
    {
      "s": 74.27,
      "e": 75.88,
      "text": "OR CYCLING, SWIMMING."
    },
    {
      "s": 75.88,
      "e": 77.04,
      "text": ">> TRACK."
    },
    {
      "s": 77.04,
      "e": 78.78,
      "text": ">> COFFEE."
    },
    {
      "s": 78.78,
      "e": 79.45,
      "text": ">> TEA."
    },
    {
      "s": 79.45,
      "e": 80.31,
      "text": ">> DEFINITELY COFFEE."
    },
    {
      "s": 80.31,
      "e": 80.98,
      "text": ">> BOTH."
    },
    {
      "s": 80.98,
      "e": 84.05,
      "text": ">> DANCING."
    },
    {
      "s": 84.05,
      "e": 85.02,
      "text": ">> SINGING."
    },
    {
      "s": 85.02,
      "e": 86.29,
      "text": ">> I THINK I'M REALLY BAD"
    },
    {
      "s": 86.29,
      "e": 87.19,
      "text": "IN DANCING."
    },
    {
      "s": 87.19,
      "e": 89.06,
      "text": ">> OOH, I HAVE TWO ANSWERS"
    },
    {
      "s": 89.06,
      "e": 89.76,
      "text": "FOR THIS."
    },
    {
      "s": 89.76,
      "e": 91.72,
      "text": "PROBABLY LEARNING RUSSIAN--"
    },
    {
      "s": 91.72,
      "e": 93.13,
      "text": "CHALLENGING FOR ME."
    },
    {
      "s": 93.13,
      "e": 93.99,
      "text": "AND DEFINITELY"
    },
    {
      "s": 93.99,
      "e": 95.56,
      "text": "SPACEWALK TRAINING."
    },
    {
      "s": 95.56,
      "e": 97.3,
      "text": ">> NBL, OR SPACEWALK TRAINING."
    },
    {
      "s": 97.3,
      "e": 98.16,
      "text": ">> SPEAKING RUSSIAN"
    },
    {
      "s": 98.16,
      "e": 100.0,
      "text": "WHILE IN SPACE SUIT UNDERWATER."
    },
    {
      "s": 100.0,
      "e": 101.53,
      "text": ">> OH, WAITING FOR THE MISSION."
    },
    {
      "s": 101.53,
      "e": 103.97,
      "text": ">> OH, DEFINITELY LOOK AT ROCKS"
    },
    {
      "s": 103.97,
      "e": 105.07,
      "text": "WITH JESSICA WATKINS."
    },
    {
      "s": 105.07,
      "e": 106.54,
      "text": ">> GO ON A BIKE RIDE."
    },
    {
      "s": 106.54,
      "e": 109.24,
      "text": ">> I WOULD BE SKIPPING, RUNNING,"
    },
    {
      "s": 109.24,
      "e": 110.68,
      "text": "AND CLIMB IN ANY CRATER"
    },
    {
      "s": 110.68,
      "e": 111.61,
      "text": "I COULD FIND."
    },
    {
      "s": 111.61,
      "e": 112.61,
      "text": ">> WELL, FIRST I WOULD LIKE"
    },
    {
      "s": 112.61,
      "e": 113.71,
      "text": "TO JUMP AS HIGH AS I CAN"
    },
    {
      "s": 113.71,
      "e": 115.35,
      "text": "TO PROVE THAT I CAN JUMP"
    },
    {
      "s": 115.35,
      "e": 116.28,
      "text": "SIX TIMES AS HIGH"
    },
    {
      "s": 116.28,
      "e": 117.38,
      "text": "AS ON THE EARTH,"
    },
    {
      "s": 117.38,
      "e": 118.85,
      "text": "AND SECOND THING I WOULD DO"
    },
    {
      "s": 118.85,
      "e": 120.32,
      "text": "IS I WOULD TRY AND EXPLORE"
    },
    {
      "s": 120.32,
      "e": 121.12,
      "text": "A MOON CAVE."
    },
    {
      "s": 121.12,
      "e": 123.12,
      "text": ">> TO BE ABLE TO FLY."
    },
    {
      "s": 123.12,
      "e": 125.26,
      "text": ">> TO PACIFY THE WORLD."
    },
    {
      "s": 125.26,
      "e": 126.46,
      "text": ">> TO TIME TRAVEL."
    },
    {
      "s": 126.46,
      "e": 128.06,
      "text": ">> FRAPPUCCINO."
    },
    {
      "s": 128.06,
      "e": 129.5,
      "text": ">> EATING ICE CREAM--"
    },
    {
      "s": 129.5,
      "e": 130.4,
      "text": "WAY TOO MANY."
    },
    {
      "s": 130.4,
      "e": 131.46,
      "text": ">> COOKIE CAKE."
    },
    {
      "s": 131.46,
      "e": 133.87,
      "text": ">> UM, I WOULD SAY,"
    },
    {
      "s": 133.87,
      "e": 136.13,
      "text": "NEVER CLOSE A DOOR ON YOURSELF."
    },
    {
      "s": 136.13,
      "e": 137.1,
      "text": "LIKE, DON'T SELF-SELECT"
    },
    {
      "s": 137.1,
      "e": 138.54,
      "text": "OUT OF OPPORTUNITIES."
    },
    {
      "s": 138.54,
      "e": 139.2,
      "text": "LIKE, YOU HAVE TO"
    },
    {
      "s": 139.2,
      "e": 140.01,
      "text": "PUT YOURSELF OUT THERE"
    },
    {
      "s": 140.01,
      "e": 141.97,
      "text": "IF YOU WANNA PURSUE YOUR DREAMS."
    },
    {
      "s": 141.97,
      "e": 143.71,
      "text": ">> KEEP, UH, KEEP AT IT."
    },
    {
      "s": 143.71,
      "e": 144.98,
      "text": "STAY PERSISTENT."
    },
    {
      "s": 144.98,
      "e": 146.01,
      "text": "DON'T WORRY ABOUT IT."
    },
    {
      "s": 146.01,
      "e": 146.81,
      "text": "IT'S GONNA BE OKAY."
    },
    {
      "s": 146.81,
      "e": 147.68,
      "text": ">> JUST RELAX"
    },
    {
      "s": 147.68,
      "e": 148.78,
      "text": "AND ENJOY THE MOMENT A BIT."
    },
    {
      "s": 148.78,
      "e": 150.08,
      "text": ">> I'D LIKE TO DO"
    },
    {
      "s": 150.08,
      "e": 151.02,
      "text": "ANOTHER SPACEWALK."
    },
    {
      "s": 151.02,
      "e": 152.09,
      "text": ">> I'D LOVE TO DO A SPACEWALK."
    },
    {
      "s": 152.09,
      "e": 153.25,
      "text": ">> DOING A SPACEWALK."
    },
    {
      "s": 153.25,
      "e": 154.15,
      "text": ">> WELL, FLYING TO SPACE,"
    },
    {
      "s": 154.15,
      "e": 155.05,
      "text": "THE FIRST."
    },
    {
      "s": 155.05,
      "e": 156.22,
      "text": "DOING AN EVA IS THE SECOND,"
    },
    {
      "s": 156.22,
      "e": 157.76,
      "text": "AND HOPEFULLY, WALKING"
    },
    {
      "s": 157.76,
      "e": 159.06,
      "text": "ON THE MOON IS THE THIRD."
    },
    {
      "s": 159.06,
      "e": 162.13,
      "text": ">> I WON'T GO INTO SPECIFICS,"
    },
    {
      "s": 162.13,
      "e": 163.0,
      "text": "BUT IT ALL HAS TO DO"
    },
    {
      "s": 163.0,
      "e": 163.93,
      "text": "WITH USING THE BATHROOM."
    }
