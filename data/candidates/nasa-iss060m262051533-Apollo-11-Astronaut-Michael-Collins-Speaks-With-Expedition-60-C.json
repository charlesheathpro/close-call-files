    {
      "s": 1373.0,
      "e": 1376.12,
      "text": "WAS A LITTLE SURPRISE THAT CAME"
    },
    {
      "s": 1376.12,
      "e": 1377.04,
      "text": "UP WITH LUCA AND DREW."
