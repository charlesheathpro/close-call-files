    {
      "s": 195.09,
      "e": 196.7,
      "text": "FOR A SPACE MISSION IS-IS"
    },
    {
      "s": 196.7,
      "e": 197.76,
      "text": "VERY MUCH THE SAME."
    },
    {
      "s": 197.76,
      "e": 198.53,
      "text": "YOU KNOW, I'M TRYING TO THINK"
    },
    {
      "s": 198.53,
      "e": 199.43,
      "text": "OF ALL THE THINGS"
    },
    {
      "s": 199.43,
      "e": 201.47,
      "text": "THAT, UH, COULD, UH--"
    },
    {
      "s": 201.47,
      "e": 202.27,
      "text": "I WON'T NECESSARILY SAY"
    },
    {
      "s": 202.27,
      "e": 204.14,
      "text": "GO WRONG, BUT COULD MAKE"
    },
    {
      "s": 204.14,
      "e": 205.1,
      "text": "THE OPERATION WE HAVE"
    },
    {
      "s": 205.1,
      "e": 207.17,
      "text": "IN FRONT OF US, UH, COMPLICATED."
    },
    {
      "s": 207.17,
      "e": 208.07,
      "text": "AND THAT YOU'D WANT TO HAVE"
