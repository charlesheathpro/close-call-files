      "text": ">> BROADCAST STARTED."
    },
    {
      "s": 1.67,
      "e": 2.97,
      "text": ">> ROGER."
    },
    {
      "s": 8.71,
      "e": 9.48,
      "text": ">> WHAT'S YOUR FAVORITE MOVIE?"
    },
    {
      "s": 9.48,
      "e": 10.21,
      "text": ">> BAND OF BROTHERS."
    },
    {
      "s": 10.21,
      "e": 10.84,
      "text": ">> YOUR FAVORITE FOOD?"
    },
    {
      "s": 10.84,
      "e": 11.61,
      "text": ">> ANYTHING SPICY."
    },
    {
      "s": 11.61,
      "e": 12.35,
      "text": ">> FAVORITE COLOR?"
    },
    {
      "s": 12.35,
      "e": 13.11,
      "text": ">> ALL OF DRAB."
    },
    {
      "s": 13.11,
      "e": 13.95,
      "text": ">> ARE YOU A MORNING PERSON"
    },
    {
      "s": 13.95,
      "e": 14.71,
      "text": "OR A NIGHT PERSON?"
    },
    {
      "s": 14.71,
      "e": 15.78,
      "text": ">> DEFINITELY A MORNING PERSON."
    },
    {
      "s": 15.78,
      "e": 16.82,
      "text": "I'M NOT DEMONSTRATING THAT"
    },
    {
      "s": 16.82,
      "e": 17.88,
      "text": "VERY WELL NOW, BUT YES,"
    },
    {
      "s": 17.88,
      "e": 18.72,
      "text": "I AM A MORNING PERSON."
    },
    {
      "s": 18.72,
      "e": 19.22,
      "text": ">> WHAT'S YOUR FAVORITE"
    },
    {
      "s": 19.22,
      "e": 20.02,
      "text": "ICE CREAM FLAVOR?"
    },
    {
      "s": 20.02,
      "e": 20.79,
      "text": ">> MINT CHOCOLATE CHIP."
    },
    {
      "s": 20.79,
      "e": 21.75,
      "text": ">> IS THERE ONE THING YOU HAVE"
    },
    {
      "s": 21.75,
      "e": 22.99,
      "text": "IN YOUR FRIDGE ALL THE TIME?"
    },
    {
      "s": 22.99,
      "e": 23.66,
      "text": ">> MILK."
    },
    {
      "s": 23.66,
      "e": 24.52,
      "text": ">> WHAT ACCOMPLISHMENT"
    },
    {
      "s": 24.52,
      "e": 25.59,
      "text": "ARE YOU MOST PROUD OF?"
    },
    {
      "s": 25.59,
      "e": 26.39,
      "text": ">> MY KIDS."
    },
    {
      "s": 26.39,
      "e": 27.43,
      "text": ">> WHO'S THE PERSON"
    },
    {
      "s": 27.43,
      "e": 28.86,
      "text": "THAT MAKES YOU LAUGH THE MOST?"
    },
    {
      "s": 28.86,
      "e": 29.86,
      "text": ">> MY WIFE."
    },
    {
      "s": 29.86,
      "e": 30.4,
      "text": ">> WHAT'S YOUR MOST"
    },
    {
      "s": 30.4,
      "e": 31.86,
      "text": "MEMORABLE CAREER MOMENT?"
    },
    {
      "s": 31.86,
      "e": 32.9,
      "text": ">> GRADUATING FROM, UH,"
    },
    {
      "s": 32.9,
      "e": 33.7,
      "text": "RANGER SCHOOL AND BEING"
    },
    {
      "s": 33.7,
      "e": 34.47,
      "text": "PROMOTED TO MAJOR"
    },
    {
      "s": 34.47,
      "e": 35.44,
      "text": "ON THE SAME DAY."
    },
    {
      "s": 35.44,
      "e": 36.0,
      "text": ">> IF YOU COULD HAVE"
    },
    {
      "s": 36.0,
      "e": 37.3,
      "text": "ONE SUPERPOWER ONLY,"
    },
    {
      "s": 37.3,
      "e": 38.44,
      "text": "WHAT WOULD IT BE?"
    },
    {
      "s": 38.44,
      "e": 40.27,
      "text": ">> TIME TRAVEL."
    },
    {
      "s": 40.27,
      "e": 40.87,
      "text": ">> WHAT'S YOUR FAVORITE"
    },
    {
      "s": 40.87,
      "e": 41.71,
      "text": "PIZZA TOPPING?"
    },
    {
      "s": 41.71,
      "e": 42.81,
      "text": ">> LOTS AND LOTS OF CHEESE."
    },
    {
      "s": 42.81,
      "e": 43.74,
      "text": ">> YOUR FAVORITE ANIMAL?"
    },
    {
      "s": 43.74,
      "e": 44.41,
      "text": ">> ARMADILLO."
    },
    {
      "s": 44.41,
      "e": 45.34,
      "text": ">> FAVORITE DANCE MOVE?"
    },
    {
      "s": 45.34,
      "e": 46.08,
      "text": ">> AIR GUITAR."
    },
    {
      "s": 46.08,
      "e": 47.28,
      "text": ">> WHO INSPIRES YOU?"
    },
    {
      "s": 47.28,
      "e": 48.05,
      "text": ">> MY DAD."
    },
    {
      "s": 48.05,
      "e": 48.72,
      "text": ">> WHAT WOULD YOU LIKE"
    },
    {
      "s": 48.72,
      "e": 49.98,
      "text": "TO BE REMEMBERED FOR?"
    },
    {
      "s": 49.98,
      "e": 51.32,
      "text": ">> BEING A GOOD HUSBAND"
    },
    {
      "s": 51.32,
      "e": 52.02,
      "text": "AND FATHER."
    },
    {
      "s": 52.02,
      "e": 52.82,
      "text": ">> WHAT ADVICE WOULD"
    },
    {
      "s": 52.82,
      "e": 54.29,
      "text": "YOU GIVE TO YOUR YOUNGER SELF?"
    },
    {
      "s": 54.29,
      "e": 55.26,
      "text": ">> BE A GOOD TEAM PLAYER."
    },
    {
      "s": 55.26,
      "e": 55.95,
      "text": ">> WHAT WOULD BE A GOOD"
    },
    {
      "s": 55.95,
      "e": 57.52,
      "text": "THEME SONG FOR YOUR LIFE?"
    },
    {
      "s": 57.52,
      "e": 57.96,
      "text": ">> \"LIVE IT WELL\""
    },
    {
      "s": 57.96,
      "e": 58.83,
      "text": "BY SWITCHFOOT."
    },
    {
      "s": 58.83,
      "e": 59.43,
      "text": ">> IF YOU COULD SPEND"
    },
    {
      "s": 59.43,
      "e": 61.03,
