  "transcript": [
    {
      "s": 15.21,
      "e": 18.18,
      "text": "Ingenuity Takes Flight"
    },
    {
      "s": 18.75,
      "e": 19.79,
      "text": "APRIL 19, 2021"
    },
    {
      "s": 19.79,
      "e": 21.22,
      "text": "Earlier today, Ingenuity should"
    },
    {
      "s": 21.22,
      "e": 22.49,
      "text": "have autonomously performed its"
    },
    {
      "s": 22.49,
      "e": 25.46,
      "text": "first flight attempt on Mars."
    },
    {
      "s": 25.46,
      "e": 26.83,
      "text": "Now, the team is ready"
    },
    {
      "s": 26.83,
      "e": 28.19,
      "text": "to receive the data that will"
    },
    {
      "s": 28.19,
      "e": 29.13,
      "text": "tell them whether we’ve"
    },
    {
      "s": 29.13,
      "e": 30.4,
      "text": "made history."
    },
    {
      "s": 30.96,
      "e": 32.23,
      "text": "This is downlink.  We are"
    },
    {
      "s": 32.23,
      "e": 34.3,
      "text": "beginning to see data products."
    },
    {
      "s": 34.3,
      "e": 36.1,
      "text": "Rotor motors appear healthy"
    },
    {
      "s": 36.1,
      "e": 37.7,
      "text": "all actuators appear healthy."
    },
    {
      "s": 37.7,
      "e": 39.51,
      "text": "Ingenuity is reporting having"
    },
    {
      "s": 39.51,
      "e": 41.27,
      "text": "performed spin up, take off,"
    },
    {
      "s": 41.31,
      "e": 44.44,
      "text": "climb, hover, descent, landing,"
    },
    {
      "s": 44.44,
      "e": 47.41,
      "text": "touchdown and spin down."
    },
    {
      "s": 47.41,
      "e": 50.08,
      "text": "Altimeter data confirmed that"
    },
    {
      "s": 50.08,
      "e": 51.45,
      "text": "Ingenuity has performed"
    },
    {
      "s": 51.45,
      "e": 52.82,
      "text": "its first flight."
    },
    {
      "s": 53.45,
      "e": 55.85,
      "text": "First flight of a powered"
    },
    {
      "s": 55.85,
      "e": 57.36,
      "text": "aircraft on another planet."
    },
    {
      "s": 58.16,
      "e": 60.09,
      "text": "[clapping]"
    },
    {
      "s": 62.66,
      "e": 65.63,
      "text": "[music]"
    },
    {
      "s": 70.67,
      "e": 73.64,
      "text": "[clapping]"
    },
    {
      "s": 77.84,
      "e": 80.48,
      "text": "We can now say that human beings"
    },
    {
      "s": 80.48,
      "e": 82.15,
      "text": "have flown a rotorcraft on"
    },
    {
      "s": 82.15,
      "e": 83.58,
      "text": "another planet."
    },
    {
      "s": 84.08,
      "e": 85.32,
      "text": "[cheering, clapping]"
    },
    {
      "s": 85.62,
      "e": 86.92,
      "text": "Let’s get back to work and"
    },
    {
      "s": 86.92,
      "e": 89.22,
      "text": "more flights! Congratulations!"
    },
    {
      "s": 90.39,
      "e": 93.36,
