    {
      "s": 91.26,
      "e": 92.49,
      "text": "On Monday,"
    },
    {
      "s": 92.49,
      "e": 94.63,
      "text": "NASAâs Solar  Dynamics Observatory"
    },
    {
      "s": 94.63,
      "e": 97.2,
      "text": "captured dramatic images  of the Sun unleashing"
    },
    {
