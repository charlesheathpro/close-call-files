      "s": 1388.18,
      "e": 1390.01,
      "text": "INSPIRATION, AND YOU WERE KIND"
    },
    {
      "s": 1390.01,
      "e": 1392.06,
      "text": "ENOUGH TO SIGN IT AND INCLUDE A"
    },
    {
      "s": 1392.06,
      "e": 1392.97,
      "text": "LITTLE MESSAGE IN THERE FOR ME,"
    },
    {
      "s": 1392.97,
      "e": 1395.77,
      "text": "AND I JUST WANTED TO SAY THANK"
