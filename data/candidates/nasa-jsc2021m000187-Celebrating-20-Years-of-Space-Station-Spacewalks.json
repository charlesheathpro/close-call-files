  "transcript": [
    {
      "s": 0.63,
      "e": 7.47,
      "text": "[ MUSIC ]"
    },
    {
      "s": 7.47,
      "e": 8.61,
      "text": ">> SO, WOW, THAT WAS"
    },
    {
      "s": 8.61,
      "e": 10.91,
      "text": "A-A HUGE EXPERIENCE IN MY LIFE."
    },
    {
      "s": 10.91,
      "e": 12.51,
      "text": "UM, WE WORKED FOR MANY YEARS"
    },
    {
      "s": 12.51,
      "e": 13.88,
      "text": "TO GET READY FOR THAT."
    },
    {
      "s": 13.88,
      "e": 14.65,
      "text": "AND THEN WE WERE SITTING"
    },
    {
      "s": 14.65,
      "e": 15.58,
      "text": "IN THE CREW LOCK,"
    },
    {
      "s": 15.58,
      "e": 16.38,
      "text": "WHICH IS THIS PART OF"
    },
    {
      "s": 16.38,
      "e": 16.98,
      "text": "THE AIRLOCK"
    },
    {
      "s": 16.98,
      "e": 18.05,
      "text": "THAT GOES TO VACUUM."
    },
    {
      "s": 18.05,
      "e": 18.92,
      "text": "WE WERE SUPPOSED TO"
    },
    {
      "s": 18.92,
      "e": 21.39,
      "text": "DEPRESSURIZE IN 30 MINUTES."
    },
    {
      "s": 21.39,
      "e": 22.25,
      "text": "THAT WAS THE-THAT WAS"
    },
    {
      "s": 22.25,
      "e": 23.62,
      "text": "THE THEORETICAL THING."
    },
    {
      "s": 23.62,
      "e": 24.79,
      "text": "BUT THEY MISSED"
    },
    {
      "s": 24.79,
      "e": 25.79,
      "text": "THE CALCULATION SOMEWHAT,"
    },
    {
      "s": 25.79,
      "e": 27.63,
      "text": "AND IT TOOK OVER AN HOUR."
    },
    {
      "s": 27.63,
      "e": 28.39,
      "text": "SO I'M-- YOU KNOW,"
    },
    {
      "s": 28.39,
      "e": 29.5,
      "text": "WE'RE KINDA ANXIOUS."
    },
    {
      "s": 29.5,
      "e": 30.93,
      "text": "AND THEN THE CAPCOM,"
    },
    {
      "s": 30.93,
      "e": 31.73,
      "text": "DAN BURBANK,"
    },
    {
      "s": 31.73,
      "e": 33.33,
      "text": "WHISPERED IN MY EAR,"
    },
    {
      "s": 33.33,
      "e": 35.6,
      "text": "\"THIS IS THE ANNIVERSARY OF"
    },
    {
      "s": 35.6,
      "e": 36.77,
      "text": "THE FIRST MOONWALK.\""
    },
    {
      "s": 36.77,
      "e": 38.24,
      "text": "AND I DID NOT KNOW THAT."
    },
    {
      "s": 38.24,
      "e": 39.17,
      "text": "AND WE WEREN'T EXPECTING"
    },
    {
      "s": 39.17,
      "e": 41.74,
      "text": "TO GO OUT THE DOOR ON THAT DATE."
    },
    {
      "s": 41.74,
      "e": 42.67,
      "text": "AND SO -- ANYHOW,"
    },
    {
      "s": 42.67,
      "e": 43.34,
      "text": "ALL THOSE THOUGHTS"
    },
    {
      "s": 43.34,
      "e": 44.28,
      "text": "WERE RUNNING THROUGH MY MIND."
    },
    {
      "s": 44.28,
      "e": 45.84,
      "text": "AND THEN,"
    },
    {
      "s": 45.84,
      "e": 46.98,
      "text": "AS I WENT OUT THE DOOR,"
    },
    {
      "s": 46.98,
      "e": 47.81,
      "text": "IT'S VERY DIFFERENT"
    },
    {
      "s": 47.81,
      "e": 49.15,
      "text": "THAN THE SHUTTLE."
    },
    {
      "s": 49.15,
      "e": 49.88,
      "text": "I HAD DONE SPACEWALKS"
    },
    {
      "s": 49.88,
      "e": 50.58,
      "text": "IN THE SHUTTLE,"
    },
    {
      "s": 50.58,
      "e": 51.58,
      "text": "AND WE HAVE THE PAYLOAD BAY"
    },
    {
      "s": 51.58,
      "e": 52.48,
      "text": "UNDERNEATH YOU."
    },
    {
      "s": 52.48,
      "e": 53.05,
      "text": "YOU FEEL LIKE"
    },
    {
      "s": 53.05,
      "e": 54.32,
      "text": "YOU HAVE A FLOOR UNDER YOU."
    },
    {
      "s": 54.32,
      "e": 55.55,
      "text": "AND WE CAME OUT,"
    },
    {
      "s": 55.55,
      "e": 56.79,
      "text": "OR I CAME OUT FIRST."
    },
    {
      "s": 56.79,
      "e": 58.69,
      "text": "UM, AND THE HATCH OF"
    },
    {
      "s": 58.69,
      "e": 60.83,
      "text": "THE ISS AIRLOCK POINTS NADIR,"
    },
    {
      "s": 60.83,
      "e": 61.96,
      "text": "WHICH MEANS TOWARDS EARTH."
    },
    {
      "s": 61.96,
      "e": 63.3,
      "text": "SO, AS YOU LOOK OUT THE HATCH,"
    },
    {
      "s": 63.3,
      "e": 63.9,
      "text": "YOU FEEL LIKE"
    },
    {
      "s": 63.9,
      "e": 65.86,
      "text": "YOU'RE FALLING FROM 250 MILES."
    },
    {
      "s": 65.86,
      "e": 67.77,
      "text": "SO THAT WAS A BIG RUSH."
    },
    {
      "s": 67.77,
      "e": 69.0,
      "text": "EVERYTHING WE DO AT NASA"
    },
    {
      "s": 69.0,
      "e": 70.17,
      "text": "IS A GREAT TEAM EFFORT."
    },
    {
      "s": 70.17,
      "e": 72.61,
      "text": "AND-AND I WORK WITH ONE OF"
    },
    {
      "s": 72.61,
      "e": 73.81,
      "text": "THE GREATEST TEAMS AT NASA"
    },
    {
      "s": 73.81,
      "e": 74.87,
      "text": "TO DEVELOP THIS AIRLOCK"
    },
    {
      "s": 74.87,
      "e": 76.18,
      "text": "AND THE PROTOCOL."
    },
    {
      "s": 76.18,
      "e": 77.31,
      "text": "WHEN I WENT OUT THE DOOR,"
    },
    {
      "s": 77.31,
      "e": 78.71,
      "text": "I HAD ALL THEIR NAMES"
    },
    {
      "s": 78.71,
      "e": 79.71,
      "text": "ON MY CUFF CHECKLIST."
    },
    {
      "s": 79.71,
      "e": 82.25,
      "text": "AND I REALLY, UH, REALLY"
    },
    {
      "s": 82.25,
      "e": 83.28,
      "text": "SHOWED 'EM MY APPRECIATION"
    },
    {
      "s": 83.28,
      "e": 84.12,
      "text": "FOR ALL THE TEAMWORK"
    },
    {
      "s": 84.12,
      "e": 84.72,
      "text": "THAT IT TOOK."
    },
    {
      "s": 84.72,
      "e": 87.45,
      "text": "AND-AND, UH, IT WAS REALLY"
    },
    {
      "s": 87.45,
      "e": 88.95,
      "text": "QUITE AN AMAZING, UH, EFFORT."
    },
    {
      "s": 88.95,
      "e": 90.99,
      "text": "AND WHEN YOU LOOK AT IT,"
    },
    {
      "s": 90.99,
      "e": 92.06,
      "text": "YOU KNOW, THE SPACE STATION"
    },
    {
      "s": 92.06,
      "e": 93.86,
      "text": "WAS ASSEMBLED FROM SPACEWALKS,"
    },
    {
      "s": 93.86,
      "e": 95.4,
      "text": "IT'S MAINTAINED FROM SPACEWALKS."
    },
    {
      "s": 95.4,
      "e": 96.13,
      "text": "WE'VE HAD TO"
    },
    {
      "s": 96.13,
      "e": 96.96,
      "text": "CHANGE OUT BATTERIES"
    },
    {
      "s": 96.96,
      "e": 98.66,
      "text": "AND DO ALL KINDS OF MAINTENANCE."
    },
    {
      "s": 98.66,
      "e": 99.6,
      "text": "IF YOU CAN'T"
    },
    {
      "s": 99.6,
      "e": 101.2,
      "text": "GET OUT THE DOOR EFFICIENTLY,"
    },
    {
      "s": 101.2,
      "e": 102.0,
      "text": "THEN YOU CAN'T DO"
    },
    {
      "s": 102.0,
      "e": 102.77,
      "text": "ALL THESE SPACEWALKS."
    },
    {
      "s": 102.77,
      "e": 104.24,
      "text": "AND SO, THE IMPLEMENTATION OF"
    },
    {
      "s": 104.24,
      "e": 105.5,
      "text": "THE AIRLOCK"
    },
    {
      "s": 105.5,
      "e": 106.91,
      "text": "WITH THE PRE-BRIEF PROTOCOL"
    },
    {
      "s": 106.91,
      "e": 109.11,
      "text": "THAT-THAT WAS BASICALLY, LIKE,"
    },
    {
      "s": 109.11,
      "e": 110.34,
      "text": "TWO AND A HALF HOURS,"
    },
    {
      "s": 110.34,
      "e": 111.98,
      "text": "WHICH WAS ACTUALLY VERY LOW"
    },
    {
      "s": 111.98,
      "e": 113.01,
      "text": "COMPARED TO WHAT WE THOUGHT"
    },
    {
      "s": 113.01,
      "e": 114.35,
      "text": "WE'D HAVE TO DO."
    },
    {
      "s": 114.35,
      "e": 116.18,
      "text": "AND THEN ALL OF THE LITTLE TOOLS"
    },
    {
      "s": 116.18,
      "e": 117.05,
      "text": "THAT WE DEVELOPED"
    },
    {
      "s": 117.05,
      "e": 117.85,
      "text": "FOR THAT MISSION."
    },
    {
      "s": 117.85,
      "e": 119.69,
      "text": "THINGS LIKE THE CREW LOCK BAGS"
    },
    {
      "s": 119.69,
      "e": 121.15,
      "text": "THAT YOU CARRY YOUR TOOLS IN."
    },
    {
      "s": 121.15,
      "e": 123.29,
      "text": "I-I WORKED WITH THE-THE, UH,"
    },
    {
      "s": 123.29,
      "e": 124.89,
      "text": "CREW AND THERMAL SYSTEMS GUYS"
    },
    {
      "s": 124.89,
      "e": 126.26,
      "text": "TO DESIGN THOSE."
    },
    {
      "s": 126.26,
      "e": 127.63,
      "text": "AND THEN WE, UM--"
    },
    {
      "s": 127.63,
      "e": 128.23,
      "text": "I HAD ACTUALLY"
    },
    {
      "s": 128.23,
      "e": 129.0,
      "text": "INVENTED THIS DEVICE"
    },
    {
      "s": 129.0,
      "e": 131.0,
      "text": "CALLED THE BODY RESTRAINT TETHER"
    },
    {
      "s": 131.0,
      "e": 132.37,
      "text": "THAT COMES OFF YOUR WAIST."
    },
    {
      "s": 132.37,
      "e": 133.6,
      "text": "AND YOU USE THAT"
    },
    {
      "s": 133.6,
      "e": 135.13,
      "text": "TO HOLD ONTO A HANDHOLD"
    },
    {
      "s": 135.13,
      "e": 136.8,
      "text": "FOR ANYTHING BUT"
    },
    {
      "s": 136.8,
      "e": 138.44,
      "text": "REALLY HIGH FORCE TASKS,"
    },
    {
      "s": 138.44,
      "e": 139.1,
      "text": "THAT'S ENOUGH"
    },
    {
      "s": 139.1,
      "e": 140.14,
      "text": "TO RESTRAIN YOURSELF."
    },
    {
      "s": 140.14,
      "e": 141.27,
      "text": "AND SO, UM--"
    },
    {
      "s": 141.27,
      "e": 142.51,
      "text": "AND WE HONESTLY, PROBABLY,"
    },
    {
      "s": 142.51,
      "e": 144.01,
      "text": "COULDN'T HAVE BUILT STATION"
    },
    {
      "s": 144.01,
      "e": 145.71,
      "text": "AS WELL AS WE DID WITHOUT THAT."
    },
    {
      "s": 145.71,
      "e": 146.55,
      "text": "IT FEELS GREAT."
    },
    {
      "s": 146.55,
      "e": 147.75,
      "text": "SO, ALL THOSE TECHNIQUES"
    },
    {
      "s": 147.75,
      "e": 149.18,
      "text": "T-THAT WE REALLY DEVELOPED"
    },
    {
      "s": 149.18,
      "e": 150.62,
      "text": "TO DO, UM, SPACEWALKS"
    },
    {
      "s": 150.62,
      "e": 152.05,
      "text": "FROM THE SPACE STATION"
    },
    {
      "s": 152.05,
      "e": 153.02,
      "text": "HAVE BEEN USED AGAIN"
    },
    {
      "s": 153.02,
      "e": 154.19,
      "text": "AND AGAIN AND AGAIN"
    },
    {
      "s": 154.19,
      "e": 155.35,
      "text": "TO GREAT SUCCESS."
    },
    {
      "s": 155.35,
      "e": 156.56,
      "text": "SO, THE SPACEWALKS ON THE MOON"
    },
    {
      "s": 156.56,
      "e": 157.79,
      "text": "WILL BE VERY DIFFERENT"
    },
    {
      "s": 157.79,
      "e": 158.79,
      "text": "THAN ON ISS."
    },
    {
      "s": 158.79,
      "e": 159.99,
      "text": "ON ISS, WE'RE DOING"
    },
    {
      "s": 159.99,
      "e": 161.29,
      "text": "SOME DETAIL MAINTENANCE,"
    },
    {
      "s": 161.29,
      "e": 162.63,
      "text": "CHANGING OUT BATTERY PACKS"
    },
    {
      "s": 162.63,
      "e": 164.16,
      "text": "AND THINGS OF THIS NATURE."
    },
    {
      "s": 164.16,
      "e": 166.0,
      "text": "WHEREAS, ON THE MOON,"
    },
    {
      "s": 166.0,
      "e": 167.4,
      "text": "WE'RE THERE TO EXPLORE"
    },
    {
      "s": 167.4,
      "e": 168.7,
      "text": "AND-AND TO TAKE ADVANTAGE"
    },
    {
      "s": 168.7,
      "e": 169.77,
      "text": "OF THE HUMAN BRAIN"
    },
    {
      "s": 169.77,
      "e": 170.87,
      "text": "AND JUDGEMENT AND"
    },
    {
      "s": 170.87,
      "e": 172.77,
      "text": "THEIR HANDS TO DO EXPLORATION."
    },
    {
      "s": 172.77,
      "e": 173.87,
      "text": "SO-SO THE TASK"
    },
    {
      "s": 173.87,
      "e": 175.01,
      "text": "WILL INVOLVED SCIENCE."
    },
    {
      "s": 175.01,
      "e": 175.71,
      "text": "WE'LL STILL HAVE"
    },
    {
      "s": 175.71,
      "e": 177.21,
      "text": "SOME MAINTENANCE TO DO"
    },
    {
      "s": 177.21,
      "e": 178.28,
      "text": "ON THE ROVER."
    },
    {
      "s": 178.28,
      "e": 178.94,
      "text": "THERE WILL STILL BE"
    },
    {
      "s": 178.94,
      "e": 179.75,
      "text": "SOME OF THAT."
    },
    {
      "s": 179.75,
      "e": 181.88,
      "text": "BUT YOUR DAILY, UH, SPACEWALKS"
    },
    {
      "s": 181.88,
      "e": 185.12,
      "text": "WILL BE FOCUSED ON THE SCIENCE."
    }
