      "e": 97.43,
      "text": "AND THEN CHIEF"
    },
    {
      "s": 97.43,
      "e": 99.06,
      "text": "OF THE ASTRONAUT OFFICE."
    },
    {
      "s": 99.06,
      "e": 100.23,
      "text": "SO I SERVED AS THE, UH,"
