  "transcript": [
    {
      "s": 0.99,
      "e": 2.82,
      "text": "- [On Phone] \"We have a medical emergency"
    },
    {
      "s": 2.82,
      "e": 5.0,
      "text": "\"over here on Crab Island.\""
    },
    {
      "s": 5.0,
      "e": 6.57,
      "text": "^- We got a call over Channel 16"
    },
    {
      "s": 6.57,
      "e": 7.71,
      "text": "^about an individual"
    },
    {
      "s": 7.71,
      "e": 9.83,
      "text": "^that had a possible back injury"
    },
    {
      "s": 9.83,
      "e": 11.15,
      "text": "^off Crab Island."
    },
    {
      "s": 11.15,
      "e": 12.47,
      "text": "^- But right now since we're on this boat"
    },
    {
      "s": 12.47,
      "e": 13.58,
      "text": "^we're gonna take that back"
    },
    {
      "s": 13.58,
      "e": 15.14,
      "text": "^and drive them back."
    },
    {
      "s": 15.14,
      "e": 17.87,
      "text": "^- I jumped over with two other crew members."
    },
    {
      "s": 17.87,
      "e": 19.49,
      "text": "^We stabilized the individual"
    },
    {
      "s": 19.49,
      "e": 22.65,
      "text": "^and then I drove the vessel back here."
    },
    {
      "s": 24.62,
      "e": 26.53,
      "text": "^If you guys are ever in"
    },
    {
      "s": 26.6,
      "e": 28.06,
      "text": "^any sort of trouble"
    },
    {
      "s": 28.06,
      "e": 29.29,
      "text": "^don't be afraid to call 911."
    },
    {
      "s": 29.29,
      "e": 31.97,
      "text": "^We get dispatched out by 911 all the time."
    },
    {
      "s": 31.97,
      "e": 32.87,
      "text": "^In that case right there"
    },
    {
      "s": 32.87,
      "e": 34.5,
      "text": "^the people didn't know who to contact."
    },
    {
      "s": 34.5,
      "e": 36.23,
      "text": "^They just happened to see a little vessel"
    },
    {
      "s": 36.23,
      "e": 37.18,
      "text": "^riding around Crab Island"
    },
    {
      "s": 37.18,
      "e": 38.47,
      "text": "^that had a VHF onboard"
    },
    {
      "s": 38.47,
      "e": 41.14,
      "text": "^and that's how we got call of it."
    },
    {
      "s": 41.14,
      "e": 43.9,
      "text": "^But you know they just as easily could have called 911"
    },
    {
      "s": 43.9,
      "e": 46.45,
      "text": "^and then we would have gotten the call."
    },
    {
      "s": 46.45,
      "e": 49.36,
      "text": "(triumphant music)"
    }
