  "source_file": {
    "src": "https://images-assets.nasa.gov/video/jsc2024m000075_Meet_Matthew_Dominick_Crew-8_Commander-SOCIAL/jsc2024m000075_Meet_Matthew_Dominick_Crew-8_Commander-SOCIAL~orig.mp4",
