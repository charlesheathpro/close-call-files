  "transcript": [
    {
      "s": 15.62,
      "e": 17.96,
      "text": "- Okay, I'm CW5 Lester Furrer"
    },
    {
      "s": 17.96,
      "e": 20.24,
      "text": "from South Carolina Army National Guard."
    },
    {
      "s": 20.24,
      "e": 22.07,
      "text": "I'm here with the South Carolina"
    },
    {
      "s": 22.07,
      "e": 24.3,
      "text": "helicopter aquatic recovery team,"
    },
    {
      "s": 24.3,
      "e": 27.79,
      "text": "and my unit is the 59th Aviation Troop Command."
    },
    {
      "s": 27.79,
      "e": 29.67,
      "text": "We're to support Texas in"
    },
    {
      "s": 29.67,
      "e": 32.54,
      "text": "the recovery effort after Hurricane Harvey."
    },
    {
      "s": 32.54,
      "e": 36.71,
      "text": "Rescue hoist, cam back, hauling people, equipment,"
    },
    {
      "s": 37.35,
      "e": 39.44,
      "text": "whatever they need of us."
    },
    {
      "s": 39.46,
      "e": 41.21,
      "text": "We arrived yesterday."
    },
    {
      "s": 43.01,
      "e": 45.88,
      "text": "And so, this is our first day on the mission."
    },
    {
