    {
      "s": 15.44,
      "e": 18.11,
      "text": "^- [Renee] The 147th Attack Wing received supplies"
    },
    {
      "s": 18.11,
      "e": 20.9,
      "text": "^at Ellington Field Joint Reserve Base today."
    },
    {
      "s": 20.9,
      "e": 23.86,
      "text": "Airmen worked to guide the C-130 on the runway"
    },
    {
      "s": 23.86,
      "e": 26.86,
      "text": "and assist in unloading the cargo plane."
    },
    {
      "s": 26.86,
      "e": 28.02,
      "text": "Members of the maintenance group"
    },
    {
      "s": 28.02,
      "e": 31.15,
      "text": "worked with other units to coordinate the logistics."
    },
    {
      "s": 31.15,
      "e": 33.75,
      "text": "^- I'm a crew chief with the 147th Attack Wing."
    },
    {
      "s": 33.75,
      "e": 35.77,
      "text": "^Today we have C-130s coming in"
    },
    {
      "s": 35.77,
      "e": 38.08,
      "text": "^and we are taking supplies off the C-130"
    },
    {
      "s": 38.08,
      "e": 40.25,
      "text": "to be distributed, so they can have food"
    },
    {
      "s": 40.25,
      "e": 42.46,
      "text": "and water and whatever supplies they need."
    },
    {
      "s": 42.46,
      "e": 44.71,
      "text": "- [Renee] The supplies included water and diapers,"
    },
    {
      "s": 44.71,
      "e": 46.44,
      "text": "which will be distributed to civilians"
    },
    {
      "s": 46.44,
      "e": 48.86,
      "text": "affected by Hurricane Harvey."
    },
    {
      "s": 49.4,
      "e": 53.57,
      "text": "Reporting from Ellington Field, I'm Airman Renee Crugnale."
    }
