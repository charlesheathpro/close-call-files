      "e": 486.15,
      "text": "OF IMPORTANT WORK,"
    },
    {
      "s": 486.15,
      "e": 487.19,
      "text": "THAT, UH, YOU AND THOMAS"
    },
    {
      "s": 487.19,
      "e": 488.65,
      "text": "ARE ABOUT TO EMBARK ON?"
    },
    {
      "s": 491.79,
      "e": 492.49,
      "text": ">> YEAH, THANKS FOR THAT"
    },
    {
      "s": 492.49,
      "e": 493.39,
      "text": "QUESTION, ROB."
    },
    {
      "s": 493.39,
      "e": 494.03,
      "text": "I NEVER, OF COURSE,"
    },
    {
      "s": 494.03,
      "e": 495.13,
      "text": "NEVER ENVISIONED THAT."
    },
    {
      "s": 495.13,
      "e": 496.3,
      "text": "I WAS-- YOU KNOW, WHEN I FLEW"
    },
    {
      "s": 496.3,
      "e": 497.66,
      "text": "ON SHUTTLE MANY YEARS AGO,"
    },
    {
      "s": 497.66,
      "e": 498.87,
      "text": "AND GOT A CHANCE TO DO"
    },
    {
      "s": 498.87,
      "e": 499.9,
      "text": "A COUPLE SPACEWALKS,"
    },
    {
      "s": 499.9,
      "e": 501.33,
      "text": "I REALLY THOUGHT THAT WAS"
    },
    {
      "s": 501.33,
      "e": 502.03,
      "text": "PROBABLY GOING TO BE"
    },
    {
      "s": 502.03,
      "e": 503.87,
      "text": "THE ONLY TIMES I GOT OUTSIDE."
    },
    {
      "s": 503.87,
      "e": 504.87,
      "text": "AND, UH, YOU KNOW,"
    },
    {
      "s": 504.87,
      "e": 506.04,
      "text": "THINGS HAVE PLAYED OUT"
    },
    {
      "s": 506.04,
      "e": 506.91,
      "text": "DIFFERENTLY, SO THAT"
    },
    {
      "s": 506.91,
      "e": 507.51,
      "text": "I'VE GOTTEN A CHANCE"
    },
    {
      "s": 507.51,
      "e": 508.41,
      "text": "TO DO MANY MORE,"
    },
    {
      "s": 508.41,
      "e": 509.61,
      "text": "AND I'M VERY BLESSED."
    },
    {
      "s": 509.61,
      "e": 510.54,
      "text": "I FEEL VERY LUCKY"
    },
    {
      "s": 510.54,
      "e": 512.35,
      "text": "AND FORTUNATE TO DO THAT."
    },
    {
      "s": 512.35,
      "e": 513.51,
      "text": "AND, UH, THIS TIME THOMAS"
    },
    {
      "s": 513.51,
      "e": 514.38,
      "text": "IS GONNA BE LEADING THE WAY"
    },
    {
      "s": 514.38,
      "e": 515.45,
      "text": "ON BOTH OF THESE SPACEWALKS"
    },
    {
      "s": 515.45,
      "e": 516.25,
      "text": "AND I LOOK FORWARD TO HIM"
    },
    {
      "s": 516.25,
      "e": 517.48,
      "text": "BEING IN THAT ROLE"
    },
    {
      "s": 517.48,
      "e": 518.38,
      "text": "AND, UH, ME JUST BEING"
    },
    {
      "s": 518.38,
      "e": 519.35,
      "text": "A GOOD SUPPORT PERSON"
    },
    {
      "s": 519.35,
      "e": 520.25,
      "text": "OUT THERE WITH HIM"
    },
    {
      "s": 520.25,
      "e": 521.09,
      "text": "AND WE'RE GONNA JUST"
    },
    {
      "s": 521.09,
      "e": 522.09,
      "text": "WORK TOGETHER CLOSELY"
    },
    {
      "s": 522.09,
      "e": 522.99,
      "text": "WITH THE GROUND TEAMS"
    },
    {
      "s": 522.99,
      "e": 523.96,
      "text": "TO MAKE SURE"
    },
    {
      "s": 523.96,
      "e": 525.39,
      "text": "WE GET THIS JOB DONE."
    },
    {
      "s": 526.36,
      "e": 527.23,
      "text": ">> WELL, SHANE, UH,"
    },
    {
      "s": 527.23,
      "e": 528.49,
      "text": "ALL THE BEST OF LUCK TO YOU"
    },
    {
      "s": 528.49,
      "e": 529.43,
      "text": "AND THOMAS DURING THESE"
