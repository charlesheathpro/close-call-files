  "transcript": [
    {
      "s": 3.17,
      "e": 5.76,
      "text": "(somber music)"
    },
    {
      "s": 43.6,
      "e": 44.7,
      "text": "- [Soldiers] I pledge allegiance"
    },
    {
      "s": 44.7,
      "e": 48.05,
      "text": "to the flag of the United States of America,"
    },
    {
      "s": 48.05,
      "e": 50.61,
      "text": "And to the republic for which it stands,"
    },
    {
      "s": 50.61,
      "e": 52.44,
      "text": "one nation, under God,"
    },
    {
      "s": 52.49,
      "e": 56.33,
      "text": "indivisible, with liberty and justice for all."
    },
    {
      "s": 59.27,
      "e": 60.6,
      "text": "- Task Force 56."
    },
    {
      "s": 61.0,
      "e": 62.08,
      "text": "Company, hut."
    },
    {
      "s": 65.72,
      "e": 67.64,
      "text": "- September 11th, 2001."
    },
    {
      "s": 69.62,
      "e": 71.37,
      "text": "8:46 am was the time."
    },
    {
      "s": 73.5,
      "e": 77.66,
      "text": "American Airlines Flight 11 crashed into the north tower."
    },
    {
      "s": 77.66,
      "e": 78.93,
      "text": "We watched the war as thousands"
    },
    {
      "s": 78.93,
      "e": 81.51,
      "text": "of American civilians perished."
    },
    {
      "s": 83.3,
      "e": 85.3,
      "text": "At the Pentagon as well."
    },
    {
      "s": 88.83,
      "e": 90.84,
      "text": "The impacts remain with us."
    },
    {
      "s": 90.84,
      "e": 93.76,
      "text": "Memories of loved ones and friends."
    },
    {
      "s": 95.8,
      "e": 96.99,
      "text": "The day that shook America"
    },
    {
      "s": 96.99,
      "e": 99.83,
      "text": "is also a day that united America."
    },
    {
      "s": 102.71,
      "e": 104.52,
      "text": "Greatness, America's demonstrated"
    },
    {
      "s": 104.52,
      "e": 108.19,
      "text": "how we come together in the face of tragedy."
    },
    {
      "s": 110.83,
      "e": 113.81,
      "text": "America's response to Harvey continues that proud legacy"
    },
    {
      "s": 113.81,
      "e": 116.31,
      "text": "of Americas helping Americans."
    },
    {
      "s": 118.76,
      "e": 122.26,
      "text": "Please take a moment of silent reflection."
    },
    {
      "s": 127.55,
      "e": 129.6,
      "text": "On behalf of the New York Contingence,"
    },
    {
      "s": 129.6,
      "e": 132.35,
      "text": "thank you, and God bless America."
    },
    {
      "s": 134.75,
      "e": 137.0,
      "text": "- Task force 56, attention!"
    },
    {
      "s": 139.03,
      "e": 141.2,
      "text": "(yelling)"
    }
  ],
