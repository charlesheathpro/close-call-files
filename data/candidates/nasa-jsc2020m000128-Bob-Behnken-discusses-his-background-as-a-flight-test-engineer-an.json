      "e": 211.44,
      "text": "THINGS DID GET COMPLICATED"
    },
    {
      "s": 211.44,
      "e": 212.11,
      "text": "WHILE YOU TRIED TO"
    },
    {
      "s": 212.11,
      "e": 213.15,
      "text": "ACCOMPLISH THE MISSION."
    },
    {
      "s": 213.15,
      "e": 214.41,
      "text": "WHETHER IT'S A SPACE WALK"
    },
    {
      "s": 214.41,
      "e": 215.21,
      "text": "OR LAUNCHING INTO SPACE"
    },
    {
      "s": 215.21,
      "e": 216.68,
      "text": "ON A SPACE SHUTTLE, UH,"
    },
    {
      "s": 216.68,
      "e": 217.35,
      "text": "KNOWING WHAT YOUR NEXT"
    },
    {
      "s": 217.35,
      "e": 218.92,
      "text": "ACTIONS ARE AND-AND ALL"
    },
    {
      "s": 218.92,
      "e": 220.29,
      "text": "THE DIFFERENCE SCENARIOS."
    },
    {
      "s": 220.29,
      "e": 221.02,
      "text": "IT'S THE EXACT SAME THING"
    },
    {
      "s": 221.02,
      "e": 222.29,
      "text": "YOU NEED TO DO FROM A-"
