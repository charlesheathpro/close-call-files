    },
    {
      "s": 223.22,
      "e": 224.46,
      "text": "WITH A-- WITH AN AIRPLANE"
    },
    {
      "s": 224.46,
      "e": 226.43,
      "text": "OR NEW EQUIPMENT, UH,"
    },
    {
      "s": 226.43,
      "e": 228.13,
      "text": "OF THAT-- OF THAT MAGNITUDE."
    },
    {
      "s": 228.13,
      "e": 229.03,
      "text": "IT'S JUST A-A VERY,"
    },
    {
      "s": 229.03,
      "e": 230.66,
      "text": "VERY SIMILAR PROCESS."
    },
    {
