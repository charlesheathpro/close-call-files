      "text": "[ MUSIC ]"
    },
    {
      "s": 13.88,
      "e": 14.91,
      "text": ">> TACOS."
    },
    {
      "s": 14.91,
      "e": 15.95,
      "text": ">> CHEESE AND DIARY."
    },
    {
      "s": 15.95,
      "e": 16.85,
      "text": "I KNOW IT'S CLICHE FOR"
    },
    {
      "s": 16.85,
      "e": 18.45,
      "text": "A FRENCHMAN, BUT IT'S TRUE."
    },
    {
      "s": 18.45,
      "e": 20.09,
      "text": ">> RAMEN NOODLES."
    },
    {
      "s": 20.09,
      "e": 20.92,
      "text": ">> COOKIES."
    },
    {
      "s": 20.92,
      "e": 22.96,
      "text": ">> FAVORITE COLOR IS BLUE."
    },
    {
      "s": 22.96,
      "e": 23.89,
      "text": ">> BLUE."
    },
    {
      "s": 23.89,
      "e": 24.66,
      "text": ">> BLUE."
    },
    {
      "s": 24.66,
      "e": 26.13,
      "text": ">> ORANGE."
    },
    {
      "s": 26.13,
      "e": 28.33,
      "text": ">> HÄAGEN-DAZS STRAWBERRY."
    },
    {
      "s": 28.33,
      "e": 29.2,
      "text": ">> PISTACHIO."
    },
    {
      "s": 29.2,
      "e": 29.93,
      "text": ">> MINT CHIP."
    },
    {
      "s": 29.93,
      "e": 31.36,
      "text": ">> PLAIN VANILLA."
    },
    {
      "s": 31.36,
      "e": 32.73,
      "text": "LOW QUALITY"
    },
    {
      "s": 32.73,
      "e": 34.3,
      "text": "FAST FOOD ICE CREAM."
    },
    {
      "s": 34.3,
      "e": 36.24,
      "text": ">> \"THE PRINCESS BRIDE.\""
    },
    {
      "s": 36.24,
      "e": 37.47,
      "text": ">> FAVORITE MOVIE'S \"PROXIMA.\""
    },
    {
      "s": 37.47,
      "e": 38.24,
      "text": "IT'S NAMED AFTER"
    },
    {
      "s": 38.24,
      "e": 39.1,
      "text": "MY FIRST MISSION."
    },
    {
      "s": 39.1,
      "e": 39.77,
      "text": "IT'S THE STORY OF"
    },
    {
      "s": 39.77,
      "e": 40.54,
      "text": "A FEMALE ASTRONAUT,"
    },
    {
      "s": 40.54,
      "e": 41.64,
      "text": "EUROPEAN, FRENCH WOMAN"
    },
    {
      "s": 41.64,
      "e": 43.01,
      "text": "GOING TO SPACE."
    },
    {
      "s": 43.01,
      "e": 43.71,
      "text": ">> ANYTHING WITH"
    },
    {
      "s": 43.71,
      "e": 44.74,
      "text": "BOURNE OR BOND."
    },
    {
      "s": 44.74,
      "e": 46.08,
      "text": ">> MM..."
    },
    {
      "s": 46.08,
      "e": 47.58,
      "text": "HARD TO SAY."
    },
    {
      "s": 47.58,
      "e": 48.55,
      "text": "COUPLE OF JAPANESE,"
    },
    {
      "s": 48.55,
      "e": 50.05,
      "text": "UH, MYSTERY BOOKS."
    },
    {
      "s": 50.05,
      "e": 51.05,
      "text": ">> \"EXTREME OWNERSHIP.\""
    },
    {
      "s": 51.05,
      "e": 52.09,
      "text": ">> I LOVE BOOKS,"
    },
    {
      "s": 52.09,
      "e": 53.55,
      "text": "SO I CAN'T CHOOSE JUST ONE."
    },
    {
      "s": 53.55,
      "e": 54.42,
      "text": ">> I DON'T HAVE ANY."
    },
    {
      "s": 54.42,
      "e": 55.39,
      "text": "I READ A LOT OF BOOKS"
    },
    {
      "s": 55.39,
      "e": 56.29,
      "text": "AND I THINK IF I HAD"
    },
    {
      "s": 56.29,
      "e": 57.09,
      "text": "A FAVORITE ONE,"
    },
    {
      "s": 57.09,
      "e": 57.89,
      "text": "I WOULD STOP READING."
    },
    {
      "s": 57.89,
      "e": 58.69,
      "text": "BUT, LIKE, EVERY NEW ONE"
    },
    {
      "s": 58.69,
      "e": 59.56,
      "text": "IS MY FAVORITE BOOK,"
    },
    {
      "s": 59.56,
      "e": 60.73,
      "text": "AND THAT'S WHY I KEEP READING."
    },
    {
      "s": 60.73,
      "e": 62.66,
      "text": ">> I LIKE SKIING."
    },
    {
      "s": 62.66,
      "e": 63.46,
      "text": ">> BASKETBALL."
    },
    {
      "s": 63.46,
      "e": 64.13,
      "text": ">> RUGBY."
    },
    {
      "s": 64.13,
      "e": 64.76,
      "text": ">> GOLF."
    },
    {
      "s": 64.76,
      "e": 67.0,
      "text": ">> I DON'T-- I DON'T DANCE."
    },
    {
      "s": 67.0,
      "e": 69.03,
      "text": ">> I'VE BEEN HERE LONG ENOUGH."
    },
    {
      "s": 69.03,
      "e": 70.77,
      "text": "NOT FALLING FOR IT."
    },
    {
      "s": 70.77,
      "e": 71.77,
      "text": ">> THE MOONWALK,"
    },
    {
      "s": 71.77,
      "e": 73.14,
      "text": "EASY, BUT NOT REALLY."
    },
    {
      "s": 73.14,
      "e": 74.04,
      "text": "THAT'S THE \"SINGLE LADIES\""
    },
    {
      "s": 74.04,
      "e": 75.07,
      "text": "CHOREOGRAPHY."
    },
    {
      "s": 75.07,
      "e": 77.68,
      "text": ">> THE 90s WERE PRETTY GREAT."
    },
    {
      "s": 77.68,
      "e": 79.21,
      "text": ">> THAT'S WHEN I FELL IN LOVE,"
    },
    {
      "s": 79.21,
      "e": 80.18,
      "text": "GOT MARRIED."
    },
    {
      "s": 80.18,
      "e": 81.25,
      "text": ">> THAT'S WHEN I WAS IN COLLEGE"
    },
    {
      "s": 81.25,
      "e": 82.52,
      "text": "AND THE MUSIC WAS REALLY GREAT."
    },
    {
      "s": 82.52,
      "e": 83.78,
      "text": ">> KIDS WERE BORN IN THE 90s."
    },
    {
      "s": 83.78,
      "e": 84.75,
      "text": "I HAD SOME GREAT JOBS"
    },
    {
      "s": 84.75,
      "e": 86.45,
      "text": "OF FLYING APACHE HELICOPTERS"
    },
    {
      "s": 86.45,
      "e": 87.79,
      "text": "AND JUMPING OUT OF AIRPLANES."
    },
    {
      "s": 87.79,
      "e": 88.79,
      "text": ">> EVERY DECADE"
    },
    {
      "s": 88.79,
      "e": 90.06,
      "text": "THAT'S THE ONE WE'RE IN."
    },
    {
      "s": 90.06,
      "e": 91.69,
      "text": "I THINK THINGS GET BETTER."
    },
    {
      "s": 93.53,
      "e": 95.53,
      "text": ">> MM, MEAN DRIVERS."
    },
    {
      "s": 95.53,
      "e": 96.7,
      "text": ">> INEFFICIENCY."
    },
    {
      "s": 96.7,
      "e": 97.83,
      "text": ">> I DON'T HAVE ANYTHING."
    },
    {
      "s": 97.83,
      "e": 99.33,
      "text": "[ LAUGHS ]"
    },
    {
      "s": 99.33,
      "e": 100.9,
      "text": "NOTHING BOTHERS ME."
    },
    {
      "s": 100.9,
      "e": 103.24,
      "text": ">> I DO HAVE A SUPER POWER."
    },
    {
      "s": 103.24,
      "e": 104.6,
      "text": "IT'S TO MAKE KIDS HAPPY."
    },
    {
      "s": 104.6,
      "e": 105.54,
      "text": "SOMETIMES, YOU KNOW,"
    },
    {
      "s": 105.54,
      "e": 106.34,
      "text": "THEY WANT A SELFIE"
    },
    {
      "s": 106.34,
      "e": 107.34,
      "text": "OR AN AUTOGRAPH"
    },
    {
      "s": 107.34,
      "e": 108.21,
      "text": "AND YOU MAKE THEM HAPPY,"
    },
    {
      "s": 108.21,
      "e": 109.01,
      "text": "AND I THINK THAT'S A REALLY"
    },
    {
      "s": 109.01,
      "e": 110.48,
      "text": "COOL SUPER POWER TO HAVE."
    },
    {
      "s": 110.48,
      "e": 111.24,
      "text": ">> TO FLY."
    },
    {
      "s": 111.24,
      "e": 113.41,
      "text": ">> I WOULD HAVE TO SAY FLY."
    },
    {
      "s": 113.41,
      "e": 114.75,
      "text": ">> FLYING, OBVIOUSLY."
    },
    {
      "s": 114.75,
      "e": 117.28,
      "text": ">> UH, ROM COMS."
    },
    {
      "s": 117.28,
      "e": 118.38,
      "text": "I NEVER WATCH MOVIES,"
    },
    {
      "s": 118.38,
      "e": 119.65,
      "text": "BUT SOMETIMES WHEN I DO,"
    },
    {
      "s": 119.65,
      "e": 121.02,
      "text": "I END UP WITH, UH, YOU KNOW,"
    },
    {
      "s": 121.02,
      "e": 122.09,
      "text": "FEEL GOOD, HAPPY ENDING"
    },
    {
      "s": 122.09,
      "e": 123.59,
      "text": "LOVE STORIES."
    },
    {
      "s": 123.59,
      "e": 124.72,
      "text": ">> ICE CREAM."
    },
    {
      "s": 124.72,
      "e": 125.76,
      "text": ">> WELL, CHOCOLATE,"
    },
    {
      "s": 125.76,
      "e": 126.66,
      "text": "BUT I DON'T ACTUALLY FEEL"
    },
    {
      "s": 126.66,
      "e": 127.89,
      "text": "ALL THAT GUILTY ABOUT IT."
    },
    {
      "s": 129.83,
      "e": 130.76,
      "text": ">> PARENT."
    },
    {
      "s": 130.76,
      "e": 131.5,
      "text": ">> BEING A PARENT."
    },
    {
      "s": 131.5,
      "e": 132.4,
      "text": ">> PARENT, FOR SURE."
    },
    {
      "s": 132.4,
      "e": 133.23,
      "text": ">> IT'S NOT EVEN CLOSE."
    },
    {
      "s": 133.23,
      "e": 134.93,
      "text": ">> MY WIFE."
    },
    {
      "s": 134.93,
      "e": 136.34,
      "text": ">> FRIENDS AND FAMILIES."
    },
    {
      "s": 136.34,
      "e": 137.34,
      "text": ">> MY HUSBAND."
    },
    {
      "s": 137.34,
      "e": 138.87,
      "text": ">> I'D SAY MY PARTNER IN LIFE."
    },
    {
      "s": 138.87,
      "e": 139.64,
      "text": "SHE'S THE FUNNIEST"
    },
    {
      "s": 139.64,
      "e": 140.57,
      "text": "PERSON IN THE WORLD."
    },
    {
      "s": 140.57,
      "e": 142.28,
      "text": ">> MY DAD."
    },
    {
      "s": 142.28,
      "e": 143.41,
      "text": ">> AMANDA GORMAN."
    },
    {
      "s": 143.41,
      "e": 144.34,
      "text": ">> I THINK MY PARENTS"
    },
    {
      "s": 144.34,
      "e": 145.28,
      "text": "AND REALLY NORMAL PEOPLE"
    },
    {
      "s": 145.28,
      "e": 146.55,
      "text": "WHO TAKES RESPONSIBILITIES"
    },
    {
      "s": 146.55,
      "e": 147.51,
      "text": "AT A LOCAL LEVEL"
    },
    {
      "s": 147.51,
      "e": 149.08,
      "text": "AND TRY TO DO THE GOOD THINGS."
    },
    {
      "s": 149.08,
      "e": 150.58,
      "text": ">> COFFEE."
    },
    {
      "s": 150.58,
      "e": 151.38,
      "text": ">> TEA."
    },
    {
      "s": 151.38,
      "e": 152.32,
      "text": ">> COFFEE, DEFINITELY."
    },
    {
      "s": 152.32,
      "e": 153.09,
      "text": ">> TEA."
    },
    {
      "s": 153.09,
      "e": 155.29,
      "text": ">> BUILD A SAND CASTLE."
    },
    {
      "s": 155.29,
      "e": 155.92,
      "text": ">> I THINK I'D, UH,"
    },
    {
      "s": 155.92,
      "e": 156.86,
      "text": "HOP ON A ROVER"
    },
    {
      "s": 156.86,
      "e": 158.32,
      "text": "AND GO CRUISING AROUND ALL DAY."
    },
    {
      "s": 158.32,
      "e": 159.22,
      "text": ">> LOOK FOR FOOTPRINTS."
    },
    {
      "s": 159.22,
      "e": 161.13,
      "text": ">> PROBABLY DO BACKFLIPS."
    },
    {
      "s": 161.13,
      "e": 162.26,
      "text": "I WAS ON A PARABOLIC FLIGHT"
    },
    {
      "s": 162.26,
      "e": 163.56,
      "text": "WITH MARS GRAVITY"
    },
    {
      "s": 163.56,
      "e": 164.4,
      "text": "AND MOON GRAVITY."
    },
    {
      "s": 164.4,
      "e": 165.53,
      "text": "I CAN DO A DOUBLE BACKFLIP"
    },
    {
      "s": 165.53,
      "e": 166.53,
      "text": "IN MOON GRAVITY,"
    },
    {
      "s": 166.53,
      "e": 167.7,
      "text": "BUT I'M NOT QUITE SURE ON MARS,"
    },
    {
      "s": 167.7,
      "e": 168.47,
      "text": "BUT I WOULD TRY IT."
    },
    {
      "s": 169.77,
      "e": 170.5,
      "text": ">> I THINK"
    },
    {
      "s": 170.5,
      "e": 171.44,
      "text": "IT'S RUSSIAN LANGUAGE,"
    },
    {
      "s": 171.44,
      "e": 172.5,
      "text": "AND ONE OF MY, UH,"
    },
    {
      "s": 172.5,
      "e": 173.74,
      "text": "FORMER CREW MATES TOLD ME,"
    },
    {
      "s": 173.74,
      "e": 175.01,
      "text": "\"UH, FOR RUSSIAN LANGUAGE,"
    },
    {
      "s": 175.01,
      "e": 175.81,
      "text": "THE FIRST 10 YEARS"
    },
    {
      "s": 175.81,
      "e": 176.58,
      "text": "ARE THE HARDEST.\""
    },
    {
      "s": 176.58,
      "e": 177.24,
      "text": "SO, I THINK THAT'S"
    },
    {
      "s": 177.24,
      "e": 178.11,
      "text": "PRETTY ACCURATE."
    },
    {
      "s": 178.11,
      "e": 179.31,
      "text": ">> I THINK THE VOLUME"
    },
    {
      "s": 179.31,
      "e": 180.45,
      "text": "AND THE VARIETY"
    },
    {
      "s": 180.45,
      "e": 181.95,
      "text": "IS WHAT MAKES IT HARD,"
    },
    {
      "s": 181.95,
      "e": 183.12,
      "text": "BUT, UM, THAT'S ALSO"
    },
    {
      "s": 183.12,
      "e": 184.18,
      "text": "WHAT MAKES IT GREAT."
    },
    {
      "s": 185.69,
      "e": 186.69,
      "text": ">> SUGAR."
    },
    {
      "s": 186.69,
      "e": 187.62,
      "text": ">> I DO."
    },
    {
      "s": 187.62,
      "e": 189.56,
      "text": "I DO HAVE A CALL SIGN."
    },
    {
      "s": 189.56,
      "e": 191.89,
      "text": "UM, BUT I CANNOT TELL YOU"
    },
    {
      "s": 191.89,
      "e": 192.62,
      "text": "WHAT IT IS"
    },
    {
      "s": 192.62,
      "e": 193.89,
      "text": "AND-AND WHY."
    },
    {
      "s": 193.89,
      "e": 196.13,
      "text": "[ LAUGHS ]"
    }
