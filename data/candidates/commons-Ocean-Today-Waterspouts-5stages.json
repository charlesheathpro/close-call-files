    {
      "s": 0.0,
      "e": 3.6,
      "text": "Fairweather water spouts exhibit a five-stage life cycle."
    },
    {
      "s": 3.6,
      "e": 9.18,
      "text": "Stage one is the formation of a disc on the surface of the water, known as a dark spot."
    },
    {
      "s": 9.18,
      "e": 12.94,
      "text": "Stage two is a spiral pattern on the water surface."
    },
    {
      "s": 12.94,
      "e": 16.18,
      "text": "Stage three is a formation of a spray rig."
    },
    {
      "s": 16.18,
      "e": 21.34,
      "text": "Stage four is where the water spout becomes a visible funnel, and the life cycle ends with"
    },
    {
      "s": 21.34,
      "e": 23.84,
      "text": "stage five, where the water spout decays."
    }
  ],
