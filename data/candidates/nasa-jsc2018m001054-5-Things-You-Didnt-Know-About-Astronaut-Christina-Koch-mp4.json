    },
    {
      "s": 47.98,
      "e": 49.42,
      "text": "ACROSS THE COUNTRY."
    },
    {
      "s": 49.42,
      "e": 50.75,
      "text": "THE TRIP WAS FROM NORTH CAROLINA"
    },
    {
      "s": 50.75,
      "e": 52.62,
      "text": "TO MONTANA, AND I CAMPED"
    },
    {
      "s": 52.62,
      "e": 54.42,
      "text": "ALONG THE WAY BY MYSELF,"
    },
    {
      "s": 54.42,
      "e": 56.02,
      "text": "AND IT WAS A PHENOMENAL TRIP."
    },
    {
      "s": 56.02,
      "e": 57.16,
      "text": "UM, I LEARNED A LOT ABOUT"
    },
    {
      "s": 57.16,
      "e": 58.96,
      "text": "SELF-RELIANCE, PLANNING,"
    },
    {
      "s": 58.96,
      "e": 59.99,
      "text": "AND ALSO JUST ENJOYED"
    },
    {
      "s": 59.99,
      "e": 61.26,
      "text": "EVERY MINUTE OF KINDA"
    },
    {
      "s": 61.26,
      "e": 63.16,
      "text": "SEEIN' THE COUNTRY GO BY."
    },
    {
      "s": 63.16,
      "e": 64.73,
      "text": ">> FOUR."
    },
    {
      "s": 64.73,
      "e": 65.83,
      "text": ">> WHEN I WAS IN COLLEGE,"
    },
    {
      "s": 65.83,
      "e": 66.9,
      "text": "I WAS MAJORING IN PHYSICS,"
    },
    {
      "s": 66.9,
      "e": 68.47,
      "text": "AND I TOOK IT UPON MYSELF"
    },
    {
      "s": 68.47,
      "e": 70.0,
      "text": "TO BUILD A LIGHTNING MACHINE,"
    },
    {
      "s": 70.0,
      "e": 71.24,
      "text": "WHICH IS ALSO KNOWN AS"
    },
    {
      "s": 71.24,
      "e": 72.61,
      "text": "A TESLA COIL."
    },
    {
      "s": 72.61,
      "e": 73.51,
      "text": "IT'S THE DEVICE THAT WAS"
    },
    {
      "s": 73.51,
      "e": 75.14,
      "text": "INVENTED BY NIKOLAI TESLA,"
    },
    {
      "s": 75.14,
      "e": 76.34,
      "text": "AND IT PRODUCES ACTUAL"
    },
    {
      "s": 76.34,
      "e": 77.48,
      "text": "LIGHTNING STRIKES, UH,"
    },
    {
      "s": 77.48,
      "e": 78.91,
      "text": "THAT ARE FAIRLY LONG."
    },
    {
      "s": 78.91,
      "e": 80.65,
      "text": "AND I REMEMBER IT WAS"
    },
    {
      "s": 80.65,
      "e": 82.35,
      "text": "A SUMMER PROJECT FOR ME,"
    },
    {
      "s": 82.35,
      "e": 83.28,
      "text": "AND I INVITED A BUNCH OF"
    },
    {
      "s": 83.28,
      "e": 84.52,
      "text": "MY FRIENDS OVER IN COLLEGE"
    },
    {
      "s": 84.52,
      "e": 85.82,
      "text": "TO CHECK IT OUT, AND THEY WERE"
    },
    {
      "s": 85.82,
      "e": 87.19,
      "text": "ALL COMPLETELY BAFFLED"
    },
    {
      "s": 87.19,
      "e": 88.45,
      "text": "AT, ONE, HOW I DID IT,"
    },
    {
      "s": 88.45,
      "e": 89.92,
      "text": "WHY I CHOSE TO DO IT."
    },
    {
      "s": 89.92,
      "e": 91.19,
      "text": "UM, BUT AT THE SAME TIME,"
    },
    {
      "s": 91.19,
      "e": 92.56,
      "text": "I THINK THEY KNEW THAT IT WAS,"
    },
    {
      "s": 92.56,
      "e": 93.76,
      "text": "UH, NEAR AND DEAR TO MY HEART."
    },
    {
      "s": 93.76,
      "e": 95.46,
