    {
      "s": 128.36,
      "e": 129.23,
      "text": "THE FLORIDA COAST"
    },
    {
      "s": 129.23,
      "e": 130.53,
      "text": "AND TO BE A PART OF IT."
    },
    {
      "s": 132.6,
      "e": 134.9,
      "text": "YOU KNOW, MY LIFE PRIOR TO NASA,"
    },
    {
      "s": 134.9,
      "e": 135.97,
      "text": "UH, WAS, UH, INSIDE"
