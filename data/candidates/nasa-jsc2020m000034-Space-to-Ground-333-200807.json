  "transcript": [
    {
      "s": 3.02,
      "e": 4.82,
      "text": "\"HOUSTON, STATION ON SPACE TO GROUND.\""
    },
    {
      "s": 5.0,
      "e": 7.46,
      "text": "WELCOME TO SPACE TO GROUND, I\u00e2\u0080\u0099M ISIDRO REYNA."
    },
    {
      "s": 7.46,
      "e": 10.32,
      "text": "THIS WEEK, SPLASHDOWN IN THE GULF OF MEXICO."
    },
    {
      "s": 11.5,
      "e": 13.18,
      "text": "SPACEX\u00e2\u0080\u0099S CREW DRAGON,"
    },
    {
      "s": 13.19,
      "e": 15.07,
      "text": "CARRYING ROBERT BEHNKEN AND DOUGLAS HURLEY,"
    },
    {
      "s": 15.07,
      "e": 17.09,
      "text": "SPLASHED DOWN UNDER PARACHUTES OFF THE COAST"
    },
    {
      "s": 17.09,
      "e": 19.01,
      "text": "OF PENSACOLA, FLORIDA ON AUGUST 2ND,"
    },
    {
      "s": 19.01,
      "e": 21.57,
      "text": "AND WAS SUCCESSFULLY RECOVERED BY SPACEX."
    },
    {
      "s": 21.57,
      "e": 23.07,
      "text": "AFTER RETURNING TO SHORE,"
    },
    {
      "s": 23.07,
      "e": 24.85,
      "text": "THE ASTRONAUTS RETURNED TO HOUSTON"
    },
    {
      "s": 24.85,
      "e": 26.39,
      "text": "WHERE THEY WERE WELCOMED HOME BY FAMILY,"
    },
    {
      "s": 26.39,
      "e": 27.91,
      "text": "COLLEAGUES AND FRIENDS."
    },
    {
      "s": 27.91,
      "e": 29.28,
      "text": "THIS WAS THE FIRST SPLASHDOWN"
    },
    {
      "s": 29.28,
      "e": 32.19,
      "text": "OF AN AMERICAN CREW SPACECRAFT IN 45 YEARS."
    },
    {
      "s": 32.19,
      "e": 33.55,
      "text": "THE RETURN ON BEHNKEN AND HURLEY"
    },
    {
      "s": 33.55,
      "e": 35.25,
      "text": "FROM THE INTERNATIONAL SPACE STATION"
    },
    {
      "s": 35.25,
      "e": 37.87,
      "text": "COMPLETES THE FINAL TEST FLIGHT OF CREW DRAGON,"
    },
    {
      "s": 37.87,
      "e": 40.44,
      "text": "AND MARKS A NEW ERA IN HUMAN SPACEFLIGHT."
    },
    {
      "s": 41.12,
      "e": 42.38,
      "text": "BOB AND DOUG PARTICIPATED"
    },
    {
      "s": 42.38,
      "e": 44.7,
      "text": "IN A NUMBER OF SCIENTIFIC EXPERIMENTS,"
    },
    {
      "s": 44.7,
      "e": 47.06,
      "text": "SPACEWALKS AND PUBLIC ENGAGEMENT EVENTS"
    },
    {
      "s": 47.06,
      "e": 49.91,
      "text": "DURING THEIR STAY ABOARD STATION."
    },
    {
      "s": 49.91,
      "e": 52.84,
      "text": "THE ASTRONAUT DUO SPENT 64 DAYS IN ORBIT,"
    },
    {
      "s": 52.84,
      "e": 55.84,
      "text": "COMPLETED 1,024 ORBITS AROUND EARTH"
    },
    {
      "s": 55.85,
      "e": 61.41,
      "text": "AND TRAVELED 27,147,284 STATUTE MILES."
    },
    {
      "s": 61.41,
      "e": 63.23,
      "text": "THE ASTRONAUTS CONTRIBUTED MORE THAN"
    },
    {
      "s": 63.23,
      "e": 64.82,
      "text": "100 HOURS OF TIME TO SUPPORTING"
    },
    {
      "s": 64.82,
      "e": 67.64,
      "text": "THE ORBITING LABORATORY\u00e2\u0080\u0099S INVESTIGATIONS."
    },
    {
      "s": 67.64,
      "e": 68.98,
      "text": "\"I KNOW THAT ONE OF THE THINGS"
    },
    {
      "s": 68.98,
      "e": 70.63,
      "text": "THAT WE'RE MOST PROUD OF IS"
    },
    {
      "s": 70.63,
      "e": 72.67,
      "text": "BRINGING LAUNCH CAPABILITY BACK"
    },
    {
      "s": 72.67,
      "e": 73.81,
      "text": "TO THE FLORIDA COAST,"
    },
    {
      "s": 73.81,
      "e": 75.87,
      "text": "BACK TO AMERICA, AND OF COURSE,"
    },
    {
      "s": 75.87,
      "e": 78.29,
      "text": "LANDING SAFELY AT THE END OF ALL OF THAT.\""
    },
    {
      "s": 78.29,
      "e": 80.14,
      "text": "\"WE'RE ALMOST KIND OF SPEECHLESS"
    },
    {
      "s": 80.14,
      "e": 83.03,
      "text": "AS FAR AS HOW WELL THE VEHICLE DID"
    },
    {
      "s": 83.03,
      "e": 85.68,
      "text": "AND HOW, HOW WELL THE MISSION WENT."
    },
    {
      "s": 85.68,
      "e": 87.57,
      "text": "IT'S GREAT TO SEE HOW EXCITED"
    },
    {
      "s": 87.57,
      "e": 90.64,
      "text": "EVERYBODY WAS FOR OUR MISSION"
    },
    {
      "s": 90.64,
      "e": 92.37,
      "text": "AND FOLLOWED ALONG,"
    },
    {
      "s": 92.37,
      "e": 93.87,
      "text": "AND WE HOPE IT BRINGS A LITTLE BIT"
    },
    {
      "s": 93.87,
      "e": 95.8,
      "text": "OF BRIGHTNESS TO A PRETTY TOUGH 2020.\""
    },
    {
      "s": 96.81,
      "e": 98.56,
      "text": "THIS WEEK\u00e2\u0080\u0099S QUESTION COMES FROM PRATIK."
    },
    {
      "s": 98.56,
      "e": 100.43,
      "text": "HE WANTS TO KNOW WHAT BOB AND DOUG\u00e2\u0080\u0099S ROLE"
    },
    {
      "s": 100.43,
      "e": 102.12,
      "text": "WILL BE IN TRAINING CREW-1 AND CREW-2."
    },
    {
      "s": 103.06,
      "e": 104.56,
      "text": "NASA AND SPACEX ARE PREPARING FOR"
    },
    {
      "s": 104.56,
      "e": 106.25,
      "text": "THE COMPANY\u00e2\u0080\u0099S FIRST OPERATIONAL FLIGHT"
    },
    {
      "s": 106.25,
      "e": 107.68,
      "text": "OF THE CREW DRAGON SPACECRAFT"
    },
    {
      "s": 107.68,
      "e": 110.04,
      "text": "AND FALCON 9 ROCKET AFTER CERTIFICATION,"
    },
    {
      "s": 110.04,
      "e": 112.2,
      "text": "CARRYING NASA ASTRONAUTS VICTOR GLOVER,"
    },
    {
      "s": 112.2,
      "e": 114.12,
      "text": "MICHAEL HOPKINS, SHANNON WALKER"
    },
    {
      "s": 114.12,
      "e": 116.82,
      "text": "AND JAPAN AEROSPACE EXPLORATION AGENCY ASTRONAUT"
    },
    {
      "s": 116.82,
      "e": 119.21,
      "text": "SOICHI NOGUCHI TO THE INTERNATIONAL SPACE STATION"
    },
    {
      "s": 119.21,
      "e": 120.97,
      "text": "FOR A FULL DURATION MISSION."
    },
    {
      "s": 120.97,
      "e": 122.67,
      "text": "THE MISSION WILL BE THE SECOND TIME"
    },
    {
      "s": 122.67,
      "e": 125.0,
      "text": "SPACEX\u00e2\u0080\u0099S CREW DRAGON WILL FERRY ASTRONAUTS"
    },
    {
      "s": 125.0,
      "e": 126.26,
      "text": "TO THE SPACE STATION,"
    },
    {
      "s": 126.26,
      "e": 128.48,
      "text": "BUT THE FIRST IN A SERIES OF REGULAR,"
    },
    {
      "s": 128.48,
      "e": 130.04,
      "text": "ROTATIONAL MISSIONS."
    },
    {
      "s": 130.66,
      "e": 131.94,
      "text": "KEEP SENDING IN YOUR QUESTIONS"
    },
    {
      "s": 131.95,
      "e": 133.84,
      "text": "USING THE HASHTAG \u00e2\u0080\u009cASK NASA.\u00e2\u0080\u009d"
    },
    {
      "s": 133.84,
      "e": 135.18,
      "text": "WE\u00e2\u0080\u0099LL SEE YOU NEXT WEEK."
    },
    {
      "s": 140.62,
      "e": 141.6,
      "text": "\u00e2\u0080\u009cWE\u00e2\u0080\u0099RE COUNTING DOWN TO"
    },
    {
      "s": 141.6,
      "e": 143.89,
      "text": "20 CONTINUOUS YEARS OF HUMANS"
    },
    {
      "s": 143.89,
      "e": 146.36,
      "text": "ON THE INTERNATIONAL SPACE STATION."
    },
    {
      "s": 146.36,
      "e": 148.76,
      "text": "FOLLOW ALONG AT NASA.GOV.\u00e2\u0080\u009d"
    }
  ],
