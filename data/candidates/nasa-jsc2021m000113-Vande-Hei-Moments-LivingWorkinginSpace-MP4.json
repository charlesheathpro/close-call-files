    },
    {
      "s": 6.64,
      "e": 7.91,
      "text": ">> SO, ARRIVING"
    },
    {
      "s": 7.91,
      "e": 9.91,
      "text": "AT THE SPACE STATION,"
    },
    {
      "s": 9.91,
      "e": 11.14,
      "text": "SOMETHING I'LL NEVER FORGET"
    },
    {
      "s": 11.14,
      "e": 12.71,
      "text": "IS LOOKING OVER MY LEFT SHOULDER"
    },
    {
      "s": 12.71,
      "e": 14.45,
      "text": "OUT THE WINDOW IN THE SOYUZ,"
    },
    {
      "s": 14.45,
      "e": 15.85,
      "text": "WHERE IT WAS EITHER"
    },
    {
      "s": 15.85,
      "e": 17.02,
      "text": "A VIEW OF THE EARTH"
    },
    {
      "s": 17.02,
      "e": 18.95,
      "text": "OR BLACKNESS OF SPACE,"
    },
    {
      "s": 18.95,
      "e": 20.25,
      "text": "AND THEN, ALL OF A SUDDEN,"
    },
    {
      "s": 20.25,
      "e": 21.69,
      "text": "I COULD SEE A SOLAR ARRAY."
    },
    {
      "s": 21.69,
      "e": 22.22,
      "text": "GETTING CHILLS EVEN"
    },
    {
      "s": 22.22,
      "e": 23.02,
      "text": "THINKING ABOUT IT RIGHT NOW."
    },
    {
      "s": 23.02,
      "e": 23.79,
      "text": "IT WAS THIS BEAUTIFUL,"
    },
    {
      "s": 23.79,
      "e": 25.43,
      "text": "GOLD, MASSIVE--"
    },
    {
      "s": 25.43,
      "e": 27.53,
      "text": "I MEAN, YOU-YOU DON'T EVER TRAIN"
    },
    {
      "s": 27.53,
      "e": 28.86,
      "text": "AND SEE A SOLAR ARRAY"
    },
    {
      "s": 28.86,
      "e": 30.23,
      "text": "AT FULL SCALE HERE."
    },
    {
      "s": 30.23,
      "e": 31.53,
      "text": "AND SO THERE IT WAS,"
    },
    {
      "s": 31.53,
      "e": 32.5,
      "text": "AND THE RUSSIAN COMMANDER'S"
    },
    {
      "s": 32.5,
      "e": 33.93,
      "text": "SITTING TO MY RIGHT."
    },
    {
      "s": 33.93,
      "e": 34.53,
      "text": "HAD TO REALLY"
    },
    {
      "s": 34.53,
      "e": 35.44,
      "text": "PAY CLOSE ATTENTION,"
    },
    {
      "s": 35.44,
      "e": 36.7,
      "text": "AND I WAS SUPPOSED TO BE, TOO,"
    },
    {
      "s": 36.7,
      "e": 37.54,
      "text": "BUT AS SOON AS I SAW"
    },
    {
      "s": 37.54,
      "e": 38.37,
      "text": "THOSE SOLAR RAYS,"
    },
    {
      "s": 38.37,
      "e": 38.91,
      "text": "I BROKE THE SILENCE,"
    },
    {
      "s": 38.91,
      "e": 39.81,
      "text": "I SAID, \"WOW!\""
    },
    {
      "s": 39.81,
      "e": 41.44,
      "text": "AND HE WAS LIKE..."
    },
    {
      "s": 41.44,
      "e": 43.41,
      "text": "SO, SO, UH, YEAH, I WAS THEIR--"
    },
    {
      "s": 43.41,
      "e": 44.11,
      "text": "I WAS DEFINITELY A ROOKIE."
    },
    {
      "s": 44.11,
      "e": 45.08,
      "text": "I WAS EXCITED."
