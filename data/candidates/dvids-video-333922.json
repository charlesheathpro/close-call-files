    },
    {
      "s": 374.42,
      "e": 377.42,
      "text": "It was myself and my three daughters."
    },
    {
      "s": 377.42,
      "e": 380.63,
      "text": "Like a cowboy so."
    },
    {
      "s": 380.63,
