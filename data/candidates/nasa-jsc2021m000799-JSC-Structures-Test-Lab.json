  "transcript": [
    {
      "s": 5.44,
      "e": 15.55,
      "text": "[ MUSIC ]"
    },
    {
      "s": 15.55,
      "e": 16.92,
      "text": ">> THE STRUCTURES TEST LAB"
    },
    {
      "s": 16.92,
      "e": 18.15,
      "text": "IS LOCATED IN THE HIGH BAY"
    },
    {
      "s": 18.15,
      "e": 19.72,
      "text": "OF BUILDING 13."
    },
    {
      "s": 19.72,
      "e": 20.55,
      "text": "THE LAB IS DIVIDED"
    },
    {
      "s": 20.55,
      "e": 21.99,
      "text": "INTO TWO SECTIONS,"
    },
    {
      "s": 21.99,
      "e": 23.99,
      "text": "THE STATIC TEST SYSTEMS LAB,"
    },
    {
      "s": 23.99,
      "e": 25.93,
      "text": "AND THE VIBRATION LAB."
    },
    {
      "s": 25.93,
      "e": 27.56,
      "text": "THE STATIC TEST SYSTEMS LAB"
    },
    {
      "s": 27.56,
      "e": 29.0,
      "text": "USES VARIOUS MACHINES"
    },
    {
      "s": 29.0,
      "e": 30.43,
      "text": "SUCH AS LOAD FRAMES,"
    },
    {
      "s": 30.43,
      "e": 32.27,
      "text": "ACTUATORS, AND INSTRUMENTATION"
    },
    {
      "s": 32.27,
      "e": 33.17,
      "text": "TO TEST THE STRENGTH OF"
    },
    {
      "s": 33.17,
      "e": 34.37,
      "text": "SPACEFLIGHT HARDWARE"
    },
    {
      "s": 34.37,
      "e": 35.57,
      "text": "AND SYSTEMS."
    },
    {
      "s": 35.57,
      "e": 36.4,
      "text": "MATERIAL TESTS ARE"
    },
    {
      "s": 36.4,
      "e": 38.27,
      "text": "CONDUCTED TO INVESTIGATE."
    },
    {
      "s": 38.27,
      "e": 39.24,
      "text": "STRENGTH OF MATERIALS,"
    },
    {
      "s": 39.24,
      "e": 40.17,
      "text": "SUCH AS FATIGUE"
    },
    {
      "s": 40.17,
      "e": 41.54,
      "text": "AND YIELD POINTS,"
    },
    {
      "s": 41.54,
      "e": 42.61,
      "text": "CRACK GROWTH"
    },
    {
      "s": 42.61,
      "e": 43.94,
      "text": "FRACTURE INVESTIGATION"
    },
    {
      "s": 43.94,
      "e": 45.41,
      "text": "AND MATERIAL CREEP,"
    },
    {
      "s": 45.41,
      "e": 46.48,
      "text": "ULTIMATE STRENGTH,"
    },
    {
      "s": 46.48,
      "e": 48.01,
      "text": "AND MAXIMUM LOADS,"
    },
    {
      "s": 48.01,
      "e": 49.12,
      "text": "DEFORMATION,"
    },
    {
      "s": 49.12,
      "e": 50.08,
      "text": "LONG DURATION TESTS"
    },
    {
      "s": 50.08,
      "e": 51.72,
      "text": "ON ITEMS, FOR EXAMPLE,"
    },
    {
      "s": 51.72,
      "e": 54.39,
      "text": "ISS AND ORION WINDOW TESTS."
    },
    {
      "s": 54.39,
      "e": 55.29,
      "text": "THE VIBRATION LAB"
    },
    {
      "s": 55.29,
      "e": 56.39,
      "text": "HAS A TOTAL OF SIX"
    },
    {
      "s": 56.39,
      "e": 58.26,
      "text": "SEPARATE SHAKER SYSTEMS"
    },
    {
      "s": 58.26,
      "e": 58.79,
      "text": "THAT ARE USED TO"
    },
    {
      "s": 58.79,
      "e": 60.69,
      "text": "SIMULATE THE EXTREME LOADS"
    },
    {
      "s": 60.69,
      "e": 61.73,
      "text": "PLACED ON SPACEFLIGHT"
    },
    {
      "s": 61.73,
      "e": 63.2,
      "text": "HARDWARE DURING LAUNCH"
    },
    {
      "s": 63.2,
      "e": 65.06,
      "text": "AND LANDING ENVIRONMENTS."
    },
    {
      "s": 65.06,
      "e": 66.0,
      "text": "THE VIBRATION LAB"
    },
    {
      "s": 66.0,
      "e": 66.73,
      "text": "HAS EQUIPMENT THAT"
    },
    {
      "s": 66.73,
      "e": 68.13,
      "text": "CAN HANDLE TEST ARTICLES"
    },
    {
      "s": 68.13,
      "e": 70.37,
      "text": "AS LARGE AS 2,000 POUNDS,"
    },
    {
      "s": 70.37,
      "e": 71.6,
      "text": "AND CAN REACH A MAX LEVEL"
    },
    {
      "s": 71.6,
      "e": 74.51,
      "text": "OF 73 Gs IF REQUIRED."
    },
    {
      "s": 74.51,
      "e": 75.74,
      "text": "THE VIBRATION LAB ALSO"
    },
    {
      "s": 75.74,
      "e": 76.94,
      "text": "HAS THE CAPABILITY TO"
    },
    {
      "s": 76.94,
      "e": 78.04,
      "text": "PERFORM TESTING WITH"
    },
    {
      "s": 78.04,
      "e": 79.55,
      "text": "A HUMAN IN THE LOOP,"
    },
    {
      "s": 79.55,
      "e": 80.75,
      "text": "WHEN CALLED UPON TO USE"
    },
    {
      "s": 80.75,
      "e": 81.61,
      "text": "THE HUMAN-RATED"
    },
    {
      "s": 81.61,
      "e": 83.42,
      "text": "VIBRATION TEST POINT."
    },
    {
      "s": 83.42,
      "e": 84.95,
      "text": "THE VIBRATION LAB ALSO HAS"
    },
    {
      "s": 84.95,
      "e": 86.49,
      "text": "CONTROLLED WORK AREAS,"
    },
    {
      "s": 86.49,
      "e": 87.45,
      "text": "WHICH CAN BE USED WHEN"
    },
    {
      "s": 87.45,
      "e": 88.82,
      "text": "THE TEST ARTICLES REQUIRE"
    },
    {
      "s": 88.82,
      "e": 90.29,
      "text": "A HIGHER LEVEL OF CLEANLINESS"
    },
    {
      "s": 90.29,
      "e": 92.12,
      "text": "DURING TESTING."
    },
    {
      "s": 92.12,
      "e": 93.56,
      "text": "THE STL IS STAFFED BY"
    },
    {
      "s": 93.56,
      "e": 95.03,
      "text": "A TEAM OF HIGHLY SKILLED"
    },
    {
      "s": 95.03,
      "e": 96.0,
      "text": "AND EXPERIENCED TEAM"
    },
    {
      "s": 96.0,
      "e": 98.26,
      "text": "OF ENGINEERS AND TECHNICIANS,"
    },
    {
      "s": 98.26,
      "e": 99.47,
      "text": "WHO MAINTAIN CERTIFICATIONS"
    },
    {
      "s": 99.47,
      "e": 100.23,
      "text": "IN BOTH STATIC"
    },
    {
      "s": 100.23,
      "e": 102.0,
      "text": "AND DYNAMIC TEST SYSTEMS,"
    },
    {
      "s": 102.0,
      "e": 103.44,
      "text": "AS WELL AS INSTRUMENTATION"
    },
    {
      "s": 103.44,
      "e": 105.57,
      "text": "AND DATA ACQUISITION."
    }
  ],
