  "transcript": [
    {
      "s": 67.54,
      "e": 82.13,
      "text": "Staff Sergeant Ethan Chandler with the 137th Security Forces Squadron."
    },
    {
      "s": 82.13,
      "e": 90.0,
      "text": "Right now we're working in two shifts of 11 personnel per shift."
    },
    {
      "s": 90.0,
      "e": 94.0,
      "text": "So far we've been working as entry controllers for the disaster area"
    },
    {
      "s": 94.0,
      "e": 99.5,
      "text": "as well as working traffic control at major intersections."
    },
    {
      "s": 99.5,
      "e": 103.5,
      "text": "We expect to be out here until late in the evening tonight and then"
    },
    {
      "s": 103.5,
      "e": 109.14,
      "text": "we'll be back in here, be back out here for the next couple days."
    },
    {
      "s": 109.14,
      "e": 113.14,
      "text": "Your guys are home, Sambaw, and we're going to..."
    },
    {
      "s": 113.14,
      "e": 117.14,
      "text": "We have one member who's had some family members homes that were destroyed."
    },
    {
      "s": 117.14,
      "e": 121.14,
      "text": "The family members are safe,"
    },
    {
      "s": 121.14,
      "e": 188.53,
      "text": "yes, they just lost their home."
    }
