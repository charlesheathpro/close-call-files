      "text": "[ MUSIC ]"
    },
    {
      "s": 21.49,
      "e": 23.16,
      "text": ">> HI, I'M LANCE FOSTER."
    },
    {
      "s": 23.16,
      "e": 24.72,
      "text": "I'M AN ENGINEER AT NASA,"
    },
    {
      "s": 24.72,
      "e": 25.79,
      "text": "AND WELCOME TO THE NASA"
    },
    {
      "s": 25.79,
      "e": 27.59,
      "text": "ENGINEERING DESIGN CHALLENGE"
    },
    {
      "s": 27.59,
      "e": 30.0,
      "text": "\"PARACHUTING ONTO MARS.\""
    },
    {
      "s": 30.0,
      "e": 31.8,
      "text": "HAVE YOU EVER TRAVELED IN A CAR"
    },
    {
      "s": 31.8,
      "e": 33.53,
      "text": "AND SUDDENLY HAD TO STOP?"
    },
    {
      "s": 33.53,
      "e": 34.53,
      "text": "NOW IMAGINE YOU'RE IN"
    },
    {
      "s": 34.53,
      "e": 36.0,
      "text": "A SPACECRAFT TRAVELING"
    },
    {
      "s": 36.0,
      "e": 38.44,
      "text": "13,000 MILES PER HOUR,"
    },
    {
      "s": 38.44,
      "e": 39.81,
      "text": "AND YOU ONLY HAVE 7 MINUTES"
    },
    {
      "s": 39.81,
      "e": 41.44,
      "text": "TO SLOW DOWN AND SAFELY LAND"
    },
    {
      "s": 41.44,
      "e": 42.58,
      "text": "YOUR VEHICLE ON THE SURFACE"
    },
    {
      "s": 42.58,
      "e": 45.04,
      "text": "OF A PLANET SUCH AS MARS."
    },
    {
      "s": 45.04,
      "e": 46.51,
      "text": "TO DO THIS, YOU FIRST"
    },
    {
      "s": 46.51,
      "e": 48.08,
      "text": "HAVE TO UNDERSTAND THE CONCEPT"
    },
    {
      "s": 48.08,
      "e": 49.95,
      "text": "OF DRAG AND THE EFFECT IT HAS"
    },
    {
      "s": 49.95,
      "e": 51.02,
      "text": "ON AN OBJECT TRAVELING"
    },
    {
      "s": 51.02,
      "e": 52.59,
      "text": "THROUGH SPACE."
    },
    {
      "s": 52.59,
      "e": 54.89,
      "text": "DRAG IS A FORCE THAT OPPOSES"
    },
    {
      "s": 54.89,
      "e": 56.79,
      "text": "AN OBJECT'S MOTION THROUGH AIR."
    },
    {
      "s": 56.79,
      "e": 59.49,
      "text": "FOR EXAMPLE, AS A SPACECRAFT"
    },
    {
      "s": 59.49,
      "e": 61.13,
      "text": "LIKE THIS ONE ACCELERATES,"
    },
    {
      "s": 61.13,
      "e": 62.76,
      "text": "THE SURROUNDING AIR PUSHES"
    },
    {
      "s": 62.76,
      "e": 64.93,
      "text": "AGAINST IT, CREATING RESISTANCE."
    },
    {
      "s": 64.93,
      "e": 66.5,
      "text": "HOWEVER, TO SLOW THE VEHICLE"
    },
    {
      "s": 66.5,
      "e": 67.43,
      "text": "DOWN ENOUGH TO MAKE"
    },
    {
      "s": 67.43,
      "e": 69.8,
      "text": "A SAFE LANDING, A DECELERATOR"
    },
    {
      "s": 69.8,
      "e": 71.67,
      "text": "OR DRAG DEVICE SERVES"
    },
    {
      "s": 71.67,
      "e": 72.74,
      "text": "AS A BRAKING SYSTEM"
    },
    {
      "s": 72.74,
      "e": 73.87,
      "text": "FOR THE VEHICLE."
    },
    {
      "s": 73.87,
      "e": 75.31,
      "text": "THAT'S THE CHALLENGE NASA FACES"
    },
    {
      "s": 75.31,
      "e": 77.04,
      "text": "EVERY TIME IT LANDS A SPACECRAFT"
    },
    {
      "s": 77.04,
      "e": 78.61,
      "text": "ON ANOTHER PLANET."
    },
    {
      "s": 78.61,
      "e": 80.41,
      "text": "AND AS WE PLAN MORE ADVANCED"
    },
    {
      "s": 80.41,
      "e": 81.65,
      "text": "ROBOTIC MISSIONS AND"
    },
    {
      "s": 81.65,
      "e": 83.35,
      "text": "HUMAN EXPEDITIONS TO PLANETS"
    },
    {
      "s": 83.35,
      "e": 84.32,
      "text": "FURTHER OUT INTO OUR"
    },
    {
      "s": 84.32,
      "e": 86.15,
      "text": "SOLAR SYSTEM, WE'LL NEED TO LAND"
    },
    {
      "s": 86.15,
      "e": 88.22,
      "text": "EVEN HEAVIER SPACECRAFT."
    },
    {
      "s": 88.22,
      "e": 90.36,
      "text": "THIS WILL REQUIRE MORE POWERFUL"
    },
    {
      "s": 90.36,
      "e": 91.99,
      "text": "YET LIGHTWEIGHT DECELERATORS,"
    },
    {
      "s": 91.99,
      "e": 94.49,
      "text": "OR BRAKING SYSTEMS."
    },
    {
      "s": 94.49,
      "e": 96.16,
      "text": "NEXT UP IS NASA ENGINEER"
    },
    {
      "s": 96.16,
      "e": 97.06,
      "text": "CHRIS TANNER FROM"
    },
    {
      "s": 97.06,
      "e": 98.56,
      "text": "THE JET PROPULSION LABORATORY"
    },
    {
      "s": 98.56,
      "e": 99.53,
      "text": "TO TELL US MORE ABOUT"
    },
    {
      "s": 99.53,
      "e": 101.23,
      "text": "A CHALLENGE THAT NASA HAS"
    },
    {
      "s": 101.23,
      "e": 103.3,
      "text": "FOR YOU."
    },
    {
      "s": 103.3,
      "e": 104.67,
      "text": ">> HI, MY NAME'S CHRIS TANNER,"
    },
    {
      "s": 104.67,
      "e": 105.64,
      "text": "AND I'M A MECHANICAL ENGINEER"
    },
    {
      "s": 105.64,
      "e": 106.44,
      "text": "AT THE JET PROPULSION"
    },
    {
      "s": 106.44,
      "e": 107.57,
      "text": "LABORATORY."
    },
    {
      "s": 107.57,
      "e": 108.74,
      "text": "HERE I DO WIND TUNNEL TESTING"
    },
    {
      "s": 108.74,
      "e": 110.01,
      "text": "OF PARACHUTES FOR EVENTUAL USE"
    },
    {
      "s": 110.01,
      "e": 111.44,
      "text": "AT MARS."
    },
    {
      "s": 111.44,
      "e": 112.41,
      "text": "NASA'S BEEN TRAVELING TO MARS"
    },
    {
      "s": 112.41,
      "e": 113.55,
      "text": "FOR OVER 40 YEARS,"
    },
    {
      "s": 113.55,
      "e": 114.41,
      "text": "AND WITH EVERY SPACECRAFT,"
    },
    {
      "s": 114.41,
      "e": 115.88,
      "text": "WE SEND BIGGER, HEAVIER,"
    },
    {
      "s": 115.88,
      "e": 117.65,
      "text": "AND MORE COMPLEX ROBOTS."
    },
    {
      "s": 117.65,
      "e": 118.42,
      "text": "HOWEVER, THE HEAVIER"
    },
    {
      "s": 118.42,
      "e": 119.42,
      "text": "THE SPACECRAFT, THE MORE"
    },
    {
      "s": 119.42,
      "e": 120.15,
      "text": "DIFFICULT IT BECOMES TO"
    },
    {
      "s": 120.15,
      "e": 122.36,
      "text": "SLOW DOWN ONCE IT GETS TO MARS."
    },
    {
      "s": 122.36,
      "e": 123.32,
      "text": "AND WHEN A SPACECRAFT LANDS"
    },
    {
      "s": 123.32,
      "e": 124.82,
      "text": "ON MARS, IT ONLY HAS 7 MINUTES"
    },
    {
      "s": 124.82,
      "e": 126.49,
      "text": "TO DECELERATE OR SLOW DOWN"
    },
    {
      "s": 126.49,
      "e": 128.53,
      "text": "FROM 13,000 MILES PER HOUR"
    },
    {
      "s": 128.53,
      "e": 129.86,
      "text": "TO 0 MILES PER HOUR."
    },
    {
      "s": 129.86,
      "e": 131.16,
      "text": "AND THAT'S REALLY HARD TO DO."
    },
    {
      "s": 131.16,
      "e": 132.2,
      "text": "UP UNTIL NOW, WE USED"
    },
    {
      "s": 132.2,
      "e": 133.47,
      "text": "A VARIETY OF DIFFERENT SYSTEMS"
    },
    {
      "s": 133.47,
      "e": 135.24,
      "text": "TO DECELERATE OUR SPACECRAFT,"
    },
    {
      "s": 135.24,
      "e": 137.04,
      "text": "FROM AIRBAGS TO RETRO ROCKETS,"
    },
    {
      "s": 137.04,
      "e": 138.74,
      "text": "TO SUPERSONIC PARACHUTES."
    },
    {
      "s": 138.74,
      "e": 139.47,
      "text": "HOWEVER, WE'RE GONNA NEED"
    },
    {
      "s": 139.47,
      "e": 140.54,
      "text": "SOMETHING BIGGER AND BETTER"
    },
    {
      "s": 140.54,
      "e": 141.21,
      "text": "TO EVENTUALLY LAND"
    },
    {
      "s": 141.21,
      "e": 143.81,
      "text": "LARGER ROBOTS OR HUMANS ON MARS."
    },
    {
      "s": 143.81,
      "e": 144.84,
      "text": "NASA'S CURRENTLY WORKING ON"
    },
    {
      "s": 144.84,
      "e": 146.51,
      "text": "NEW LIGHTWEIGHT DECELERATOR"
    },
    {
      "s": 146.51,
      "e": 147.81,
      "text": "SYSTEMS TO HELP US SLOW DOWN"
    },
    {
      "s": 147.81,
      "e": 149.05,
      "text": "MORE QUICKLY."
    },
    {
      "s": 149.05,
      "e": 150.25,
      "text": "ONE COMPONENT OF THAT IS CALLED"
    },
    {
      "s": 150.25,
      "e": 151.45,
      "text": "A SUPERSONIC INFLATABLE"
    },
    {
      "s": 151.45,
      "e": 152.82,
      "text": "AERODYNAMIC DECELERATOR,"
    },
    {
      "s": 152.82,
      "e": 154.35,
      "text": "OR SIAD FOR SHORT."
    },
    {
      "s": 154.35,
      "e": 155.95,
      "text": "THIS DEVICE INFLATES AROUND"
    },
    {
      "s": 155.95,
      "e": 157.09,
      "text": "THE ENTRY VEHICLE"
    },
    {
      "s": 157.09,
      "e": 158.79,
      "text": "AT HIGH SUPERSONIC SPEEDS"
    },
    {
      "s": 158.79,
      "e": 160.06,
      "text": "ABOUT FOUR TIMES THE SPEED"
    },
    {
      "s": 160.06,
      "e": 161.63,
      "text": "OF SOUND, MAKING THE VEHICLE"
    },
    {
      "s": 161.63,
      "e": 163.06,
      "text": "LARGER, CREATING MORE DRAG"
    },
    {
      "s": 163.06,
      "e": 164.03,
      "text": "AND HELPING IT SLOW DOWN"
    },
    {
      "s": 164.03,
      "e": 165.7,
      "text": "EVEN QUICKER."
    },
    {
      "s": 165.7,
      "e": 166.5,
      "text": "ANOTHER COMPONENT OF"
    },
    {
      "s": 166.5,
      "e": 167.97,
      "text": "THE SYSTEM IS A LARGER AND"
    },
    {
      "s": 167.97,
      "e": 169.57,
      "text": "HIGHER PERFORMANCE PARACHUTE."
    },
    {
      "s": 169.57,
      "e": 170.9,
      "text": "NOW, PREVIOUSLY, THE LARGEST"
    },
    {
      "s": 170.9,
      "e": 172.17,
      "text": "PARACHUTE EVER FLOWN ON MARS"
    },
    {
      "s": 172.17,
      "e": 173.97,
      "text": "MEASURED 71 FEET IN DIAMETER"
    },
    {
      "s": 173.97,
      "e": 174.84,
      "text": "AND WAS USED TO LAND"
    },
    {
      "s": 174.84,
      "e": 175.94,
      "text": "THE CURIOSITY ROVER"
    },
    {
      "s": 175.94,
      "e": 178.04,
      "text": "IN AUGUST OF 2012."
    },
    {
      "s": 178.04,
      "e": 179.41,
      "text": "OUR NEW PARACHUTE MEASURES"
    },
    {
      "s": 179.41,
      "e": 181.05,
      "text": "100 FEET IN DIAMETER, WHICH IS"
    },
    {
      "s": 181.05,
      "e": 182.08,
      "text": "ABOUT THE SAME SIZE"
    },
    {
      "s": 182.08,
      "e": 183.22,
      "text": "AS A BIG RIG TRUCK THAT"
    },
    {
      "s": 183.22,
      "e": 185.18,
      "text": "YOU'D SEE ON THE ROAD."
    },
    {
      "s": 185.18,
      "e": 185.78,
      "text": "THIS NEW PARACHUTE WILL ALSO"
    },
    {
      "s": 185.78,
      "e": 187.19,
      "text": "FLY AROUND MACH 2."
    },
    {
      "s": 187.19,
      "e": 187.92,
      "text": "NOW, CAN YOU IMAGINE"
    },
    {
      "s": 187.92,
      "e": 189.52,
      "text": "A BIG RIG TRUCK FLYING AT"
    },
    {
      "s": 189.52,
      "e": 191.59,
      "text": "TWO TIMES THE SPEED OF SOUND?"
    },
    {
      "s": 191.59,
      "e": 192.49,
      "text": "THESE ARE THE KIND OF PROBLEMS"
    },
    {
      "s": 192.49,
      "e": 193.39,
      "text": "THAT WE WORK ON HERE AT"
    },
    {
      "s": 193.39,
      "e": 195.23,
      "text": "THE JET PROPULSION LABORATORY."
    },
    {
      "s": 195.23,
      "e": 196.66,
      "text": "NOW, YOUR CHALLENGE TODAY IS"
    },
    {
      "s": 196.66,
      "e": 198.1,
      "text": "TO DESIGN A DECELERATOR SYSTEM"
    },
    {
      "s": 198.1,
      "e": 199.63,
      "text": "TO SLOW DOWN YOUR SPACECRAFT."
    },
    {
      "s": 199.63,
      "e": 200.47,
      "text": "NOW, THERE'S A LOT"
    },
    {
      "s": 200.47,
      "e": 201.8,
      "text": "TO TAKE INTO CONSIDERATION."
    },
    {
      "s": 201.8,
      "e": 203.34,
      "text": "IN PARTICULAR, HOW DO YOU MAKE"
    },
    {
      "s": 203.34,
      "e": 204.87,
      "text": "YOUR DECELERATOR BOTH LARGE"
    },
    {
      "s": 204.87,
      "e": 206.2,
      "text": "TO CREATE A LOT OF DRAG,"
    },
    {
      "s": 206.2,
      "e": 207.14,
      "text": "AND ALSO LIGHTWEIGHT,"
    },
    {
      "s": 207.14,
      "e": 207.84,
      "text": "SO IT DOESN'T WEIGH DOWN"
    },
    {
      "s": 207.84,
      "e": 209.51,
      "text": "YOUR SPACECRAFT?"
    },
    {
      "s": 209.51,
      "e": 210.18,
      "text": "NOW, START THINKING ABOUT"
    },
    {
      "s": 210.18,
      "e": 210.88,
      "text": "WHAT SPECIAL FEATURES"
    },
    {
      "s": 210.88,
      "e": 212.55,
      "text": "YOU WANT TO USE ON YOUR SYSTEM."
    },
    {
      "s": 212.55,
      "e": 213.31,
      "text": "AND WE CAN'T WAIT TO SEE"
    },
    {
      "s": 213.31,
      "e": 214.48,
      "text": "THE SUGGESTIONS YOU HAVE FOR"
    },
    {
      "s": 214.48,
      "e": 216.52,
      "text": "OUR NEXT TRIP TO MARS."
    },
    {
      "s": 216.52,
      "e": 217.82,
      "text": ">> THANKS, CHRIS."
    },
    {
      "s": 217.82,
      "e": 219.38,
      "text": "NOW, HERE'S YOUR ASSIGNMENT."
    },
    {
      "s": 219.38,
      "e": 221.09,
      "text": "DESIGN AND BUILD A DRAG DEVICE"
    },
    {
      "s": 221.09,
      "e": 222.35,
      "text": "THAT WILL HELP SLOW DOWN"
    },
    {
      "s": 222.35,
      "e": 225.09,
      "text": "AND SAFELY LAND YOUR SPACECRAFT."
    },
    {
      "s": 225.09,
      "e": 227.09,
      "text": "EACH OF YOUR TEAMS MUST:"
    },
    {
      "s": 227.09,
      "e": 228.36,
      "text": "CONNECT YOUR DRAG DEVICE"
    },
    {
      "s": 228.36,
      "e": 230.03,
      "text": "TO A TEAM-BUILT CARGO BAY"
    },
    {
      "s": 230.03,
      "e": 231.1,
      "text": "THAT IS ASSEMBLED USING"
    },
    {
      "s": 231.1,
      "e": 232.06,
      "text": "THE TEMPLATE PROVIDED IN"
    },
    {
      "s": 232.06,
      "e": 233.47,
      "text": "YOUR GUIDE."
    },
    {
      "s": 233.47,
      "e": 235.23,
      "text": "DEPLOY YOUR ENTIRE DEVICE"
    },
    {
      "s": 235.23,
      "e": 236.94,
      "text": "FROM TWO METERS."
    },
    {
      "s": 236.94,
      "e": 237.97,
      "text": "IT MUST REMAIN INTACT"
    },
    {
      "s": 237.97,
      "e": 239.5,
      "text": "THROUGHOUT THE DROP."
    },
    {
      "s": 239.5,
      "e": 240.97,
      "text": "CREATE A CARGO BAY THAT"
    },
    {
      "s": 240.97,
      "e": 243.41,
      "text": "MUST HOLD 10 GRAMS."
    },
    {
      "s": 243.41,
      "e": 245.34,
      "text": "AND MAKE SURE THE OVERALL"
    },
    {
      "s": 245.34,
      "e": 246.95,
      "text": "MASS OF YOUR DRAG DEVICE"
    },
    {
      "s": 246.95,
      "e": 249.45,
      "text": "DOES NOT EXCEED 50 GRAMS."
    },
    {
      "s": 249.45,
      "e": 250.45,
      "text": "USE THE ENGINEERING DESIGN"
    },
    {
      "s": 250.45,
      "e": 251.42,
      "text": "PROCESS TO HELP YOU"
    },
    {
      "s": 251.42,
      "e": 252.59,
      "text": "CREATE A SOLUTION."
    },
    {
      "s": 252.59,
      "e": 254.69,
      "text": "KEEP IN MIND, YOUR DESIGN"
    },
    {
      "s": 254.69,
      "e": 256.49,
      "text": "MAY NOT WORK AS EXPECTED."
    },
    {
      "s": 256.49,
      "e": 257.42,
      "text": "YOU MAY HAVE TO PERFORM"
    },
    {
      "s": 257.42,
      "e": 258.59,
      "text": "MULTIPLE TESTS AND MAKE"
    },
    {
      "s": 258.59,
      "e": 260.59,
      "text": "ADJUSTMENTS, BUT THAT'S OKAY."
    },
    {
      "s": 260.59,
      "e": 261.49,
      "text": "IT'S ALL PART OF"
    },
    {
      "s": 261.49,
      "e": 263.56,
      "text": "THE ENGINEERING DESIGN PROCESS."
    },
    {
      "s": 263.56,
      "e": 264.93,
      "text": "NOW, IT'S YOUR TURN"
    },
    {
      "s": 264.93,
      "e": 266.17,
      "text": "TO GET TO WORK."
    },
    {
      "s": 266.17,
      "e": 268.53,
      "text": "AND BY ALL MEANS, BE CREATIVE."
    },
    {
      "s": 268.53,
      "e": 270.1,
      "text": "I'M EXCITED TO SEE THE DESIGNS"
    },
    {
      "s": 270.1,
      "e": 271.8,
      "text": "THAT YOUR TEAMS CREATE."
    },
    {
      "s": 271.8,
      "e": 272.64,
      "text": "GOOD LUCK."
    },
    {
      "s": 272.64,
      "e": 280.71,
