      "s": 160.86,
      "e": 162.09,
      "text": "AIR FORCE ENVIRONMENT, UM,"
    },
    {
      "s": 162.09,
      "e": 163.63,
      "text": "FLIGHT TEST ENVIRONMENT,"
    },
    {
      "s": 163.63,
      "e": 164.96,
      "text": "THERE'S ALWAYS A-A BALANCE"
