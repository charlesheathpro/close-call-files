    },
    {
      "s": 72.04,
      "e": 74.21,
      "text": "ON THE WAY TO MARS, JESSICA,"
    },
    {
      "s": 74.21,
      "e": 77.11,
      "text": "THAT, UH, UH, THAT EDUCATION,"
    },
    {
      "s": 77.11,
      "e": 78.24,
      "text": "I THINK YOU'RE GOING TO GET"
    },
    {
      "s": 78.24,
      "e": 79.65,
      "text": "ON THE MOON"
    },
    {
      "s": 79.65,
      "e": 81.41,
      "text": "WILL BE VERY RELEVANT TO MARS."
    },
    {
      "s": 81.41,
      "e": 82.38,
      "text": "BUT MARS, OF COURSE,"
    },
    {
      "s": 82.38,
      "e": 84.42,
      "text": "DOES NOT HAVE THAT"
    },
    {
      "s": 84.42,
      "e": 85.39,
      "text": "MICROMETEORITE"
    },
    {
      "s": 85.39,
      "e": 86.65,
      "text": "IMPACT ENVIRONMENT"
    },
    {
      "s": 86.65,
      "e": 87.59,
      "text": "THAT WE HAVE ON THE MOON,"
    },
    {
      "s": 87.59,
      "e": 88.56,
      "text": "'CAUSE IT HAS"
    },
    {
      "s": 88.56,
      "e": 89.72,
      "text": "A SMALL ATMOSPHERE."
    },
    {
      "s": 89.72,
      "e": 90.36,
      "text": ">> MM-HMM."
    },
    {
      "s": 90.36,
      "e": 91.06,
      "text": ">> ABOUT A HUNDREDTH OF THAT"
    },
    {
      "s": 91.06,
      "e": 92.12,
      "text": "OF THE EARTH."
    },
    {
      "s": 92.12,
      "e": 93.03,
      "text": "AND THAT FILTERS OUT"
    },
    {
      "s": 93.03,
      "e": 94.16,
      "text": "THE SMALL IMPACT."
    },
    {
      "s": 94.16,
      "e": 95.8,
      "text": "THE MAIN WEATHERING PROCESS"
    },
    {
      "s": 95.8,
      "e": 96.5,
      "text": "ON THE MOON"
    },
    {
      "s": 96.5,
      "e": 97.9,
      "text": "ARE THESE MICROMETEORITE IMPACTS"
    },
    {
      "s": 97.9,
      "e": 100.07,
      "text": "AND SOLAR WIND SPALLATION"
    },
    {
      "s": 100.07,
      "e": 101.0,
      "text": "OF THE SURFACE."
    },
    {
      "s": 101.0,
      "e": 102.07,
      "text": "SOLAR WIND IS MADE UP"
    },
    {
      "s": 102.07,
      "e": 103.47,
      "text": "OF HIGH-ENERGY PARTICLES."
    },
    {
      "s": 103.47,
      "e": 105.41,
      "text": "SO, THEY ACTUALLY ERODE, UH,"
    },
    {
      "s": 105.41,
      "e": 106.67,
      "text": "THE SURFACES OF ROCKS,"
    },
    {
      "s": 106.67,
      "e": 108.24,
      "text": "AS WELL AS, UH,"
    },
    {
      "s": 108.24,
      "e": 110.04,
      "text": "CHANGE THE CHARACTER"
    },
    {
      "s": 110.04,
      "e": 111.81,
      "text": "OF THE DEBRIS LAYER ON THE MOON."
    },
    {
      "s": 111.81,
      "e": 112.71,
      "text": ">> MM-HMM."
    },
    {
      "s": 112.71,
      "e": 113.78,
      "text": ">> ON MARS, THE DOMINANT"
    },
    {
      "s": 113.78,
      "e": 115.25,
      "text": "CORROSIVE FORCE IS WIND."
    },
    {
      "s": 115.25,
      "e": 116.18,
      "text": ">> WIND, YEP."
    },
    {
      "s": 116.18,
      "e": 117.05,
      "text": ">> AND SO YOU'RE GONNA --"
    },
    {
      "s": 117.05,
      "e": 119.19,
      "text": "IF YOU'RE USED TO STUDYING"
    },
    {
      "s": 119.19,
      "e": 120.85,
      "text": "GEO-MORPHOLOGY HERE ON EARTH,"
    },
    {
      "s": 120.85,
      "e": 121.79,
      "text": "AND IT INVOLVES WIND --"
    },
    {
      "s": 121.79,
      "e": 122.79,
      "text": ">> Y-YOU'RE IN GOOD SHAPE, YEAH."
    },
    {
      "s": 122.79,
      "e": 124.26,
      "text": ">> YOU CAN LEARN A LOT --"
    },
    {
      "s": 124.26,
      "e": 124.82,
      "text": ">> RIGHT."
    },
    {
      "s": 124.82,
      "e": 125.59,
      "text": ">> ABOUT WHAT-WHAT"
    },
    {
      "s": 125.59,
      "e": 127.06,
      "text": "YOU'RE GOING TO SEE ON MARS."
    },
    {
      "s": 127.06,
      "e": 127.93,
      "text": "BUT ALL OF THAT COMES THAT --"
    },
    {
      "s": 127.93,
      "e": 129.0,
      "text": "FROM STUDYING THE MOON."
    },
    {
      "s": 129.0,
      "e": 129.73,
      "text": ">> RIGHT."
    },
    {
      "s": 129.73,
      "e": 130.73,
      "text": ">> IF WE HADN'T HAD THE MOON,"
    },
    {
      "s": 130.73,
      "e": 131.9,
      "text": "WE WOULDN'T UNDERSTAND,"
    },
    {
      "s": 131.9,
      "e": 132.4,
      "text": "NECESSARILY,"
    },
    {
      "s": 132.4,
      "e": 133.2,
