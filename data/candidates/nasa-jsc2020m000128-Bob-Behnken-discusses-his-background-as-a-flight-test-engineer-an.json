    },
    {
      "s": 112.28,
      "e": 113.35,
      "text": "WHEN WE GOT TO LAUNCH AGAIN"
    },
    {
      "s": 113.35,
      "e": 114.88,
      "text": "FROM, UH, THE FLORIDA COAST."
    },
    {
      "s": 114.88,
      "e": 116.25,
      "text": "AND SO I'M JUST, UH,"
