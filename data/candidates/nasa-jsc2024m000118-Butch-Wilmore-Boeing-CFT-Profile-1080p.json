  "transcript": [
    {
      "s": 0.47,
      "e": 1.6,
      "text": "A LARGE PART OF THE"
    },
    {
      "s": 1.6,
      "e": 2.77,
      "text": "DESIRE WITHIN US"
    },
    {
      "s": 2.77,
      "e": 5.54,
      "text": "IS TO DO THINGS THAT ARE OF BENEFIT"
    },
    {
      "s": 5.54,
      "e": 6.24,
      "text": "TO OTHERS."
    },
    {
      "s": 6.24,
      "e": 6.91,
      "text": "IN THIS JOB,"
    },
    {
      "s": 6.91,
      "e": 8.61,
      "text": "WE GET TO DO THINGS THAT ARE FOR BENEFIT,"
    },
    {
      "s": 8.61,
      "e": 10.18,
      "text": "TRULY FOR ALL MANKIND."
    },
    {
      "s": 10.18,
      "e": 11.38,
      "text": "AS WE EXPLORE THE HEAVENS"
    },
    {
      "s": 11.38,
      "e": 13.58,
      "text": "THAT NOT MANY PEOPLE GET TO EXPERIENCE."
    },
    {
      "s": 13.58,
      "e": 14.38,
      "text": "TRUE."
    },
    {
      "s": 14.38,
      "e": 15.08,
      "text": "BUT WE DON'T GO"
    },
    {
      "s": 15.08,
      "e": 16.25,
      "text": "JUST TO GET THE EXPERIENCE."
    },
    {
      "s": 16.25,
      "e": 17.22,
      "text": "IT'S ABOUT THE TEAM"
    },
    {
      "s": 17.22,
      "e": 18.22,
      "text": "AND IT'S ABOUT THE BENEFIT"
    },
    {
      "s": 18.22,
      "e": 19.82,
      "text": "THAT IT BRINGS."
    },
    {
      "s": 19.82,
      "e": 20.92,
      "text": "MY NAME IS BUTCH WILMORE,"
    },
    {
      "s": 20.92,
      "e": 22.92,
      "text": "AND I AM THE COMMANDER FOR NASA'S"
    },
    {
      "s": 22.92,
      "e": 24.62,
      "text": "BOEING CREW FLIGHT TEST MISSION"
    },
    {
      "s": 24.62,
      "e": 26.96,
      "text": "TO THE INTERNATIONAL SPACE STATION."
    },
    {
      "s": 26.96,
      "e": 28.73,
      "text": "LIFE IN TENNESSEE, GOD'S COUNTRY."
    },
    {
      "s": 28.73,
      "e": 29.66,
      "text": "THAT'S WHERE I GREW UP."
    },
    {
      "s": 29.66,
      "e": 30.73,
      "text": "I'M VERY FORTUNATE."
    },
    {
      "s": 30.73,
      "e": 32.66,
      "text": "HAD LOVING PARENTS, TOOK US TO CHURCH."
    },
    {
      "s": 32.66,
      "e": 34.77,
      "text": "WHEN I WAS YOUNG, SEVEN YEARS OLD."
    },
    {
      "s": 34.77,
      "e": 35.27,
      "text": "I BELIEVE,"
    },
    {
      "s": 35.27,
      "e": 36.34,
      "text": "THEY BOUGHT A LITTLE LAND"
    },
    {
      "s": 36.34,
      "e": 38.37,
      "text": "OUT IN THE COUNTRY, SIX ACRES OR SO."
    },
    {
      "s": 38.37,
      "e": 39.64,
      "text": "WE HAD HORSES AND COWS,"
    },
    {
      "s": 39.64,
      "e": 42.08,
      "text": "AND I RAISED CHICKENS AND DUCKS"
    },
    {
      "s": 42.08,
      "e": 45.58,
      "text": "AND JUST ENJOYED LIFE IN THE COUNTRY."
    },
    {
      "s": 45.95,
      "e": 46.91,
      "text": "I WENT TO TENNESSEE TECH,"
    },
    {
      "s": 46.91,
      "e": 47.61,
      "text": "STARTED WORKING ON"
    },
    {
      "s": 47.61,
      "e": 48.21,
      "text": "AN ELECTRICAL ENGINEERING"
    },
    {
      "s": 48.21,
      "e": 49.48,
      "text": "DEGREE AND PLAYED FOOTBALL,"
    },
    {
      "s": 49.48,
      "e": 50.42,
      "text": "WHICH WAS A"
    },
    {
      "s": 50.42,
      "e": 52.25,
      "text": "VERY DIFFICULT COMBINATION I LEARNED,"
    },
    {
      "s": 52.25,
      "e": 54.05,
      "text": "BECAUSE THEY BOTH FULL TIME JOBS."
    },
    {
      "s": 54.05,
      "e": 55.69,
      "text": "SO IT WAS A LOT OF EFFORT"
    },
    {
      "s": 55.69,
      "e": 57.19,
      "text": "OVER THOSE YEARS, BUT IT MOLDED ME"
    },
    {
      "s": 57.19,
      "e": 57.69,
      "text": "AND IT HELPED"
    },
    {
      "s": 57.69,
      "e": 59.12,
      "text": "INSTILL THE WORK ETHIC"
    },
    {
      "s": 59.12,
      "e": 60.36,
      "text": "MY PARENTS HAD INSTILLED IN ME"
    },
    {
      "s": 60.36,
      "e": 61.46,
      "text": "WHEN I WAS YOUNGER."
    },
    {
      "s": 61.46,
      "e": 63.06,
      "text": "I ENTERED THE NAVY AND WAS FORTUNATE"
    },
    {
      "s": 63.06,
      "e": 63.23,
      "text": "TO FLY"
    },
    {
      "s": 63.23,
      "e": 64.56,
      "text": "THE A-7E, IT’S"
    },
    {
      "s": 64.56,
      "e": 66.87,
      "text": "A SINGLE SEAT ATTACK AIRCRAFT,"
    },
    {
      "s": 66.87,
      "e": 67.4,
      "text": "AND I FLEW THAT"
    },
    {
      "s": 67.4,
      "e": 68.7,
      "text": "FOR A COUPLE OF DEPLOYMENTS,"
    },
    {
      "s": 68.7,
      "e": 69.64,
      "text": "AND THEN I TRANSITIONED"
    },
    {
      "s": 69.64,
      "e": 70.74,
      "text": "TO THE F-18 HORNET."
    },
    {
      "s": 70.74,
      "e": 72.2,
      "text": "AND THROUGH THAT PROCESS,"
    },
    {
      "s": 72.2,
      "e": 74.27,
      "text": "I SELECTED IN THE TEST PILOT PROGRAM."
    },
    {
      "s": 74.27,
      "e": 75.54,
      "text": "YOU LEARN A LOT ABOUT YOURSELF"
    },
    {
      "s": 75.54,
      "e": 76.71,
      "text": "AS YOU GO THROUGH TEST PILOT SCHOOL,"
    },
    {
      "s": 76.71,
      "e": 77.71,
      "text": "WHERE YOU'RE LACKING"
    },
    {
      "s": 77.71,
      "e": 79.05,
      "text": "AND CERTAIN CAPABILITIES"
    },
    {
      "s": 79.05,
      "e": 79.85,
      "text": "THAT ARE NECESSARY"
    },
    {
      "s": 79.85,
      "e": 82.18,
      "text": "TO DO A TEST PILOT TYPE OF JOB."
    },
    {
      "s": 82.18,
      "e": 83.35,
      "text": "WHAT COMES TO FLIGHT TEST"
    },
    {
      "s": 83.35,
      "e": 84.75,
      "text": "THE MINUTE DETAILS MATTER"
    },
    {
      "s": 84.75,
      "e": 85.95,
      "text": "WHEN WE'RE DOING OUR RUNS."
    },
    {
      "s": 85.95,
      "e": 87.05,
      "text": "HEY, LET'S RUN IT THIS WAY."
    },
    {
      "s": 87.05,
      "e": 88.72,
      "text": "LET'S DO IT THAT WAY. LET'S ADD THIS."
    },
    {
      "s": 88.72,
      "e": 89.82,
      "text": "LET'S TAKE THAT OUT"
    },
    {
      "s": 89.82,
      "e": 91.96,
      "text": "AND LET'S LOOK AT IT IN THAT REGIME"
    },
    {
      "s": 91.96,
      "e": 94.26,
      "text": "SO WE CAN SEE HOW"
    },
    {
      "s": 94.26,
      "e": 96.23,
      "text": "THE SPACECRAFT RESPONDS."
    },
    {
      "s": 96.23,
      "e": 97.43,
      "text": "AND THAT'S WHAT YOU DO WITH AIRCRAFT."
    },
    {
      "s": 97.43,
      "e": 98.5,
      "text": "THAT'S WHAT YOU DO WITH SPACECRAFT."
    },
    {
      "s": 98.5,
      "e": 100.23,
      "text": "AND THAT'S WHAT THIS TEST IS ALL ABOUT."
    },
    {
      "s": 100.23,
      "e": 101.6,
      "text": "THIS CREW FLIGHT TEST"
    },
    {
      "s": 101.6,
      "e": 103.64,
      "text": "IS A SERIES OF THESE VARIOUS TESTS"
    },
    {
      "s": 103.64,
      "e": 104.97,
      "text": "TO ENSURE"
    },
    {
      "s": 104.97,
      "e": 106.67,
      "text": "THAT THE OPERATIONAL REQUIREMENTS"
    },
    {
      "s": 106.67,
      "e": 108.67,
      "text": "AND THE DESIGN MEETS THOSE REQUIREMENTS."
    },
    {
      "s": 108.67,
      "e": 109.81,
      "text": "AND I THINK EVERYBODY THAT DOES"
    },
    {
      "s": 109.81,
      "e": 111.28,
      "text": "FLIGHT TESTS WOULD AGREE"
    },
    {
      "s": 111.28,
      "e": 113.08,
      "text": "FOCUS, UNDERSTANDING,"
    },
    {
      "s": 113.08,
      "e": 114.91,
      "text": "AND ALSO THE TEAM COMING TOGETHER"
    },
    {
      "s": 114.91,
      "e": 116.58,
      "text": "TO GIVE YOU THE OVERALL"
    },
    {
      "s": 116.58,
      "e": 118.05,
      "text": "UNDERSTANDING OF THE TEST"
    },
    {
      "s": 118.05,
      "e": 119.02,
      "text": "AND THE CAPABILITIES"
    },
    {
      "s": 119.02,
      "e": 120.45,
      "text": "OF THE SPACECRAFT OR AIRCRAFT"
    },
    {
      "s": 120.45,
      "e": 122.72,
      "text": "THAT YOU'RE TESTING IS VITAL."
    },
    {
      "s": 122.72,
      "e": 123.52,
      "text": "SITTING IN THIS SEAT"
    },
    {
      "s": 123.52,
      "e": 125.39,
      "text": "OVER HERE IN THE STARLINER SIM"
    },
    {
      "s": 125.39,
      "e": 126.89,
      "text": "AND DOING THE THINGS WE'VE DONE"
    },
    {
      "s": 126.89,
      "e": 128.43,
      "text": "AND LEARNING ABOUT THE SPACECRAFT,"
    },
    {
      "s": 128.43,
      "e": 129.96,
      "text": "DEVELOPING A LOT OF THE CAPABILITIES"
    },
    {
      "s": 129.96,
      "e": 131.03,
      "text": "OF SPACECRAFT."
    },
    {
      "s": 131.03,
      "e": 132.66,
      "text": "IT'S VERY HUMBLING WHEN YOU SEE"
    },
    {
      "s": 132.66,
      "e": 133.33,
      "text": "AND YOU INTERACT"
    },
    {
      "s": 133.33,
      "e": 135.1,
      "text": "WITH SOME OF THESE PROFESSIONALS"
    },
    {
      "s": 135.1,
      "e": 136.47,
      "text": "AND OUR HUMAN SPACEFLIGHT"
    },
    {
      "s": 136.47,
      "e": 137.57,
      "text": "AND OUR NATION HAS A"
    },
    {
      "s": 137.57,
      "e": 138.54,
      "text": "DEBT OF GRATITUDE TO THEM."
    },
    {
      "s": 140.24,
      "e": 141.27,
      "text": "EVERY SINGLE TRAINING"
    },
    {
      "s": 141.27,
      "e": 143.04,
      "text": "EVOLUTION WE HAVE IS BRAND NEW."
    },
    {
      "s": 143.04,
      "e": 144.24,
      "text": "WE'RE THE FIRST TO DO IT."
    },
    {
      "s": 144.24,
      "e": 145.44,
      "text": "WHETHER IT IS"
    },
    {
      "s": 145.44,
      "e": 147.38,
      "text": "CHECKING THE SURVIVAL EQUIPMENT"
    },
    {
      "s": 147.38,
      "e": 148.58,
      "text": "IN THE POOL"
    },
    {
      "s": 148.58,
      "e": 150.82,
      "text": "WITH A MOCKUP OF THE SPACECRAFT"
    },
    {
      "s": 150.82,
      "e": 152.75,
      "text": "AND HOW YOU EGRESS"
    },
    {
      "s": 152.75,
      "e": 154.39,
      "text": "GET OUT OF THE SPACECRAFT,"
    },
    {
      "s": 154.39,
      "e": 155.25,
      "text": "WHETHER IT'S THE SIDE"
    },
    {
      "s": 155.25,
      "e": 156.49,
      "text": "HATCH OR THE UPPER HATCH."
    },
    {
      "s": 156.49,
      "e": 157.96,
      "text": "WHILE THE SEAS ARE ROUGH"
    },
    {
      "s": 157.96,
      "e": 159.12,
      "text": "AND ALL THOSE TYPE OF THINGS."
    },
    {
      "s": 159.12,
      "e": 160.06,
      "text": "THERE'S A THOUGHT OF HOW"
    },
    {
      "s": 160.06,
      "e": 160.93,
      "text": "THINGS SHOULD BE."
    },
    {
      "s": 160.93,
      "e": 162.0,
      "text": "BUT THEN THERE'S THE REALITY"
    },
    {
      "s": 162.0,
      "e": 163.53,
      "text": "OF HOW THINGS NEED TO BE."
    },
    {
      "s": 163.53,
      "e": 165.47,
      "text": "AND THAT'S WHAT THIS TEST"
    },
    {
      "s": 165.47,
      "e": 167.2,
      "text": "IS- EVERYTHING WE DO IS TEST."
    },
    {
      "s": 167.2,
      "e": 170.4,
      "text": "IT'S BEEN A PROCESS OVER YEARS"
    },
    {
      "s": 171.14,
      "e": 174.64,
      "text": "THAT IS SUCH A BENEFIT"
    },
    {
      "s": 174.64,
      "e": 175.64,
      "text": "IN ALL ASPECTS"
    },
    {
      "s": 175.64,
      "e": 178.04,
      "text": "OF THE CAPABILITIES OF THIS SPACECRAFT,"
    },
    {
      "s": 178.04,
      "e": 179.08,
      "text": "AND WE'RE EXCITED TO BE A PART OF IT."
    }
