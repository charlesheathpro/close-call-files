      "e": 17.58,
      "text": "6, 5, 4,"
    },
    {
      "s": 17.58,
      "e": 21.69,
      "text": "3, 2, 1, 0."
    },
    {
      "s": 21.69,
      "e": 23.62,
      "text": "ALL ENGINES RUNNING."
    },
    {
      "s": 23.62,
      "e": 24.82,
      "text": "WE HAVE A LIFT-OFF,"
    },
    {
      "s": 24.82,
      "e": 28.39,
      "text": "LIFT-OFF ON APOLLO 11."
    },
    {
      "s": 28.39,
      "e": 30.06,
      "text": ">> DOWN."
    },
    {
      "s": 30.06,
      "e": 30.76,
      "text": "4 FORWARD."
    },
    {
      "s": 30.76,
      "e": 32.2,
      "text": "DRIFTING TO THE RIGHT A LITTLE."
    },
    {
      "s": 32.2,
      "e": 32.93,
      "text": ">> 30 SECONDS."
    },
    {
      "s": 32.93,
      "e": 35.2,
      "text": ">> FORWARD DRIFT?"
    },
    {
      "s": 35.2,
      "e": 37.07,
      "text": ">> CONTACT LIGHT."
    },
    {
      "s": 37.07,
      "e": 39.24,
      "text": "OKAY, ENGINE STOP."
    },
    {
      "s": 39.24,
      "e": 40.77,
      "text": ">> TRANQUILITY BASE HERE."
    },
    {
      "s": 40.77,
      "e": 42.31,
      "text": "THE EAGLE HAS LANDED."
    },
    {
      "s": 42.31,
      "e": 43.31,
      "text": ">> ROGER, TRANQUILITY."
    },
    {
      "s": 43.31,
      "e": 44.71,
      "text": "WE COPY YOU ON THE GROUND."
    },
    {
      "s": 44.71,
      "e": 45.71,
      "text": "YOU GOT A BUNCH OF GUYS"
    },
    {
      "s": 45.71,
      "e": 46.98,
      "text": "ABOUT TO TURN BLUE."
    },
    {
      "s": 46.98,
      "e": 47.85,
      "text": "WE'RE BREATHIN' AGAIN."
    },
    {
      "s": 47.85,
      "e": 49.82,
      "text": "THANKS A LOT."
    },
    {
      "s": 49.82,
      "e": 51.28,
      "text": ">> ARMSTRONG IS ON THE MOON,"
    },
    {
      "s": 51.28,
      "e": 53.22,
      "text": "NEIL ARMSTRONG."
    },
    {
      "s": 53.22,
      "e": 55.12,
      "text": "A 38 YEAR-OLD AMERICAN,"
    },
    {
      "s": 55.12,
      "e": 56.32,
      "text": "STANDING ON THE SURFACE"
    },
    {
      "s": 56.32,
      "e": 59.36,
      "text": "OF THE MOON."
    },
    {
      "s": 59.36,
      "e": 62.49,
      "text": "ON THIS JULY 20, 1969."
    },
    {
      "s": 62.49,
      "e": 64.06,
      "text": ">> THAT'S ONE SMALL STEP"
    },
    {
      "s": 64.06,
      "e": 69.0,
      "text": "FOR MAN, ONE GIANT LEAP"
    },
    {
      "s": 69.0,
      "e": 71.5,
      "text": "FOR MANKIND."
    },
    {
      "s": 71.5,
      "e": 72.31,
      "text": ">> OH, THAT LOOKS BEAUTIFUL"
    },
    {
      "s": 72.31,
      "e": 73.54,
      "text": "FROM HERE, NEIL."
    },
    {
      "s": 73.54,
      "e": 74.91,
      "text": ">> IT HAS A STARK BEAUTY"
    },
    {
      "s": 74.91,
      "e": 75.84,
      "text": "ALL ITS OWN."
    },
    {
      "s": 75.84,
      "e": 77.31,
      "text": "IT'S, UH, LIKE MUCH OF"
    },
    {
      "s": 77.31,
      "e": 79.31,
      "text": "THE HIGH DESERT OF, UH,"
    },
    {
      "s": 79.31,
      "e": 80.15,
      "text": "THE UNITED STATES."
    },
    {
      "s": 80.15,
      "e": 81.55,
      "text": "IT'S, UH, DIFFERENT, BUT"
    },
    {
      "s": 81.55,
      "e": 84.98,
      "text": "IT'S VERY PRETTY OUT HERE."
    },
    {
      "s": 84.98,
      "e": 86.19,
      "text": ">> BEAUTIFUL VIEW."
    },
    {
      "s": 86.19,
      "e": 88.29,
      "text": ">> ISN'T THAT SOMETHIN'?"
    },
    {
      "s": 88.29,
      "e": 90.56,
      "text": "MAGNIFICENT SIGHT OUT HERE."
    },
    {
      "s": 90.56,
      "e": 92.83,
      "text": ">> MAGNIFICENT DESOLATION."
    },
    {
      "s": 92.83,
      "e": 94.69,
      "text": ">> TRANQUILITY BASE, HOUSTON."
    },
    {
      "s": 94.69,
      "e": 96.46,
      "text": "GUIDANCE RECOMMENDATION, UH,"
    },
    {
      "s": 96.46,
      "e": 98.26,
      "text": "IS PGNS, AND YOU'RE CLEARED"
    },
    {
      "s": 98.26,
      "e": 100.33,
      "text": "FOR TAKEOFF."
    },
    {
      "s": 100.33,
      "e": 101.33,
      "text": ">> ROGER, UNDERSTAND."
    },
    {
      "s": 101.33,
      "e": 103.17,
      "text": "WE'RE NUMBER 1 ON THE RUNWAY."
    },
    {
      "s": 103.17,
      "e": 105.57,
      "text": ">> 7, 6, 5..."
    },
    {
      "s": 105.57,
      "e": 107.57,
      "text": "ENGINE ARM ASCENT."
    },
    {
      "s": 112.11,
      "e": 113.31,
      "text": ">> OH, BEAUTIFUL."
    },
    {
      "s": 113.31,
      "e": 114.85,
      "text": ">> VERY SMOOTH."
    },
    {
      "s": 114.85,
      "e": 116.45,
      "text": ">> VERY QUIET RIDE."
    },
    {
      "s": 122.69,
      "e": 123.92,
      "text": ">> APOLLO 11, APOLLO 11."
    },
    {
      "s": 123.92,
      "e": 124.96,
      "text": "THIS IS HORNET-- HORNET."
    },
    {
      "s": 124.96,
      "e": 125.83,
      "text": "OVER."
    },
    {
      "s": 125.83,
      "e": 126.66,
      "text": ">> HELLO, HORNET."
    },
    {
      "s": 126.66,
      "e": 127.83,
      "text": "THIS IS APOLLO 11 READING YOU"
    },
    {
      "s": 127.83,
      "e": 129.23,
      "text": "LOUD AND CLEAR."
    },
    {
      "s": 129.23,
      "e": 131.63,
