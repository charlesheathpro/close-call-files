    {
      "s": 1377.04,
      "e": 1380.96,
      "text": "AND THERE WAS A \"LIFE\" MAGAZINE,"
    },
    {
      "s": 1380.96,
      "e": 1383.96,
      "text": "THAT WAS FROM JULY 1969, HAH HAD"
    },
    {
      "s": 1383.96,
      "e": 1387.22,
      "text": "BEEN HANGING IN MY HOUSE"
    },
    {
      "s": 1387.22,
      "e": 1388.18,
      "text": "FOR -- FOR SOMETIME AS"
